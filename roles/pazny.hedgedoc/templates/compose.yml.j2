# =============================================================================
# pazny.hedgedoc — compose override fragment
# Merged do `docker compose up` v tasks/stacks/stack-up.yml pres
# ansible.builtin.find nad {{ stacks_dir }}/b2b/overrides/*.yml.
# =============================================================================

services:
  hedgedoc:
    image: quay.io/hedgedoc/hedgedoc:{{ hedgedoc_version }}
    restart: unless-stopped
    ports:
{% if services_lan_access | default(false) %}
      - "{{ hedgedoc_port | default(3012) }}:3000"
{% else %}
      - "127.0.0.1:{{ hedgedoc_port | default(3012) }}:3000"
{% endif %}
    volumes:
      - {{ hedgedoc_data_dir | default(ansible_facts['env']['HOME'] + '/hedgedoc/uploads') }}:/hedgedoc/public/uploads
{% if postgresql_ssl_enabled | default(false) %}
      # Database TLS lives HERE, not in the URL. Read templates/config.json.j2
      # before changing either — the reason is upstream's, and it is measured.
      - {{ hedgedoc_config_dir }}/config.json:/hedgedoc/config.json:ro
{% endif %}
    environment:
      # ── Database (PostgreSQL z infra stacku) ──────────────────────────────
      # NO sslmode ON THIS URL, DELIBERATELY, and this is the third correction
      # to one line — each one confident, each one from a different level of
      # the stack:
      #
      #   2026-06-14  `sslmode=require`   never rendered (role-default scope)
      #   2026-08-23  `sslmode=no-verify` rendered, and was DISCARDED
      #
      # The second was right about node-postgres and still wrong, because
      # nothing between the URL and pg ever reads `sslmode`: Sequelize copies
      # dialectOptions through an allow-list holding `ssl` and not `sslmode`.
      # Measured, in the running image, at
      # sequelize/lib/dialects/postgres/connection-manager.js:96 — and by
      # tools/tls-uptake.py, which called this the one plaintext backend of 40
      # while this line claimed encryption.
      #
      # An inert pin that reads as a control is worse than no pin
      # (docs/hidden_fees/23). The control is config.json; that file carries
      # the whole derivation. Doctrine: docs/doctrine/foreign-properties.md §5.2
      # — an ORM in between that discards what it does not know.
      CMD_DB_URL: "postgres://{{ hedgedoc_db_user | default('hedgedoc') }}:{{ (hedgedoc_db_password | default(nos_derived_secrets.hedgedoc)) | urlencode }}@postgresql:5432/{{ hedgedoc_db_name | default('hedgedoc') }}"
      # ── Public URL / protocol ──────────────────────────────────────────────
      CMD_DOMAIN: "{{ hedgedoc_domain | default('hedgedoc' ~ (_host_alias_seg | default('')) ~ '.' ~ (tenant_domain | default('dev.local'))) }}"
      CMD_URL_ADDPORT: "false"
      CMD_PROTOCOL_USESSL: "true"
      CMD_HOST: "0.0.0.0"
      CMD_PORT: "3000"
      # ── Session ─────────────────────────────────────────────────────────────
      CMD_SESSION_SECRET: "{{ hedgedoc_session_secret }}"
      # ── Auth policy (OIDC only — no anonymous / email register) ───────────
      CMD_ALLOW_ANONYMOUS: "false"
      CMD_ALLOW_EMAIL_REGISTER: "false"
      # ── CDN / uploads ──────────────────────────────────────────────────────
      CMD_USECDN: "false"
      CMD_UPLOADS_PATH: "/hedgedoc/public/uploads"
{% if install_mailpit | default(false) %}
      # ── SMTP relay → Mailpit (dev mail capture) ────────────────────────────
      # Mailpit lives on iiab_net only; reach it via host-gateway.
      CMD_EMAIL: "true"
      CMD_SMTP_HOST: "host.docker.internal"
      CMD_SMTP_PORT: "1025"
      CMD_SMTP_SECURE: "false"
      CMD_SMTP_FROM: "hedgedoc@{{ tenant_domain | default('dev.local') }}"
{% endif %}
{% if install_mailpit | default(false) %}
    extra_hosts:
      - "host.docker.internal:host-gateway"
{% endif %}
    healthcheck:
      # DB-AWARE, via node (docs/hidden_fees/02, closed for hedgedoc 2026-08-18).
      #
      # The old probe was `:>/dev/tcp/127.0.0.1/3000` — pure TCP liveness, which
      # certifies a container whose every real request is failing. That is the
      # exact shape miniflux proved in July: healthy for 19 hours while `/`
      # returned 500 to every caller, and the STRICT bring-up gate passed it.
      #
      # The old comment's premise was right and its conclusion was not. MEASURED
      # in the running image: curl, wget, nc and psql are all MISSING — so TCP
      # looked like the only option — but `node` is present, because HedgeDoc IS
      # node. That is enough to speak HTTP.
      #
      # `/status` is the endpoint that cannot lie: it returns `notesCount` and
      # `registeredUsers`, which are SELECT counts. Postgres down → no reply.
      # (`/_health` returns a static `{"ready":true}` and would have been the
      # tempting choice; it is the same trap one layer up.)
      test: ["CMD", "node", "-e", "require('http').get({host:'127.0.0.1',port:3000,path:'/status'},r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s
    networks:
      - b2b_net
      - {{ stacks_shared_network }}
    logging:
      driver: "json-file"
      options:
        max-size: "20m"
        max-file: "5"
    mem_limit: {{ hedgedoc_mem_limit | default(docker_mem_limit_standard) }}
    cpus: {{ hedgedoc_cpus | default(docker_cpus_standard | default('1.0')) }}
