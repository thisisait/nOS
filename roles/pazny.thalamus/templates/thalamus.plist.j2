<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>{{ thalamus_launchd_label }}</string>
    <key>ProgramArguments</key>
    <array>
        <string>{{ thalamus_serve_bin }}</string>
        <string>serve</string>
        <string>--data-dir</string>
        <string>{{ thalamus_data_dir }}</string>
    </array>
    <key>WorkingDirectory</key>
    <string>{{ thalamus_home }}</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>{{ ansible_facts['env']['HOME'] }}</string>
        <!-- python3 for the control readers (tools/*-status.py): the tools venv holds PyYAML. -->
        <key>PATH</key>
        <string>{{ nos_tools_venv }}/bin:{{ homebrew_prefix | default('/opt/homebrew') }}/bin:/usr/local/bin:/usr/bin:/bin</string>
        <!-- iris's agent.yml, the backend register and the control readers come from here. The binary
             is built from the converging tree: a worktree converge runs worktree code on main-checkout data
             (the receptor does the same; preflight-checkout-current.yml warns). -->
        <key>NOS_REPO_ROOT</key>
        <string>{{ nos_main_checkout }}</string>
        <key>KEAP_URL</key>
        <string>http://127.0.0.1:{{ keap_port | default(8091) }}</string>
        <!-- Read once at start, then removed from the process env (src/main.rs). -->
        <key>KEAP_PROXY_SHARED_SECRET</key>
        <string>{{ keap_proxy_shared_secret }}</string>
{% if install_face | default(false) | bool and thalamus_relay_secret | default('') %}
        <!-- The face's door (src/relay.rs, 127.0.0.1 only); the secret is read once, then removed. -->
        <key>THALAMUS_RELAY_SECRET</key>
        <string>{{ thalamus_relay_secret }}</string>
        <key>THALAMUS_RELAY_PORT</key>
        <string>{{ thalamus_relay_port }}</string>
{% endif %}
{% for var in thalamus_model_secrets | default([]) %}
        <!-- The key of an armed row iris may bind; read once, then removed; sent only as the model's bearer. -->
        <key>NOS_SECRET_{{ var | upper }}</key>
        <string>{{ thalamus_model_tokens[var] }}</string>
{% endfor %}
{% if ((medulla_routes | default([])) + (medulla_read_routes | default([]))) | length and not (nos_system_user | default('') | length) %}
        <!-- A Wing route moved to the medulla (medulla_routes, medulla_read_routes): its loopback door reads wing.db mode=ro. -->
        <key>NOS_WING_DB</key>
        <string>{{ wing_data_dir }}/wing.db</string>
        <key>MEDULLA_HTTP_PORT</key>
        <string>{{ medulla_http_port }}</string>
{% endif %}
        <!-- The table serve answers for the model's "roadmap" (src/serve.rs table_id). -->
        <key>NOS_ROADMAP_TABLE_ID</key>
        <string>{{ thalamus_roadmap_table_id }}</string>
        <!-- Who sees the approvals and red-status controls: authentik_rbac_tiers tier 1. -->
        <key>NOS_TIER1_GROUPS</key>
        <string>{{ (authentik_rbac_tiers | selectattr('tier', 'equalto', 1) | first).groups | join(',') }}</string>
        <!-- Who may ask for an app (propose_app, app_slots, scaffold_app): authentik_rbac_tiers tier 2. -->
        <key>NOS_TIER2_GROUPS</key>
        <string>{{ (authentik_rbac_tiers | selectattr('tier', 'equalto', 2) | first).groups | join(',') }}</string>
{% if thalamus_decider_exes | default([]) | length %}
        <!-- Only these executables decide (defaults thalamus_decider_exes; src/serve.rs decider_refusal). -->
        <key>NOS_DECIDER_EXES</key>
        <string>{{ thalamus_decider_exes | join(':') }}</string>
{% endif %}
        <!-- iris_plan: cortex plans a turn as one cortex-lang pipeline the organ validates (src/cortex_plan.rs);
             hybrid plans only a turn whose intent is in NOS_IRIS_INTENTS. -->
        <key>NOS_IRIS_PLAN</key>
        <string>{{ iris_plan | default('tools') }}</string>
        <!-- iris_knowledge_tree_max: the most nodes read_node's knowledge tree draws (src/serve.rs knowledge_tree). -->
        <key>NOS_IRIS_KNOWLEDGE_TREE_MAX</key>
        <string>{{ iris_knowledge_tree_max | default(50) }}</string>
{% if iris_plan | default('tools') in ['cortex', 'hybrid'] and install_cortex | default(false) | bool %}
{% if iris_plan == 'hybrid' %}
        <key>NOS_IRIS_INTENTS</key>
        <string>{{ iris_cortex_intents | join(',') }}</string>
{% endif %}
        <key>NOS_CORTEX_CATALOGUE</key>
        <string>{{ thalamus_cortex_catalogue | default('lean') }}</string>
        <key>NOS_CORTEX_URL</key>
        <string>http://127.0.0.1:{{ cortex_port | default(8098) }}</string>
        <!-- The organ's RO token (validate only); read once as nos:cortex_ro_token, then removed. -->
        <key>NOS_SECRET_CORTEX_RO_TOKEN</key>
        <string>{{ cortex_ro_token }}</string>
{% endif %}
{% if thalamus_wing_api_token | default('') %}
        <!-- start_agent's door (src/serve.rs WingDoor): the `thalamus` bearer, read once as nos:wing_token,
             then removed; Wing believes a person on it for the spawn alone. iris_startable_agents is the list. -->
        <key>NOS_WING_URL</key>
        <string>http://127.0.0.1:{{ wing_port | default(9000) }}</string>
        <key>NOS_SECRET_WING_TOKEN</key>
        <string>{{ thalamus_wing_api_token }}</string>
        <key>NOS_IRIS_STARTABLE_AGENTS</key>
        <string>{{ iris_startable_agents | default([]) | join(',') }}</string>
{% endif %}
        <!-- The binding env (defaults thalamus_binding_env, also the preflight's); iris binds one of its allowed rows. -->
{% for name, value in thalamus_binding_env.items() %}
        <key>{{ name }}</key>
        <string>{{ value }}</string>
{% endfor %}
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>StandardOutPath</key>
    <string>{{ thalamus_log_dir }}/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>{{ thalamus_log_dir }}/launchd.err.log</string>
</dict>
</plist>
