# {{ ansible_managed }} — roles/pazny.thalamus (Linux EnvironmentFile, 0600). Same env as thalamus.plist.j2.
HOME={{ ansible_facts['env']['HOME'] }}
PATH={{ nos_tools_venv }}/bin:/usr/local/bin:/usr/bin:/bin
NOS_REPO_ROOT={{ nos_main_checkout }}
KEAP_URL=http://127.0.0.1:{{ keap_port | default(8091) }}
KEAP_PROXY_SHARED_SECRET={{ keap_proxy_shared_secret }}
THALAMUS_SOCKET={{ thalamus_shared_socket }}
THALAMUS_SOCKET_SHARED=1
{% if install_face | default(false) | bool and thalamus_relay_secret | default('') %}
THALAMUS_RELAY_SECRET={{ thalamus_relay_secret }}
THALAMUS_RELAY_PORT={{ thalamus_relay_port }}
THALAMUS_RELAY_HOST={{ nos_docker_host_ip | default('127.0.0.1') }}
{% endif %}
{% for var in thalamus_model_secrets | default([]) %}
NOS_SECRET_{{ var | upper }}={{ thalamus_model_tokens[var] }}
{% endfor %}
NOS_ROADMAP_TABLE_ID={{ thalamus_roadmap_table_id }}
NOS_TIER1_GROUPS={{ (authentik_rbac_tiers | selectattr('tier', 'equalto', 1) | first).groups | join(',') }}
NOS_IRIS_PLAN={{ iris_plan | default('tools') }}
{% if iris_plan | default('tools') == 'cortex' and install_cortex | default(false) | bool %}
NOS_CORTEX_URL=http://127.0.0.1:{{ cortex_port | default(8098) }}
NOS_SECRET_CORTEX_RO_TOKEN={{ cortex_ro_token }}
{% endif %}
{% for name, value in thalamus_binding_env.items() %}
{{ name }}={{ value | trim }}
{% endfor %}
