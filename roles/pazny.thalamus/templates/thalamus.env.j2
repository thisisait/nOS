# {{ ansible_managed }} — roles/pazny.thalamus (Linux EnvironmentFile, 0600). Same env as thalamus.plist.j2.
HOME={{ thalamus_env_home | default(ansible_facts['env']['HOME']) }}
PATH={{ thalamus_env_path | default(nos_tools_venv ~ '/bin:/usr/local/bin:/usr/bin:/bin') }}
NOS_REPO_ROOT={{ thalamus_repo_root | default(nos_main_checkout) }}
KEAP_URL=http://127.0.0.1:{{ keap_port | default(8091) }}
KEAP_PROXY_SHARED_SECRET={{ keap_proxy_shared_secret }}
THALAMUS_SOCKET={{ thalamus_shared_socket }}
THALAMUS_SOCKET_SHARED=1
{% if install_face | default(false) | bool and thalamus_relay_secret | default('') %}
THALAMUS_RELAY_SECRET={{ thalamus_relay_secret }}
THALAMUS_RELAY_PORT={{ thalamus_relay_port }}
THALAMUS_RELAY_HOST={{ nos_docker_host_ip | default('127.0.0.1') }}
{% endif %}
{% for var in thalamus_model_secrets | default([]) %}
NOS_SECRET_{{ var | upper }}={{ thalamus_model_tokens[var] }}
{% endfor %}
{% if ((medulla_routes | default([])) + (medulla_read_routes | default([]))) | length and not (nos_system_user | default('') | length) %}
NOS_WING_DB={{ wing_data_dir }}/wing.db
MEDULLA_HTTP_PORT={{ medulla_http_port }}
{% endif %}
NOS_ROADMAP_TABLE_ID={{ thalamus_roadmap_table_id }}
NOS_TIER1_GROUPS={{ (authentik_rbac_tiers | selectattr('tier', 'equalto', 1) | first).groups | join(',') }}
NOS_TIER2_GROUPS={{ (authentik_rbac_tiers | selectattr('tier', 'equalto', 2) | first).groups | join(',') }}
{% if thalamus_decider_exes | default([]) | length %}
NOS_DECIDER_EXES={{ thalamus_decider_exes | join(':') }}
{% endif %}
NOS_IRIS_PLAN={{ iris_plan | default('tools') }}
NOS_IRIS_KNOWLEDGE_TREE_MAX={{ iris_knowledge_tree_max | default(50) }}
{% if iris_plan | default('tools') in ['cortex', 'hybrid'] and install_cortex | default(false) | bool %}
{% if iris_plan == 'hybrid' %}
NOS_IRIS_INTENTS={{ iris_cortex_intents | join(',') }}
{% endif %}
NOS_CORTEX_CATALOGUE={{ thalamus_cortex_catalogue | default('lean') }}
NOS_CORTEX_URL=http://127.0.0.1:{{ cortex_port | default(8098) }}
NOS_SECRET_CORTEX_RO_TOKEN={{ cortex_ro_token }}
{% endif %}
{% if thalamus_wing_api_token | default('') %}
NOS_WING_URL=http://127.0.0.1:{{ wing_port | default(9000) }}
NOS_SECRET_WING_TOKEN={{ thalamus_wing_api_token }}
NOS_IRIS_STARTABLE_AGENTS={{ iris_startable_agents | default([]) | join(',') }}
{% endif %}
{% for name, value in thalamus_binding_env.items() %}
{{ name }}={{ value | trim }}
{% endfor %}
