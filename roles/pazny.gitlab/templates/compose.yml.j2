# =============================================================================
# pazny.gitlab — compose override fragment
# Merged into `docker compose -p devops up` by tasks/stacks/stack-up.yml via
# ansible.builtin.find across {{ stacks_dir }}/devops/overrides/*.yml.
# =============================================================================

services:
  gitlab:
    image: gitlab/gitlab-ce:{{ gitlab_version }}
    restart: unless-stopped
    hostname: "{{ gitlab_domain | default('gitlab' ~ (_host_alias_seg | default('')) ~ '.' ~ (tenant_domain | default('dev.local'))) }}"
    shm_size: 256m
    ports:
      - "127.0.0.1:{{ gitlab_http_port | default(8929) }}:80"
      - "127.0.0.1:{{ gitlab_ssh_port | default(2224) }}:22"
    volumes:
      - {{ gitlab_config_dir }}:/etc/gitlab
      - {{ ansible_facts['env']['HOME'] }}/gitlab-logs:/var/log/gitlab
      - {{ gitlab_data_dir }}:/var/opt/gitlab
    # VirtioFS fix (REM/roadmap): the gitlab data volume is a macOS bind mount
    # (VirtioFS), on which puma 7.x's File.realdirpath() of its unix socket returns
    # Errno::ENOTSUP → puma crash-loops → 502 (recurs on every macOS update). Put
    # the rails sockets dir on a tmpfs (off VirtioFS) so realpath works; sockets are
    # ephemeral, so tmpfs is the correct home anyway (also clears stale sockets).
    # VFS-DOCTRINE: unix sockets off the VirtioFS bind — puma realdirpath ENOTSUP.
    tmpfs:
      - /var/opt/gitlab/gitlab-rails/sockets:mode=0755
    environment:
      GITLAB_OMNIBUS_CONFIG: |
        external_url 'https://{{ gitlab_domain | default('gitlab' ~ (_host_alias_seg | default('')) ~ '.' ~ (tenant_domain | default('dev.local'))) }}'
        gitlab_rails['gitlab_shell_ssh_port'] = {{ gitlab_ssh_port | default(2224) }}
        nginx['listen_port'] = 80
        nginx['listen_https'] = false
        puma['worker_processes'] = 2
        sidekiq['concurrency'] = 10
        postgresql['shared_buffers'] = '256MB'
        prometheus['enable'] = false
        alertmanager['enable'] = false
        node_exporter['enable'] = false
        redis_exporter['enable'] = false
        postgres_exporter['enable'] = false
        gitlab_exporter['enable'] = false
        gitlab_rails['gitlab_signup_enabled'] = false
        gitlab_rails['time_zone'] = 'Europe/Prague'
        # Whitelist the Docker bridge so the host-side readiness probe (NAT'd
        # to the bridge gateway, e.g. 172.21.0.1) reaches /-/readiness instead
        # of GitLab 404'ing it. Without this the pazny.gitlab post-check 404s
        # for the full 60x10s retry budget (~10 min stall) before its
        # failed_when:false lets the play continue. Localhost stays for the
        # in-container healthcheck.
        gitlab_rails['monitoring_whitelist'] = ['127.0.0.0/8', '::1/128', '172.16.0.0/12']
{% if install_authentik | default(false) %}
        gitlab_rails['omniauth_enabled'] = true
        gitlab_rails['omniauth_allow_single_sign_on'] = ['openid_connect']
        gitlab_rails['omniauth_block_auto_created_users'] = false
        gitlab_rails['omniauth_providers'] = [{ name: 'openid_connect', label: 'Authentik', args: { name: 'openid_connect', scope: ['openid', 'profile', 'email'], response_type: 'code', issuer: 'https://{{ authentik_domain | default('auth' ~ (_host_alias_seg | default('')) ~ '.' ~ (tenant_domain | default('dev.local'))) }}/application/o/gitlab/', client_auth_method: 'query', discovery: true, uid_field: 'preferred_username', gitlab: { groups_attribute: 'groups', admin_groups: ['{{ (authentik_rbac_tiers | selectattr('tier', 'equalto', 1) | map(attribute='groups') | first | default(['nos-admins'])) | last }}'] }, client_options: { identifier: 'nos-gitlab', secret: '{{ nos_derived_secrets.oidc_gitlab }}', redirect_uri: 'https://{{ gitlab_domain | default('gitlab' ~ (_host_alias_seg | default('')) ~ '.' ~ (tenant_domain | default('dev.local'))) }}/users/auth/openid_connect/callback' } } }]
{% if (sso_autologin_gitlab | default(sso_autologin_min_tier_2 | default(sso_autologin | default(false)))) | bool %}
        # ── SSO autologin (force-OIDC) — sso-autologin-plan.md Batch 3 ──────
        # supports: partial. disable_password_authentication_for_web RELIABLY
        # hides the username/password form (OIDC button only). The auto-sign-in
        # key is best-effort: NOT unambiguously confirmed in official GitLab
        # OIDC Omnibus docs — it may or may not auto-redirect depending on
        # version, hence PARTIAL. Both gate on the autologin enable expression
        # (mirrors plugin.yml authentik.autologin.enabled). Dormant behind
        # sso_autologin=false (default). Break-glass: ?auto_sign_in=false
        # reaches /users/sign_in ONLY while disable_pw below is not in effect.
        gitlab_rails['omniauth_auto_sign_in_with_provider'] = 'openid_connect'
        gitlab_rails['disable_password_authentication_for_web'] = true
{% endif %}
{% endif %}
    healthcheck:
      test: ["CMD-SHELL", "curl -sf http://localhost:80/-/readiness || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 15
      start_period: 300s
    networks:
      - devops_net
      - {{ stacks_shared_network }}
    logging:
      driver: "json-file"
      options:
        max-size: "50m"
        max-file: "5"
    mem_limit: {{ gitlab_mem_limit | default(docker_mem_limit_heavy) }}
    cpus: {{ docker_cpus_heavy | default('2.0') }}
