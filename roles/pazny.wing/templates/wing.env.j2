# pazny.wing — systemd --user EnvironmentFile (Linux).
# Mirrors wing.plist.j2's EnvironmentVariables block. Rendered 0600 (embeds
# admin-level tokens). systemd reads KEY=value lines literally (no shell). Keep
# in sync with wing.plist.j2 until both share one source.
HOME={{ ansible_facts['env']['HOME'] }}
PATH={{ ansible_facts['env']['HOME'] }}/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
XDG_DATA_HOME={{ wing_runtime_dir }}/caddy-data
XDG_CONFIG_HOME={{ wing_runtime_dir }}/caddy-config
WING_DATA_DIR={{ wing_data_dir }}
WING_API_TOKEN={{ wing_api_token | default('') }}
WING_EDGE_TOKEN={{ wing_edge_token | default('') }}
BONE_URL={{ bone_url | default('http://127.0.0.1:' + (bone_port | default(8099) | string)) }}
BONE_SECRET={{ bone_secret | default('') }}
WING_EVENTS_HMAC_SECRET={{ wing_events_hmac_secret | default(bone_secret) | default('') }}
WING_AUDIT_CHAIN_ENABLED={{ '1' if (wing_audit_chain_enabled | default(false) | bool) else '' }}
NOS_DEPLOY_HMAC_SECRET={{ nos_deploy_hmac_secret | default('') }}
NOS_DEPLOY_LOG_DIR={{ ansible_facts['env']['HOME'] }}/.nos/deploys
QDRANT_URL={{ ('http://127.0.0.1:' + (qdrant_port | default(6333) | string)) if (install_qdrant | default(false)) else '' }}
QDRANT_API_KEY_RO={{ qdrant_api_key_ro | default('') }}
TENANT_DOMAIN={{ tenant_domain | default('dev.local') }}
# agents-inbox (2026-08-08): base URL for notification Click targets
# (<WING_PUBLIC_URL>/inbox). A link, never a credential; empty = no Click.
WING_PUBLIC_URL=https://{{ wing_domain }}
HOST_ALIAS={{ host_alias | default('') }}
INSTANCE_NAME={{ instance_name | default('nos') }}
NOS_INVITE_PROVISIONING_ENABLED={{ '1' if (nos_invite_provisioning_enabled | default(false) | bool) else '' }}
{% if install_authentik | default(false) %}
AUTHENTIK_OIDC_ISSUER=https://{{ authentik_domain }}/
AUTHENTIK_DOMAIN={{ authentik_domain }}
AUTHENTIK_BOOTSTRAP_TOKEN={{ authentik_bootstrap_token | default('') }}
TENANT_SLUGS={{ (tenants_extra | default([])) | join(',') }}
{% endif %}
{% if install_keap | default(false) %}
KEAP_API_URL=http://127.0.0.1:{{ keap_port | default(8091) }}
KEAP_AGENT_TOKEN_RO={{ keap_agent_token_ro | default('') }}
KEAP_AGENT_TOKEN_RW={{ keap_agent_token_rw | default('') }}
{% endif %}
{% if install_infisical | default(false) %}
INFISICAL_API_URL={{ infisical_api_url | default('http://127.0.0.1:' + (infisical_port | default(8075) | string)) }}
INFISICAL_API_TOKEN={{ infisical_admin_token | default('') }}
INFISICAL_USERS_PROJECT_ID={{ infisical_users_project_id | default('') }}
INFISICAL_USERS_ENVIRONMENT={{ infisical_users_environment | default('prod') }}
{% endif %}
{% if install_smtp_stalwart | default(false) %}
STALWART_API_URL={{ stalwart_api_url | default('http://127.0.0.1:' + (stalwart_port_admin | default(8088) | string)) }}
STALWART_ADMIN_USER={{ stalwart_admin_username | default('admin') }}
STALWART_ADMIN_PASSWORD={{ stalwart_admin_password | default('') }}
{% endif %}
