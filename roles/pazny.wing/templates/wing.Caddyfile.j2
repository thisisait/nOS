# =============================================================================
# wing.Caddyfile — FrankenPHP host runtime (anatomy A3.5, 2026-05-04)
#
# Replaces the wing-fpm container + wing-nginx sidecar pair. Runs as a launchd
# daemon (`eu.thisisait.nos.wing`) listening on 127.0.0.1:9000. Traefik file
# provider routes wing.<tld> → host.docker.internal:9000.
#
# Ansible-rendered. DO NOT edit ~/wing/Caddyfile manually — re-render via
# `ansible-playbook main.yml -K --tags wing`.
# =============================================================================

{
    # Caddy global options
    auto_https off                         # TLS terminates at Traefik
    admin off                              # no Caddy admin API
    log {
        output file {{ wing_log_dir }}/access.log
        format json
    }
    # FrankenPHP block
    frankenphp {
        # num_threads default = 2× CPU cores; explicit cap keeps the Wing
        # process from eating the M-series macbook on cold compose runs.
        num_threads 4
        # Wing never reports upload progress; the stock On keeps the session
        # upload-progress handler (2026 heap UAF reports) reachable from every
        # local user and container that can reach :9000.
        php_ini session.upload_progress.enabled 0
    }
}

# Loopback bind — Traefik reaches this via host.docker.internal:9000.
#
# SEC-6 (2026-05-23): explicit `bind 127.0.0.1` keeps the listener
# OFF every non-loopback interface. Pre-SEC-6, `:9000` alone made
# FrankenPHP bind `*:9000` (IPv6 wildcard) which exposed Wing's full
# admin API to any LAN-reachable host once `services_lan_access` was
# on for any other service, AND to any docker container reaching
# `host.docker.internal:9000`. Combined with the forward-auth header
# trust model (BasePresenter reads X-Authentik-Username unconditionally),
# the wildcard bind meant any LAN-side client could `curl -H
# 'X-Authentik-Groups: nos-providers' http://<host-ip>:9000/admin/halt`
# and bypass RBAC entirely. host.docker.internal still resolves to the
# loopback inside Docker Desktop on macOS, so Traefik continues to reach
# the listener.
# Linux: host.docker.internal is docker0's address, NOT the loopback, so
# Traefik reaches Wing only if it also listens there. Only with an edge token:
# without one BasePresenter skips the check and any container on docker0 could
# assert X-Authentik-* identity headers.
:9000 {
    bind 127.0.0.1{% if (nos_docker_host_ip | default('127.0.0.1')) != '127.0.0.1' and (wing_edge_token | default('') | length) > 0 %} {{ nos_docker_host_ip }}{% endif %}

    # Wing reads no uploads, and its auth is PHP code: a multipart body would
    # reach PHP's rfc1867 parser pre-auth from any local user or container
    # (2026 UAF reports). Refused here, before PHP. Gate: test_wing_refuses_multipart.py
    @multipart header_regexp Content-Type (?i)multipart
    respond @multipart "Wing accepts no multipart bodies" 415 {
        close
    }

    # Who calls /api/v1, measured for ONE release (row wing-to-medulla-waves, wave 0): method,
    # path, status, duration. Headers and the query string never reach the file — they carry
    # the bearer, cookies and ?token=. Remove once the wave-1 move list is drawn from it.
    # Gate: test_the_wing_api_log_holds_no_secret.py
    @not_api not path /api/v1/*
    log_skip @not_api
    log wing_api {
        output file {{ wing_log_dir }}/api-access.log {
            roll_size 10MiB
            roll_keep 5
        }
        format filter {
            wrap json
            fields {
                request>headers delete
                resp_headers delete
                request>uri regexp \?.*$ ""
            }
        }
    }

    root * {{ wing_app_dir }}/www
    encode zstd gzip

    # The strangler seam (ssot/doctrine/medulla.md §5): a whole moved prefix goes to the
    # medulla's loopback door; everything else falls through to PHP below. Caddy runs
    # `handle` before the site's `respond`, so each handle repeats the multipart 415.
    # Gate: test_medulla_serves_metrics.py
{% for prefix in medulla_routes %}
    handle /api/v1/{{ prefix }}* {
        respond @multipart "Wing accepts no multipart bodies" 415 {
            close
        }
        reverse_proxy 127.0.0.1:{{ medulla_http_port }}
    }
{% endfor %}
    # A read set (medulla_read_routes, ruling 2026-10-25): only a GET its matcher names goes to the
    # medulla; every write and every other method on the same prefix still reaches PHP below.
    # A windowed run list (?since/?until) stays PHP's: strtotime()'s grammar is PHP's own.
    # admin: GET /api/v1/admin/state only (row medulla-settings); halt and resume are writes, PHP's.
{% set _medulla_reads = {'pulse': ['path_regexp ^/api/v1/(pulse_jobs|pulse_runs|pulse_runs/summary|pulse_runs/[^/]+)$', 'not query since=*', 'not query until=*'],
                         'admin': ['path /api/v1/admin/state']} %}
{% for name in medulla_read_routes | default([]) %}
    @medulla_read_{{ name }} {
        method GET
{% for line in _medulla_reads[name] %}
        {{ line }}
{% endfor %}
    }
    handle @medulla_read_{{ name }} {
        respond @multipart "Wing accepts no multipart bodies" 415 {
            close
        }
        reverse_proxy 127.0.0.1:{{ medulla_http_port }}
    }
{% endfor %}

    # PHP routing — front-controller pattern (Wing is a Nette app).
    # `php_server` is FrankenPHP's high-level shortcut: it wires up
    # try_files for the URI, sets SCRIPT_FILENAME, and routes to the
    # PHP module. Equivalent to the old nginx
    # `try_files $uri $uri/ /index.php?$query_string;` + `fastcgi_pass`
    # in one directive.
    php_server {
        # Pass Authentik's forward-auth headers (set by the Authentik
        # outpost middleware in Traefik) through to PHP $_SERVER.
        # Caddy doesn't have nginx's HTTP_X_AUTHENTIK_* mapping; in
        # FrankenPHP, all incoming HTTP headers are exposed as
        # HTTP_<NAME> on $_SERVER automatically (so X-Authentik-Username
        # becomes HTTP_X_AUTHENTIK_USERNAME). No explicit fastcgi_param
        # block needed.
        index index.php
    }

    # Static asset cache headers — match the previous nginx behaviour.
    @static {
        path *.css *.js *.svg *.png *.jpg *.jpeg *.gif *.ico *.woff *.woff2
    }
    header @static Cache-Control "public, immutable, max-age=31536000"

    # Security headers parity with the wing-nginx sidecar. Traefik's
    # security-headers@file middleware also injects these one layer up,
    # but redundant headers are harmless and protect against direct
    # 127.0.0.1:9000 hits.
    header {
        X-Frame-Options DENY
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        # Don't leak Caddy/FrankenPHP version
        -Server
    }

    # Hide Wing's framework directories from web. Defense in depth — the
    # `root * www` already restricts to the public dir, but nginx had this
    # explicit block and we keep parity.
    @hidden path /vendor/* /app/* /bin/* /config/* /data/* /log/* /temp/*
    respond @hidden 404
}
