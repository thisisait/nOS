<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>{{ wing_launchd_label | default('eu.thisisait.nos.wing') }}</string>

    <!--
        FrankenPHP single-binary serving Wing. Replaces the Track-A
        wing FPM container + wing-nginx sidecar pair. Anatomy A3.5
        (2026-05-04). Listens on 127.0.0.1:{{ wing_port | default(9000) }};
        Traefik routes wing.<tld> → host.docker.internal:9000.
    -->
    <key>ProgramArguments</key>
    <array>
        <string>{{ frankenphp_bin | default('/opt/homebrew/bin/frankenphp') }}</string>
        <string>run</string>
        <string>--config</string>
        <string>{{ wing_caddyfile_path }}</string>
    </array>

    <key>WorkingDirectory</key>
    <string>{{ wing_app_dir }}</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>{{ ansible_facts['env']['HOME'] }}</string>
        <key>PATH</key>
        <string>{{ homebrew_prefix | default('/opt/homebrew') }}/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>

        <!-- FrankenPHP / Caddy data dir (state, certs cache, etc.). Caddy's
             default is ~/Library/Application Support/Caddy — we route to a
             role-managed path so blank-reset cleanup is deterministic. -->
        <key>XDG_DATA_HOME</key>
        <string>{{ wing_runtime_dir }}/caddy-data</string>
        <key>XDG_CONFIG_HOME</key>
        <string>{{ wing_runtime_dir }}/caddy-config</string>

        <!-- Wing runtime config — read by app/Bootstrap.php / config/local.neon. -->
        <key>WING_DATA_DIR</key>
        <string>{{ wing_data_dir }}</string>
        <key>WING_API_TOKEN</key>
        <string>{{ wing_api_token | default('') }}</string>

        <!-- SEC-6 (2026-05-23): edge-trust signature. Traefik's
             wing-edge@file middleware injects this header on every
             request that reaches Wing via the public route. Wing's
             BasePresenter rejects requests that DON'T carry it (or
             carry a wrong value) BEFORE trusting forward-auth headers.
             Pre-SEC-6, any local process or Tier-N container with
             host-gateway DNS could `curl -H 'X-Authentik-Groups: nos-providers'
             http://wing:9000/admin/halt` and bypass RBAC. The 127.0.0.1
             bind (SEC-6 Caddyfile) is the first defense; this header
             is the second — defense in depth. Empty value disables
             validation (fresh install pre-regen). -->
        <key>WING_EDGE_TOKEN</key>
        <string>{{ wing_edge_token | default('') }}</string>

        <!-- Tracy debug bar gate (off by default). Empty = debug NEVER on.
             Set wing_tracy_secret to a long random value to allow debug, then
             set a `tracy-debug` cookie to that value in your browser. IP gating
             can't work behind the loopback+Traefik proxy (all requests look
             like 127.0.0.1), so the secret cookie is the only safe gate. -->
        <key>WING_TRACY_SECRET</key>
        <string>{{ wing_tracy_secret | default('') }}</string>

        <!-- Bone (host launchd at 127.0.0.1:{{ bone_port | default(8099) }}) is the
             control-plane API Wing presenters proxy through. BONE_URL is
             read by app/Model/BoneClient.php. -->
        <key>BONE_URL</key>
        <string>{{ bone_url | default('http://127.0.0.1:' + (bone_port | default(8099) | string)) }}</string>
        <key>BONE_SECRET</key>
        <string>{{ bone_secret | default('') }}</string>

{% if install_keap | default(false) %}
        <!-- KEAP cortex agent surface (loopback :{{ keap_port | default(8091) }}).
             Consumed by App\AgentKit\Tools\McpKeapTool (mcp-keap): GETs ride
             the read-only token, POST /agent/v1/captures rides read-write.
             CredentialResolver maps vault scope 'mcp-keap' -> KEAP_AGENT_TOKEN_RO. -->
        <key>KEAP_API_URL</key>
        <string>http://127.0.0.1:{{ keap_port | default(8091) }}</string>
        <key>KEAP_AGENT_TOKEN_RO</key>
        <string>{{ keap_agent_token_ro | default('') }}</string>
        <key>KEAP_AGENT_TOKEN_RW</key>
        <string>{{ keap_agent_token_rw | default('') }}</string>
{% endif %}

        <!-- HMAC secret for /api/v1/events POST (callback plugin + conductor
             agent_run_start/end events). Same value as BONE_SECRET — Bone
             signs outbound, Wing verifies inbound. EventsPresenter::checkHmac()
             reads this via getenv(). Without it, every /events POST → 500. -->
        <key>WING_EVENTS_HMAC_SECRET</key>
        <string>{{ wing_events_hmac_secret | default(bone_secret) | default('') }}</string>
        <key>WING_AUDIT_CHAIN_ENABLED</key>
        <string>{{ '1' if (wing_audit_chain_enabled | default(false) | bool) else '' }}</string>

        <!-- A17 (2026-05-20): CI deploy-trigger HMAC secret. Used by
             /api/v1/deploy-trigger to verify POSTs from Woodpecker
             pipeline. Shared with Woodpecker UI secrets (configure
             matching `nos_deploy_hmac_secret` in Repo Settings →
             Secrets). When empty, the endpoint returns 401 — auto-
             deploy is effectively off until the operator provisions
             the matching secret in Woodpecker. -->
        <key>NOS_DEPLOY_HMAC_SECRET</key>
        {# SEC L-DEPLOY1 (2026-05-24): main.yml always regenerates this to a
           random 32-byte value, so the old `+ '_pw_deploy_hmac'` prefix-derived
           fallback was a dead path that could only ship a guessable secret if
           the regen were ever skipped. Drop it — empty = deploy off until set. #}
        <string>{{ nos_deploy_hmac_secret | default('') }}</string>
        <key>NOS_DEPLOY_LOG_DIR</key>
        <string>{{ ansible_facts['env']['HOME'] }}/.nos/deploys</string>

        <!-- Qdrant — Tier-2 vector DB at apps/qdrant.yml. Empty when
             install_qdrant=false; QdrantClient.php returns 503 in that case. -->
        <key>QDRANT_URL</key>
        <string>{{ ('http://127.0.0.1:' + (qdrant_port | default(6333) | string)) if (install_qdrant | default(false)) else '' }}</string>
        <key>QDRANT_API_KEY_RO</key>
        <string>{{ qdrant_api_key_ro | default('') }}</string>

{% if install_authentik | default(false) %}
        <!-- Authentik OIDC issuer — Wing presenters can mint operator JWTs
             for cross-service calls (Bone, Qdrant via Bone). -->
        <key>AUTHENTIK_OIDC_ISSUER</key>
        <string>https://{{ authentik_domain }}/</string>
        <!-- W3 (2026-05-17): bare domain used by BasePresenter for the
             layout's end-session link (`Logout` in the top nav). Pre-W3
             the layout had `https://auth.dev.local/...` hardcoded; W3
             promotes it to a template var populated from this env. -->
        <key>AUTHENTIK_DOMAIN</key>
        <string>{{ authentik_domain }}</string>
        <!-- A15 (2026-05-17): admin-API bearer token used by the /users
             presenter (AuthentikClient) to list users / groups / apps and
             create invitations. Playbook-generated (main.yml) + pinned as the
             nos-api token `key:` in the 00-admin-groups Authentik blueprint, so
             it is known on a single blank run — no fetch-tool 2nd pass. When
             empty (install_authentik=false) the /users page renders a one-line
             operator hint instead of bleeding raw 401s. -->
        <key>AUTHENTIK_BOOTSTRAP_TOKEN</key>
        <string>{{ authentik_bootstrap_token | default('') }}</string>
        <!-- A15 (2026-05-17): comma-separated extra tenant slugs surfaced
             in the invite form's tenant <select>. Default tenant is
             always present; this adds optional tenant-scoped overlays
             (binds invitees to nos-tenant-<slug>-<tier> groups in
             addition to the global tier). -->
        <key>TENANT_SLUGS</key>
        <string>{{ (tenants_extra | default([])) | join(',') }}</string>
{% endif %}

        <!-- Tenant / host config the role-thinning recipe expects to see
             in the runtime env (Wing-side; Bone has its own copy). -->
        <key>TENANT_DOMAIN</key>
        <string>{{ tenant_domain | default('dev.local') }}</string>
        <key>HOST_ALIAS</key>
        <string>{{ host_alias | default('') }}</string>
        <key>INSTANCE_NAME</key>
        <string>{{ instance_name | default('nos') }}</string>

        <!-- Q8/A1 (2026-06-16): repo working-tree root for AgentKit's
             MigrationWriteTool. The migration YAML dir + default.config.yml
             live in the nOS playbook CHECKOUT (not the deployed Wing tree),
             and the daemon cwd is unstable — so the native AgentKit spawn
             path inherits the checkout root here. Empty → the tool fail-softs
             (reason repo_root), never writes to the wrong place. -->
        <key>NOS_REPO_ROOT</key>
        <string>{{ playbook_dir }}</string>

        <!-- SSO autologin custom preloader (Batch 5). HubPresenter reads these
             via getenv(): the splash route is dormant unless the flag is "1",
             and the warmer/redirect fallback honours the timeout (clamped to
             the plan's 10s ceiling presenter-side). Off by default. -->
        <key>SSO_ENABLE_CUSTOM_PRELOADER</key>
        <string>{{ '1' if (sso_enable_custom_preloader | default(false) | bool) else '' }}</string>
        <key>SSO_AUTOLOGIN_TIMEOUT_MS</key>
        <string>{{ sso_autologin_timeout_ms | default(5000) | string }}</string>

        <!-- A18 (2026-05-20): Cesta B Hybrid invite-flow extension.
             Master toggle — set "1" to have UsersPresenter::actionInviteCreate
             also push per-user credentials to Infisical + provision the
             Stalwart mailbox after the Authentik invitation is minted.
             Off by default so legacy installs aren't surprised; flip
             via `nos_invite_provisioning_enabled: true` in config.yml
             once both Infisical + Stalwart are healthy. -->
        <key>NOS_INVITE_PROVISIONING_ENABLED</key>
        <string>{{ '1' if (nos_invite_provisioning_enabled | default(false) | bool) else '' }}</string>

{% if install_infisical | default(false) %}
        <!-- Infisical REST endpoint (Wing-side write path). Wing's
             InfisicalClient creates per-user folders + upserts mailbox
             passwords here. Read path (AgentKit) still goes via the
             infisical CLI. Empty INFISICAL_API_TOKEN → isConfigured()
             returns false, presenter degrades gracefully. -->
        <key>INFISICAL_API_URL</key>
        <string>{{ infisical_api_url | default('http://127.0.0.1:' + (infisical_port | default(8075) | string)) }}</string>
        <key>INFISICAL_API_TOKEN</key>
        <string>{{ infisical_admin_token | default('') }}</string>
        <key>INFISICAL_USERS_PROJECT_ID</key>
        <string>{{ infisical_users_project_id | default('') }}</string>
        <key>INFISICAL_USERS_ENVIRONMENT</key>
        <string>{{ infisical_users_environment | default('prod') }}</string>
{% endif %}

{% if install_smtp_stalwart | default(false) %}
        <!-- Stalwart JMAP endpoint. Wing's StalwartProvisioner does
             Principal/set methodCalls here. Bound to 127.0.0.1 by the
             role (compose template publishes stalwart_port_admin only
             to localhost). Empty STALWART_ADMIN_PASSWORD → isConfigured()
             returns false. -->
        <key>STALWART_API_URL</key>
        <string>{{ stalwart_api_url | default('http://127.0.0.1:' + (stalwart_port_admin | default(8088) | string)) }}</string>
        <key>STALWART_ADMIN_USER</key>
        <string>{{ stalwart_admin_username | default('admin') }}</string>
        <key>STALWART_ADMIN_PASSWORD</key>
        <string>{{ stalwart_admin_password | default('') }}</string>
{% endif %}
    </dict>

    <!-- launchd respawns on crash; ThrottleInterval prevents tight loops
         (60s = same as A3a Bone). -->
    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>StandardOutPath</key>
    <string>{{ wing_log_dir }}/launchd.out.log</string>

    <key>StandardErrorPath</key>
    <string>{{ wing_log_dir }}/launchd.err.log</string>

    <!-- Soft memory cap; FrankenPHP + 4 PHP threads + Wing's small SQLite
         working set fits comfortably under 1G in steady state. -->
    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>4096</integer>
    </dict>
</dict>
</plist>
