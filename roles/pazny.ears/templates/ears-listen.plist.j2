<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>{{ ears_launchd_label }}</string>

    <!--
        The ear, running until someone stops it. It transcribes and appends
        turns to {{ ears_runtime_dir }}/turns/; it calls no agent and executes
        nothing — every gate in this estate sits after the point where a turn
        becomes an action, so the listener stops short of it deliberately.

        RENDERED ALWAYS, BOOTSTRAPPED ONLY WHEN ears_always_listen IS TRUE.
        A microphone that starts because a file exists is not a decision.
    -->
    <!-- THE BUNDLE, not the interpreter. Running the venv python directly is
         what left macOS with nothing to attach a microphone grant to; the
         bundle has a bundle id, so the operator is asked once and the answer
         is remembered. Same python, same listener, one hop further out. -->
    <key>ProgramArguments</key>
    <array>
        <string>{{ ears_app_dir }}/Contents/MacOS/ears</string>
    </array>

    <key>WorkingDirectory</key>
    <string>{{ ears_runtime_dir }}</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>{{ ansible_facts['env']['HOME'] }}</string>
        <!-- ffmpeg does the capture and the decoding; it is the only binary
             outside the venv this job needs, and it is already installed. -->
        <key>PATH</key>
        <string>{{ homebrew_prefix | default('/opt/homebrew') }}/bin:/usr/local/bin:/usr/bin:/bin:{{ ears_venv }}/bin</string>
        <key>EARS_HOME</key>
        <string>{{ ears_runtime_dir }}</string>
        <key>EARS_ASR_MODEL</key>
        <string>{{ ears_asr_model }}</string>
        <key>EARS_WAKE_PHRASE</key>
        <string>{{ ears_wake_phrase }}</string>
        <key>EARS_SUBMIT_PHRASE</key>
        <string>{{ ears_submit_phrase }}</string>
        <key>EARS_SILENCE_SECONDS</key>
        <string>{{ ears_silence_seconds }}</string>
        <!-- The retention horizon, enforced by the writer and REPORTED by
             tools/caddy-status.py, which prints the age of the oldest surviving
             transcript. A horizon nothing reads back is how this estate ended
             up with one measured in days that could never fire. -->
        <key>EARS_RETENTION_DAYS</key>
        <string>{{ ears_retention_days }}</string>
        <key>EARS_SILENCE_GAP</key>
        <string>{{ ears_silence_gap }}</string>
        <key>EARS_INPUT_GAIN</key>
        <string>{{ ears_input_gain }}</string>
        <key>EARS_INPUT</key>
        <string>{{ ears_input_device }}</string>
        <!-- 1 = each finished turn is handed to caddy (detached), which asks
             the agent and typechecks what comes back. Not execution: the
             binding gate is still between a chain and any effect. -->
        <key>EARS_AUTORUN</key>
        <string>{{ '1' if (ears_autorun | default(true) | bool) else '' }}</string>
        <key>NOS_REPO_ROOT</key>
        <string>{{ playbook_dir }}</string>
        <!-- The launcher needs these to VALIDATE and to RECORD. Absent, it says
             so in its `gaps` rather than reporting a chain as fine or a session
             as written — an unvalidated chain must never read as a valid one. -->
        <key>CORTEX_TOKEN_RO</key>
        <string>{{ cortex_ro_token | default('') }}</string>
        <key>KEAP_AGENT_TOKEN_RW</key>
        <string>{{ keap_agent_token_rw | default('') }}</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <!-- KeepAlive with a throttle: if macOS refuses the microphone, the process
         exits 3 rather than sitting there hearing nothing, and launchd retries
         every {{ ears_throttle_seconds }}s. That turns a permanent silent
         denial into a visible restart loop plus mic_ok=false in state.json —
         the distinction the reader exists to make. -->
    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>{{ ears_throttle_seconds }}</integer>

    <key>StandardOutPath</key>
    <string>{{ ears_log_dir }}/launchd.out.log</string>

    <key>StandardErrorPath</key>
    <string>{{ ears_log_dir }}/launchd.err.log</string>
</dict>
</plist>
