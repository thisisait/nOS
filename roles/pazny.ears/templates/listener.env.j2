# Rendered by roles/pazny.ears — the role's ears_* vars as the listener's env
# defaults (ears-listen.py / caddy.py apply these with setdefault; a real
# environment still wins). Edit config.yml and re-run --tags ears, not this file.
EARS_KEEP_TRANSCRIPTS={{ '1' if (ears_keep_transcripts | bool) else '0' }}
EARS_RETENTION_DAYS={{ ears_retention_days | int }}
EARS_WAKE_PHRASE={{ ears_wake_phrase }}
EARS_SUBMIT_PHRASE={{ ears_submit_phrase }}
EARS_SILENCE_SECONDS={{ ears_silence_seconds }}
EARS_SILENCE_GAP={{ ears_silence_gap }}
EARS_INPUT_GAIN={{ ears_input_gain }}
EARS_ASR_MODEL={{ ears_asr_model }}
EARS_DUMP_SEGMENTS={{ ears_dump_segments | int }}
EARS_INPUT={{ ears_input_device }}
EARS_AUTORUN={{ '1' if (ears_autorun | bool) else '0' }}
