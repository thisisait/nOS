# =============================================================================
# pazny.postgresql — compose override fragment
# Merged into `docker compose up` by tasks/stacks/core-up.yml via
# ansible.builtin.find across {{ stacks_dir }}/infra/overrides/*.yml.
#
# Does not declare top-level networks: — infra_net and {{ stacks_shared_network }}
# are defined in base templates/stacks/infra/docker-compose.yml.j2.
# Docker compose merge semantics allow referencing external networks as long
# as any of the merged files defines them.
# =============================================================================

services:
  postgresql:
    image: postgres:{{ postgresql_version }}
    hostname: postgresql
    restart: unless-stopped
    ports:
      - "127.0.0.1:{{ postgresql_port | default(5432) }}:5432"
    volumes:
      - {{ postgresql_data_dir | default(ansible_facts['env']['HOME'] + '/postgresql/data') }}:/var/lib/postgresql/data
{% if postgresql_ssl_enabled | default(false) %}
      # REM-009: self-signed server cert (role-generated). 0600 key works on
      # Docker Desktop's FUSE ownership; see role defaults for the Linux note.
      - {{ postgresql_certs_dir | default(ansible_facts['env']['HOME'] + '/postgresql/certs') }}/server.crt:/certs/server.crt:ro
      - {{ postgresql_certs_dir | default(ansible_facts['env']['HOME'] + '/postgresql/certs') }}/server.key:/certs/server.key:ro
{% endif %}
    command:
      - "-c"
      - "max_connections={{ postgresql_max_connections | default(600) }}"
      - "-c"
      # Auto-close truly idle client sessions. Authentik 2025.x has a pool
      # leak that grows to ~400 idle connections even with CONN_MAX_AGE=0;
      # letting PostgreSQL reap them server-side is the reliable fix.
      - "idle_session_timeout={{ postgresql_idle_session_timeout_ms | default(300000) }}"
      - "-c"
      # Safety net for rogue clients that open a transaction and wander off.
      - "idle_in_transaction_session_timeout={{ postgresql_idle_in_transaction_timeout_ms | default(60000) }}"
{% if postgresql_ssl_enabled | default(false) %}
      # REM-009 in-transit TLS. NOTE the correction REM-217 forced on the
      # comment that used to stand here: libpq clients do upgrade under
      # `prefer`, but node-postgres clients do NOT, so "upgrade automatically"
      # was true of some drivers and read as true of all of them. Each client
      # now names its own mode; see tests/anatomy/test_postgresql_ssl.py.
      - "-c"
      - "ssl=on"
      - "-c"
      - "ssl_cert_file=/certs/server.crt"
      - "-c"
      - "ssl_key_file=/certs/server.key"
      # REM-217 (4). The default for the 16 line is
      # `HIGH:MEDIUM:+3DES:!aNULL` — inherited, never chosen — which offers
      # 3DES (SWEET32, CVE-2016-2183: a 64-bit block cipher, birthday-bound at
      # ~32 GB per key) and the whole MEDIUM grade. Nothing USES them: every
      # session observed in pg_stat_ssl negotiated TLSv1.3 with
      # TLS_AES_256_GCM_SHA384. They are available to a downgrade-capable
      # ACTIVE attacker, which on a flat docker fabric with 23 host-gateway
      # containers (REM-214) is not a remote threat model.
      - "-c"
      - "ssl_ciphers={{ postgresql_ssl_ciphers | default('HIGH:!aNULL:!3DES:!MEDIUM:!SHA1:!RC4:!DES') }}"
      # ssl_min_protocol_version stays at the 1.2 default ON PURPOSE this
      # round. Raising it to TLSv1.3 is nearly free — every observed session is
      # already there — but this converge is also the one that first moves four
      # cleartext clients onto TLS, and a client that fails to connect must
      # have exactly one candidate cause. Raise the floor after
      # tools/tls-uptake.py shows those four negotiating.
{% endif %}
    environment:
      POSTGRES_PASSWORD: "{{ postgresql_root_password | default(nos_derived_secrets.postgresql) }}"
      POSTGRES_USER: "{{ postgresql_root_user | default('postgres') }}"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ postgresql_root_user | default('postgres') }}"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 15s
    networks:
      - infra_net
      - {{ stacks_shared_network }}
    logging:
      driver: "json-file"
      options:
        max-size: "20m"
        max-file: "5"
    mem_limit: {{ postgresql_mem_limit | default(docker_mem_limit_standard) }}
    cpus: {{ docker_cpus_standard | default('1.0') }}
