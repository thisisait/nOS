# ==============================================================================
# pazny.smtp_stalwart — Stalwart Mail Server compose override fragment
# Merged into `docker compose -p infra up` via tasks/stacks/core-up.yml.
#
# Stalwart binds to host ports directly (not Traefik) — SMTP (25/465/587)
# and IMAP (993) need raw TCP, not HTTP. The webadmin (HTTPS on a separate
# port) goes through Traefik like everything else.
# ==============================================================================

services:
  smtp_stalwart:
    image: {{ stalwart_image }}
    container_name: smtp_stalwart
    restart: unless-stopped
    ports:
{% set _bind = '127.0.0.1:' if (stalwart_lan_only | default(false) | bool) else '' %}
      - "{{ _bind }}{{ stalwart_port_smtp }}:25"
      - "{{ _bind }}{{ stalwart_port_smtps }}:465"
      - "{{ _bind }}{{ stalwart_port_submission }}:587"
      - "{{ _bind }}{{ stalwart_port_imap }}:993"
      # WebAdmin + JMAP management API. Always 127.0.0.1 — Wing (host launchd)
      # reaches /jmap here; public access is via Traefik route below.
      - "127.0.0.1:{{ stalwart_port_admin }}:8080"
    environment:
      # First-boot bootstrap (v0.16+). STALWART_RECOVERY_ADMIN pre-pins
      # the admin credential so the playbook skips the WebUI wizard +
      # the "temporary password printed to console" step. Format:
      # "<user>:<password>". After first boot Stalwart writes /etc/stalwart/
      # config.json and the env var is no longer consulted (except as a
      # break-glass override on subsequent boots in recovery mode).
      STALWART_RECOVERY_ADMIN: "{{ stalwart_admin_username }}:{{ stalwart_admin_password }}"
      # PUBLIC_URL — Stalwart uses this for self-referencing links in the
      # webadmin UI + OIDC callback paths. Traefik fronts the same host.
      STALWART_PUBLIC_URL: "https://{{ stalwart_domain }}"
    volumes:
      # v0.16 layout — config + data are two top-level dirs (was 3 under
      # /opt/stalwart-mail/ in v0.11). Host paths kept under stalwart_data_dir
      # for blank-reset symmetry.
      - {{ stalwart_data_dir }}/etc:/etc/stalwart
      - {{ stalwart_data_dir }}/var:/var/lib/stalwart
{% if not (tenant_domain_is_local | default(true) | bool) %}
      # Wildcard cert from pazny.acme — Stalwart reads PEM directly via
      # config.json::server.listener.*.tls.{certificate,private-key} pointing
      # at these mount paths (operator wires it once in the WebUI wizard).
      - {{ stalwart_tls_cert_path }}:/etc/stalwart/certs/cert.pem:ro
      - {{ stalwart_tls_cert_key }}:/etc/stalwart/certs/key.pem:ro
{% endif %}
    networks:
      - infra_net
      - {{ stacks_shared_network }}
    labels:
      # Webadmin via Traefik (HTTPS). Stalwart's webadmin lives on internal
      # port 8080; Traefik fronts it at https://{{ stalwart_domain }}/admin.
      - "traefik.enable=true"
      - "traefik.http.routers.smtp-stalwart-webadmin.rule=Host(`{{ stalwart_domain }}`)"
      - "traefik.http.routers.smtp-stalwart-webadmin.entrypoints=websecure"
      - "traefik.http.routers.smtp-stalwart-webadmin.tls=true"
      - "traefik.http.routers.smtp-stalwart-webadmin.middlewares=authentik@file,security-headers@file,compress@file"
      - "traefik.http.services.smtp-stalwart-webadmin.loadbalancer.server.port=8080"
    logging:
      driver: "json-file"
      options:
        max-size: "20m"
        max-file: "5"
    mem_limit: {{ stalwart_mem_limit }}
    cpus: {{ stalwart_cpus }}
