# =============================================================================
# pazny.nextcloud — compose override fragment
# Merged do `docker compose -p iiab up` v tasks/stacks/stack-up.yml pres
# ansible.builtin.find nad {{ stacks_dir }}/iiab/overrides/*.yml.
#
# Nedeklaruje top-level networks: — iiab_net a {{ stacks_shared_network }}
# jsou definovane v base templates/stacks/iiab/docker-compose.yml.j2.
# =============================================================================

services:
  nextcloud:
    image: nextcloud:{{ nextcloud_version | default('stable') }}
    restart: unless-stopped
    ports:
{% if services_lan_access | default(false) %}
      - "{{ nextcloud_port | default(8085) }}:80"
{% else %}
      - "127.0.0.1:{{ nextcloud_port | default(8085) }}:80"
{% endif %}
    volumes:
      - {{ nextcloud_dir }}:/var/www/html
      - {{ nextcloud_data_dir }}:/data
    environment:
      MYSQL_HOST: "{% if install_mariadb | default(false) %}mariadb{% else %}{{ nextcloud_db_host | default('127.0.0.1') }}{% endif %}"
      MYSQL_DATABASE: "{{ nextcloud_db_name }}"
      MYSQL_USER: "{{ nextcloud_db_user }}"
      MYSQL_PASSWORD: "{{ nextcloud_db_password }}"
      NEXTCLOUD_ADMIN_USER: "{{ nextcloud_admin_user }}"
      NEXTCLOUD_ADMIN_PASSWORD: "{{ nextcloud_admin_password }}"
      NEXTCLOUD_DATA_DIR: "/data"
      NEXTCLOUD_TRUSTED_DOMAINS: "{{ nextcloud_domain | default('cloud' ~ (_host_alias_seg | default('')) ~ '.' ~ (tenant_domain | default('dev.local'))) }} localhost 127.0.0.1"
      OVERWRITEPROTOCOL: "https"
{% if install_mailpit | default(false) %}
      # ── SMTP relay → Mailpit (dev mail capture) ────────────────────────────
      # Mailpit is on iiab_net — reachable by docker DNS as 'mailpit'.
      SMTP_HOST: "mailpit"
      SMTP_PORT: "1025"
      SMTP_NAME: ""
      SMTP_PASSWORD: ""
      SMTP_AUTHTYPE: "NONE"
      SMTP_SECURE: ""
      MAIL_DOMAIN: "{{ tenant_domain | default('dev.local') }}"
      MAIL_FROM_ADDRESS: "nextcloud"
{% endif %}
    networks:
      - iiab_net
      - {{ stacks_shared_network }}
    # Disable IPv6 in the container: the `auth.<tld>:host-gateway` extra_host
    # (nextcloud-base plugin) resolves to BOTH a working IPv4 (192.168.65.254)
    # and a DEAD IPv6 (fdc4:..::254) host-gateway. user_oidc's discovery fetch
    # intermittently picks the IPv6 and fails with "Could not detect any host"
    # → "Could not reach the OpenID Connect provider" at login (live 2026-06-14,
    # the SSO redirect that survived a blank). NC speaks IPv4 to everything
    # (mariadb/redis/connector/auth host-gateway), so dropping IPv6 is safe.
    sysctls:
      net.ipv6.conf.all.disable_ipv6: "1"
      net.ipv6.conf.default.disable_ipv6: "1"
    logging:
      driver: "json-file"
      options:
        max-size: "20m"
        max-file: "5"
    mem_limit: {{ nextcloud_mem_limit | default(docker_mem_limit_critical) }}
    cpus: {{ docker_cpus_standard | default('1.0') }}
