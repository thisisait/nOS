# =============================================================================
# pazny.gitea — compose override fragment
# Merged do `docker compose -p devops up` v tasks/stacks/stack-up.yml pres
# ansible.builtin.find nad {{ stacks_dir }}/devops/overrides/*.yml.
#
# Nedeklaruje top-level networks: — devops_net a {{ stacks_shared_network }}
# jsou definovane v base templates/stacks/devops/docker-compose.yml.j2.
# =============================================================================

services:
  gitea:
    image: gitea/gitea:{{ gitea_version | default('latest') }}
    restart: unless-stopped
    ports:
{% if services_lan_access | default(false) %}
      - "{{ gitea_port | default(3003) }}:3000"
{% else %}
      - "127.0.0.1:{{ gitea_port | default(3003) }}:3000"
{% endif %}
      - "127.0.0.1:{{ gitea_ssh_port | default(2222) }}:22"
    volumes:
      - {{ gitea_data_dir | default(ansible_facts['env']['HOME'] + '/gitea') }}:/data
    environment:
      USER_UID: "{{ ansible_facts['user_uid'] }}"
      USER_GID: "{{ ansible_facts['user_gid'] }}"
      GITEA__server__DOMAIN: "{{ gitea_domain | default('git' ~ (_host_alias_seg | default('')) ~ '.' ~ (tenant_domain | default('dev.local'))) }}"
      GITEA__server__ROOT_URL: "https://{{ gitea_domain | default('git' ~ (_host_alias_seg | default('')) ~ '.' ~ (tenant_domain | default('dev.local'))) }}"
      GITEA__server__SSH_PORT: "{{ gitea_ssh_port | default(2222) }}"
      GITEA__server__OFFLINE_MODE: "true"
      GITEA__database__DB_TYPE: "sqlite3"
      GITEA__security__INSTALL_LOCK: "true"
      GITEA__security__SECRET_KEY: "{{ gitea_secret_key | default(global_password_prefix + '_pw_gitea_secret') }}"
      GITEA__service__DISABLE_REGISTRATION: "{{ gitea_disable_registration | default(false) | string | lower }}"
      # Pure-SSO onboarding: hide the local self-registration form (it was
      # publicly reachable — anyone could create a Gitea account) but STILL
      # allow OAuth2/OIDC first-login auto-create, so Authentik users onboard
      # automatically. DISABLE_REGISTRATION=true would block OIDC auto-create
      # too (admin-only), breaking the blank's zero-manual-signup goal; this
      # flag is the "external registration only" gate. Admin is API-provisioned.
      GITEA__service__ALLOW_ONLY_EXTERNAL_REGISTRATION: "{{ gitea_allow_only_external_registration | default(true) | string | lower }}"
      GITEA__log__LEVEL: "Warn"
      # ── Prometheus metrics (Grafana observability epic) ────────────────────
      # Exposes /metrics with gitea_repositories / gitea_users /
      # gitea_organizations (+ more). The endpoint is token-gated: with a TOKEN
      # set, scrapers MUST send `Authorization: Bearer <token>` — the Alloy
      # scrape block carries the matching gitea_metrics_token. Endpoint binds on
      # the internal :3000, reachable from Alloy via the published 127.0.0.1
      # gitea_port mapping above.
      GITEA__metrics__ENABLED: "true"
      GITEA__metrics__TOKEN: "{{ gitea_metrics_token | default(global_password_prefix + '_pw_gitea_metrics') }}"
      TZ: "Europe/Prague"
{% if install_mailpit | default(false) %}
      # ── SMTP relay → Mailpit (dev mail capture) ────────────────────────────
      # Mailpit lives on iiab_net only; reach it via host-gateway.
      GITEA__mailer__ENABLED: "true"
      GITEA__mailer__SMTP_ADDR: "host.docker.internal"
      GITEA__mailer__SMTP_PORT: "1025"
      GITEA__mailer__FROM: "gitea@{{ tenant_domain | default('dev.local') }}"
      GITEA__mailer__USER: ""
      GITEA__mailer__PASSWD: ""
{% endif %}
{% if install_mailpit | default(false) %}
    extra_hosts:
      - "host.docker.internal:host-gateway"
{% endif %}
    healthcheck:
      test: ["CMD", "curl", "-sf", "http://localhost:3000/api/v1/version"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s
    networks:
      - devops_net
      - {{ stacks_shared_network }}
    logging:
      driver: "json-file"
      options:
        max-size: "20m"
        max-file: "5"
    mem_limit: {{ gitea_mem_limit | default(docker_mem_limit_standard) }}
    cpus: {{ docker_cpus_standard | default('1.0') }}
