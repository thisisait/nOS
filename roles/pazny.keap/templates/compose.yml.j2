# =============================================================================
# pazny.keap — compose override fragment (CORTEX / knowledge layer)
# Merged into `docker compose -p iiab up` in tasks/stacks/stack-up.yml via
# ansible.builtin.find over {{ stacks_dir }}/iiab/overrides/*.yml.
#
# Built from source: the role clones nos-keap at {{ keap_repo_ref }} and
# `docker compose up` builds nos/keap from the clone (face precedent). The
# image's Dockerfile bakes a HEALTHCHECK on /api/health, so the STRICT
# in-stream health-wait (A19) sees a real health state.
#
# Does not declare top-level networks: — gated_net is defined (external) in
# templates/stacks/iiab/docker-compose.yml.j2. SEC-02: KEAP joins ONLY the
# Traefik-only gated_net — its header_oidc identity (server/identity.ts)
# trusts X-Authentik-* headers, so peers must not reach :8080. Traefik (also
# on gated_net) routes it via traefik_container_upstreams (keap: 8080).
#
# The 127.0.0.1 port publish is NOT for Traefik — it is the AGENT SURFACE:
# host-side AgentKit processes call http://127.0.0.1:{{ keap_port | default(8091) }}/agent/v1
# with scope-split bearer tokens (RO/RW). Containers cannot reach
# Docker-published loopback ports (A19-verified), and KEAP_TRUSTED_PROXY=1
# makes header-less /api requests 401 instead of falling back to a dev
# identity — so the loopback surface cannot forge or inherit human identity.
# =============================================================================

services:
  keap:
    build:
      context: {{ keap_src_dir | default(ansible_facts['env']['HOME'] + '/keap/src') }}
      dockerfile: Dockerfile
    image: nos/keap:{{ keap_version | default('latest') }}
    restart: unless-stopped
    ports:
      - "127.0.0.1:{{ keap_port | default(8091) }}:8080"
    volumes:
      - {{ keap_data_dir | default(ansible_facts['env']['HOME'] + '/keap/data') }}:/data
      # Knowledge SoT (git-tracked) mounted READ-ONLY from the clone —
      # knowledge/ingest.mjs (post.yml) reads it and applies idempotently. A RO
      # bind-mount is not a docker volume (no volume spam).
      #
      # It does NOT exist so "data changes can ride the git ref without an image
      # rebuild" — that was the pre-2026-07-24 reasoning and it invites exactly
      # the wrong conclusion, that skipping a rebuild is safe. `up -d --build`
      # runs on every converge. The mount exists because the IMAGE CANNOT
      # SELF-SERVE AN INGEST: the Dockerfile bakes only ingest/dump/lint.mjs, so
      # without the mount there is no canonical tree in the container to apply.
      # (KEAP docs/specs/deploy-knowledge-mount-split.md §3.)
      #
      # Mount ALL of knowledge/ (not just canonical): v1.26.0's ingest.mjs imports
      # ./_ontology.mjs and applies knowledge/ontology/, and the nos/keap image can
      # lag the git ref on those files (the 1.26.0 image shipped ingest.mjs without
      # _ontology.mjs → ERR_MODULE_NOT_FOUND on a blank all-on 2026-07-24). Mounting
      # the whole dir from the v-pinned checkout keeps canonical + ontology + the
      # ingest modules on ONE consistent version. (KEAP handoff 2026-07-24: "mount
      # all of knowledge/ or none".)
      - {{ keap_src_dir | default(ansible_facts['env']['HOME'] + '/keap/src') }}/knowledge:/app/knowledge:ro
{% if keap_fs_sync | default(true) %}
      # FS-doctrine mirror (KEAP v1.7.0 server/fs-sync.ts): the per-user tree
      # {{ nos_data_root }}/tenants/<slug>/users/<uid>/{documents,library,inbox}
      # mounted READ-ONLY so KEAP turns per-user files into knowledge objects
      # WITHOUT ever writing them. Docs land here from Nextcloud/euro-office (class-3);
      # fs-sync attributes per user (server/graph.ts keeps users' trees separate).
      - {{ nos_data_root }}/tenants/{{ nos_tenant_slug }}/users:/user-files:ro
{% if keap_selfmodel | default(true) %}
      # nOS architecture self-model (class-2 SHARED, docs/archive/keap-selfmodel.md).
      # The generated tree lives OUTSIDE the per-user tree (host path is class-2
      # shared/nos-docs, not users/<uid>/), and is presented to fs-sync as a
      # reserved uid via this nested bind-mount so it becomes a standalone "nOS"
      # constellation. Its top-class dir ("{{ keap_selfmodel_top }}") is in
      # KEAP_FS_SYNC_DIRS below. RO — nOS writes host-side, KEAP only reads.
      - {{ keap_selfmodel_root }}:/user-files/{{ keap_selfmodel_uid }}:ro
{% endif %}
{% endif %}
    environment:
      PORT: "8080"
      KEAP_DATA_DIR: /data
      # Reject header-less /api requests (401) — the container only ever sees
      # legitimate identity headers via Traefik's authentik@file on gated_net.
      KEAP_TRUSTED_PROXY: "1"
      KEAP_TENANT_DOMAIN: "{{ tenant_domain | default('dev.local') }}"
      # CSP frame-ancestors allowlist — a LIST of origins, scheme explicit, 1:1
      # with the directive it renders. (It replaced KEAP_FACE_HOST, which took a
      # single bare host and assumed https: no second embedder, no local http
      # instance, and named after nOS's UI in a product that must run without
      # nOS. That shim was dropped when the pin passed v1.21.0 — hidden_fees/05.)
      KEAP_EMBED_ORIGINS: "https://{{ face_domain | default('os' ~ (_host_alias_seg | default('')) ~ '.' ~ (tenant_domain | default('dev.local'))) }}{% for o in keap_embed_origins | default([]) %},{{ o }}{% endfor %}"
      # Canonical public origin — server/routes.ts CSRF same-origin guard +
      # /ext/v1 pairing canonicalOrigin. Without it a non-browser client (no
      # Sec-Fetch-Site) 403s under KEAP_TRUSTED_PROXY, and the extension can't
      # self-configure its instance URL.
      KEAP_PUBLIC_URL: "https://{{ keap_domain }}"
      # Agent-surface bearer tokens (scope-split, R9): read-only vs read+write,
      # plus the DEVICE tier (write-only /ingest/v1 intake — AR glasses etc.).
      KEAP_AGENT_TOKEN_RO: "{{ keap_agent_token_ro }}"
      KEAP_AGENT_TOKEN_RW: "{{ keap_agent_token_rw }}"
      KEAP_AGENT_TOKEN_CAPTURE: "{{ keap_agent_token_capture }}"
{% if (install_cortex | default(false)) and (keap_cortex_cutover | default(false)) %}
      # ── THE CUTOVER IS LIVE ────────────────────────────────────────────────
      # KEAP v1.29.0+ READS these: with CORTEX_BACKEND_URL set, /agent/v1/validate
      # and /validate/opcodes are proxied to the host cortex organ and KEAP's own
      # typechecker never runs. Unreachable organ ⇒ 502, never a silent fall back
      # to local (KEAP docs/specs/cortex-cutover.md §1: the two backends stamp
      # different databaseIds, and a fallback hands out ASTs from a language the
      # operator does not think is live).
      #
      # Gated on its OWN flag, not on install_cortex, so a converge can stand the
      # organ up and leave KEAP answering locally. Standing up a daemon and
      # repointing a live product's reasoning at it are two decisions, and
      # collapsing them into one variable means the first cannot be tested
      # without the second. Rollback is `keap_cortex_cutover: false` + converge.
      CORTEX_BACKEND_URL: "http://host.docker.internal:{{ cortex_port | default(8098) }}"
      # Required WITH the URL. The organ has its own token space; KEAP presents
      # this rather than forwarding the caller's bearer, which means nothing on
      # the far side. URL without token ⇒ KEAP 500s and names the missing var.
      CORTEX_TOKEN_RO: "{{ cortex_ro_token }}"
{% endif %}
{% if keap_fs_sync | default(true) %}
      # FS-sync (v1.7.0): mirror per-user files → knowledge objects. Root is the
      # RO-mounted doctrine per-user tree; sync the class-3 content subdirs.
      KEAP_USER_FILES_DIR: /user-files
      KEAP_FS_SYNC_DIRS: "{{ keap_fs_sync_dirs | default('documents,library,inbox') }}"
      KEAP_FS_SYNC_INTERVAL_S: "{{ keap_fs_sync_interval_s | default(300) }}"
{% if keap_selfmodel | default(true) %}
      # Option C (KEAP v1.8.0): files of these reserved uids mirror with
      # visibility 'shared' — the self-model renders for EVERY tenant user,
      # not just admins. Unset ⇒ users pass behaves exactly like v1.7.0.
      KEAP_FS_SHARED_UIDS: "{{ keap_selfmodel_uid | default('nos-docs') }}"
{% endif %}
{% endif %}
{% if keap_ollama_url | default('') %}
      # Optional live embedder for free-text semantic search. Stored vectors
      # come from the host-side keap-embed-sync Pulse job either way; this
      # only embeds ad-hoc QUERY text. Docker Desktop (Mac): set to
      # http://host.docker.internal:11434. Linux host-gateway cannot reach a
      # loopback-bound Ollama, hence default-off.
      KEAP_OLLAMA_URL: "{{ keap_ollama_url }}"
{% endif %}
    networks:
      # SEC-02: Traefik-only gated_net (no iiab_net / shared_net). KEAP has no
      # container-side deps — Qdrant/embeddings go through host-side Bone.
      - gated_net
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    mem_limit: {{ keap_mem_limit | default(docker_mem_limit_light) }}
    cpus: {{ keap_cpus | default(docker_cpus_light) }}
