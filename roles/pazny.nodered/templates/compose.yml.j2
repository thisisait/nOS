# =============================================================================
# pazny.nodered - compose override fragment
# Merged into `docker compose -p iiab up` in tasks/stacks/stack-up.yml via
# ansible.builtin.find over {{ stacks_dir }}/iiab/overrides/*.yml.
#
# Does not declare top-level networks: - iiab_net and {{ stacks_shared_network }}
# are defined in the base templates/stacks/iiab/docker-compose.yml.j2.
#
# The nodered/node-red image is multi-arch (amd64 + arm64) - runs natively on M1.
# The container runs as UID 1000 (defaults/main.yml: nodered_uid).
# =============================================================================

services:
  nodered:
    image: nodered/node-red:{{ nodered_version }}
    restart: unless-stopped
    user: "{{ nodered_uid }}:{{ nodered_gid }}"
    ports:
{% if services_lan_access %}
      - "{{ nodered_port }}:1880"
{% else %}
      - "127.0.0.1:{{ nodered_port }}:1880"
{% endif %}
    volumes:
      - {{ nodered_data_dir }}:/data
    environment:
      TZ: "{{ nodered_timezone }}"
      FLOWS: "{{ nodered_flows_file }}"
      NODE_RED_ENABLE_SAFE_MODE: "{{ nodered_enable_safe_mode }}"
      NODE_RED_ENABLE_PROJECTS: "{{ nodered_enable_projects }}"
{% if install_authentik and nodered_native_oidc_enabled %}
      # ── Authentik native OIDC (β1.B 2026-05-05) ─────────────────────────
      # Consumed by /data/settings.js's adminAuth.strategy block via
      # passport-openidconnect. clientID + clientSecret read from env so
      # secrets aren't baked into the static settings.js render.
      # NODERED_OIDC_CLIENT_* moved to the nodered-base compose-extension (D2, fee 52).
{% endif %}
    healthcheck:
      test: ["CMD-SHELL", "wget --spider -q http://127.0.0.1:1880/ 2>&1 || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 90s
    networks:
      - iiab_net
      - {{ stacks_shared_network }}
    logging:
      driver: "json-file"
      options:
        max-size: "20m"
        max-file: "5"
    mem_limit: {{ nodered_mem_limit | default(docker_mem_limit_standard) }}
    cpus: {{ nodered_cpus | default(docker_cpus_standard | default('1.0')) }}
