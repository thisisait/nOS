/**
 * Node-RED settings.js — rendered by the pazny.nodered role.
 *
 * β1.B (2026-05-05) — adminAuth uses passport-openidconnect when
 * `install_authentik=true` AND `nodered_native_oidc_enabled=true`. The
 * `passport-openidconnect` package is pre-seeded into /data/node_modules
 * via /data/package.json (Node-RED's entrypoint installs missing deps on
 * boot). When disabled, adminAuth is omitted (editor open) — operators
 * relying on the pre-β1 forward_auth gate must keep install_nginx=true
 * with the Authentik forward_auth snippet on the vhost.
 *
 * DO NOT EDIT MANUALLY — regenerated from settings.js.j2.
 */
{% set _oidc_on = (install_authentik | default(false)) and (nodered_native_oidc_enabled | default(false)) %}
{% set _authentik_domain = authentik_domain | default('auth' ~ (_host_alias_seg | default('')) ~ '.' ~ (tenant_domain | default('dev.local'))) %}
{# ── SSO autologin (force-OIDC) — sso-autologin-plan.md Batch 3 (b) ──────────
   When autologin resolves true (gated on the SAME expression as the plugin's
   authentik.autologin.enabled), the passport-openidconnect strategy gets
   `autoLogin: true` so Node-RED initiates the OIDC flow on editor load instead
   of showing the "Sign in with Authentik" button. supports: partial — this is
   a REDIRECT, NOT a form-hide. The strategy type has no local password
   login, so there is no break-glass user here (see users() below). The
   trailing `| bool` coerces the loader/play-var string to a real bool; default false keeps everything dormant. #}
{% set _autologin_on = _oidc_on and (nodered_autologin_enabled | default(false) | bool) %}

{% if _oidc_on %}
const _TIER1 = {{ (authentik_rbac_tiers | default([]) | selectattr('tier', 'equalto', 1) | map(attribute='groups') | first | default(['nos-providers', 'nos-admins'])) | tojson }};
const _grants = {};
{% endif %}
module.exports = {
    uiPort: process.env.PORT || 1880,
    mqttReconnectTime: 15000,
    serialReconnectTime: 15000,
    debugMaxLength: 1000,
    httpAdminRoot: '/',
    httpNodeRoot: '/',
    httpStatic: '/data/static/',
    ui: { path: 'ui' },
    functionGlobalContext: {},
    exportGlobalContextKeys: false,
{% if _oidc_on %}
    // ── Authentik native OIDC (β1.B) ─────────────────────────────────────────
    // Tier-1 groups (authentik_rbac_tiers) get '*', other groups 'read'; no
    // groups claim = no login. users() only admits names verify() saw, so a
    // restart re-asks Authentik. Gate: test_nodered_admin_is_tier_one.py.
    adminAuth: {
        type: "strategy",
        strategy: {
            name: "openidconnect",
            label: "Sign in with Authentik",
            icon: "fa-cloud",
{% if _autologin_on %}
            // ── SSO autologin (force-OIDC) — Batch 3 (b), gated on
            //    nodered_autologin_enabled (sso_autologin_nodered >
            //    sso_autologin_min_tier_2 > sso_autologin). autoLogin makes
            //    Node-RED start the OIDC flow on load instead of showing the
            //    button. This is a REDIRECT (supports: partial).
            autoLogin: true,
{% endif %}
            strategy: require("passport-openidconnect").Strategy,
            options: {
                issuer: "https://{{ _authentik_domain }}/application/o/nodered/",
                authorizationURL: "https://{{ _authentik_domain }}/application/o/authorize/",
                tokenURL: "https://{{ _authentik_domain }}/application/o/token/",
                userInfoURL: "https://{{ _authentik_domain }}/application/o/userinfo/",
                clientID: process.env.NODERED_OIDC_CLIENT_ID,
                clientSecret: process.env.NODERED_OIDC_CLIENT_SECRET,
                callbackURL: "https://{{ nodered_domain | default('nodered' ~ (_host_alias_seg | default('')) ~ '.' ~ (tenant_domain | default('dev.local'))) }}/auth/strategy/callback",
                scope: ["openid", "profile", "email"],
                proxy: true,
                verify: function(issuer, profile, done) {
                    var username = profile.username
                        || (profile._json && profile._json["{{ nodered_oidc_username_claim | default('preferred_username') }}"])
                        || profile.id;
                    var groups = profile._json && profile._json.groups;
                    if (!username || !Array.isArray(groups)) return done(null, false);
                    _grants[username] = groups.some(function (g) { return _TIER1.indexOf(g) >= 0; }) ? '*' : 'read';
                    return done(null, { username: username });
                }
            }
        },
        users: function(username) {
            var p = _grants[username];
            return Promise.resolve(p ? { username: username, permissions: p } : null);
        }
    },
{% endif %}
    logging: {
        console: {
            level: "info",
            metrics: false,
            audit: false
        }
    },
    editorTheme: {
        projects: {
            enabled: {{ nodered_enable_projects | default('true') }}
        }
    }
};
