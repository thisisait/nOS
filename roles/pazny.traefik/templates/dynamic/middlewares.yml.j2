# {{ ansible_managed }}
# Traefik FILE-PROVIDER middlewares — Authentik forward-auth + security headers.
# Equivalent of the legacy nginx authentik-proxy-locations.conf snippet.

http:
  middlewares:
    # ── Authentik forward-auth ────────────────────────────────────────────
    # A19 (2026-05-23): the embedded outpost runs INSIDE the authentik-server
    # container (internal :9000). Traefik reaches it DIRECTLY on shared_net —
    # the old `nos-host:9003` host-gateway path 502'd after Docker Desktop made
    # host-gateway IPv6-only-resolvable, which would have failed forward-auth
    # for EVERY proxy-gated service. Fail-closed posture (PENTEST-002) preserved.
    authentik:
      forwardAuth:
        address: "http://authentik-server:9000/outpost.goauthentik.io/auth/traefik"
        trustForwardHeader: true
        authResponseHeaders:
          - X-authentik-username
          - X-authentik-uid
          - X-authentik-email
          - X-authentik-name
          - X-authentik-groups
          - X-authentik-meta-app
          - X-authentik-meta-jwks
          - X-authentik-meta-outpost
          - X-authentik-meta-provider
          - X-authentik-meta-version

    # ── Security baseline (HSTS, sniff, frame, referrer) ──────────────────
    security-headers:
      headers:
        stsSeconds: 31536000
        stsIncludeSubdomains: true
        stsPreload: false
        contentTypeNosniff: true
        browserXssFilter: true
        referrerPolicy: "same-origin"
        frameDeny: false   # apps that legitimately frame each other (Outline embeds, OnlyOffice) need iframe support

    # ── HTTPS redirect (already global at entry-point level; kept here for explicit per-router opt-in) ─
    https-redirect:
      redirectScheme:
        scheme: https
        permanent: true

    # ── Document-server no-cache (OnlyOffice / euro-office) ────────────────
    # OnlyOffice `/cache/*` URLs are dynamic, secure_link-signed and session-
    # specific, but the docserver's baked nginx sets NO Cache-Control on them —
    # so an edge (CloudFlare) default-caches them (cf-cache-status HIT,
    # max-age=14400). A request racing the docserver's conversion then caches an
    # EMPTY response and every later open serves 0 bytes → "Download failed".
    # A live-collaboration editor must never be edge-cached. Force no-store on
    # every docserver response, so caching is inert even when proxied (2026-07-16).
    docserver-nocache:
      headers:
        customResponseHeaders:
          Cache-Control: "no-store, no-cache, must-revalidate, max-age=0"
          Pragma: "no-cache"

    # ── Compression ───────────────────────────────────────────────────────
    compress:
      compress: {}

    # ── SEC-6 (2026-05-23): Wing edge-trust signature ─────────────────────
    # Wing's BasePresenter::startup() rejects requests that DON'T carry
    # X-Wing-Edge-Token matching its WING_EDGE_TOKEN env. Without this
    # middleware on the wing router, every legitimate browser request
    # would 403 — apply this middleware in services.yml's wing router.
    #
    # Defense-in-depth: customRequestHeaders REPLACES any client-sent
    # header with the same name, so a malicious client can't pre-poison
    # X-Wing-Edge-Token and hope Traefik forwards it. The 127.0.0.1
    # Caddyfile bind (Wing.Caddyfile.j2 SEC-6) is the first defense —
    # only Traefik can reach the listener. This middleware is the
    # second — direct loopback requests (any process bypassing Traefik)
    # arrive without the header and are refused at PHP layer.
    wing-edge:
      headers:
        customRequestHeaders:
          X-Wing-Edge-Token: "{{ wing_edge_token | default('') }}"

    # ── nOS face edge-trust signature (SEC-6 analog) ──────────────────────
    # face's BFF (src/hooks.server.ts) believes the Authentik X-Authentik-*
    # identity headers ONLY when the request carries X-Face-Edge-Token
    # matching its FACE_EDGE_TOKEN env. customRequestHeaders REPLACES any
    # client-sent value, so a peer on gated_net cannot pre-poison it — only
    # Traefik (which holds the token) can present it. Applied on the face
    # router in services.yml.j2.
    face-edge:
      headers:
        customRequestHeaders:
          X-Face-Edge-Token: "{{ face_edge_token | default('') }}"

{% if (sso_autologin_miniflux | default(sso_autologin_min_tier_3 | default(sso_autologin | default(false)))) | bool %}
    # ── SSO autologin force-OIDC: Miniflux /login → OIDC ──────────────────
    # sso-autologin-plan.md Batch 3 (partial). DISABLE_LOCAL_AUTH=1 (set in
    # miniflux-base.compose.yml.j2 on the SAME gate) hides the form but does
    # NOT auto-redirect — Miniflux renders only the "Sign in with OIDC" link.
    # This middleware supplies the missing auto-redirect: GET /login (the
    # form page) → /oauth2/oidc/redirect (Miniflux's canonical OAuth2-start
    # path `GET /oauth2/{provider}/redirect`, provider=oidc), which 302s on
    # to Authentik. Applied to the miniflux router in services.yml.j2 — ONLY
    # when this same gate is on; when OFF the middleware is absent and the
    # route is untouched. Break-glass: unset DISABLE_LOCAL_AUTH + recreate.
    miniflux-autologin:
      redirectRegex:
        regex: "^https?://([^/]+)/login/?(\\?.*)?$"
        replacement: "https://${1}/oauth2/oidc/redirect"
        permanent: false
{% endif %}

  # ── Servers transports ────────────────────────────────────────────────
  serversTransports:
    # Skip cert verify for upstream HTTPS — used when reaching Authentik,
    # code-server (linuxserver image self-signs internal cert), or other
    # services that present a self-signed dev cert. Tier-1 routers
    # default to HTTP upstream so this is rarely needed; available as
    # opt-in via `serversTransport: "noverify@file"` in services.yml.j2.
    # NB: name MUST be `noverify` to match services.yml.j2 references —
    # mismatch leaves dependent routers in `status: disabled` with a
    # `servers transport not found noverify@file` error.
    noverify:
      insecureSkipVerify: true

# ── TLS options ─────────────────────────────────────────────────────────
tls:
  options:
    modern:
      minVersion: "VersionTLS13"
      sniStrict: false
    default:
      minVersion: "VersionTLS12"
      cipherSuites:
        - "TLS_AES_128_GCM_SHA256"
        - "TLS_AES_256_GCM_SHA384"
        - "TLS_CHACHA20_POLY1305_SHA256"
        - "TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256"
        - "TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256"
        - "TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305"
        - "TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305"
