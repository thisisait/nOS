# {{ ansible_managed }}
# Traefik FILE-PROVIDER routers + services — Tier-1 catalog.
# Auto-derived from state/manifest.yml: every service entry that has both
# `domain_var` and `port_var` AND whose `install_flag` is currently true.
#
# Upstream routing (A19, 2026-05-23 — was uniformly nos-host):
#   • containerized services (traefik_container_upstreams) → the container
#     DIRECTLY on shared_net, `<compose-alias>:<internal-port>`. The old
#     `nos-host:<host-port>` model broke when Docker Desktop started resolving
#     host-gateway to an unreachable IPv6 addr, and the IPv4 host-gateway can't
#     reach Docker-published loopback ports either.
#   • host daemons (wing/openclaw/hermes) → traefik_host_gateway_ip (IPv4),
#     which DOES reach host-process loopback ports.
#
# Auth middleware comes from traefik_auth_modes in vars/main.yml:
#   none/oidc → no auth middleware (service handles its own auth)
#   proxy     → authentik@file + security-headers@file (forward-auth, fail-closed)
#
# Special cases:
#   - wing                   — FPM, can't speak HTTP. Routes to its
#                              wing-nginx:80 sidecar via Docker DNS.
#   - traefik_https_upstream_ids — services that publish HTTPS (e.g. code_server
#                              binds 8443/tcp inside container). Upstream
#                              uses https:// + serversTransport noverify.
#   - traefik_extra_routers  — manually-added routes that don't follow the
#                              manifest auto-derivation (e.g. Traefik dashboard).
#
# Anti-loop guard: if a port_var resolves to 80 or 443, skip the router —
# those are Traefik's own entry points, routing back into them would loop
# forever and Traefik would return 404 to the original request.

{# Every websecure router gets an `-origin` twin on websecure-origin when
   traefik_origin_pull_enabled: same rule, service and middlewares, but
   tls.options origin-pull@file. Off = one door, byte-identical render. #}
{% set _doors = [('', 'websecure', {})] + ([('-origin', 'websecure-origin', {'options': 'origin-pull@file'})] if traefik_origin_pull_enabled | default(false) | bool else []) %}
http:
  routers:
{% for s in nos_manifest.services | default([]) %}
{% if s.domain_var is defined and (s.port_var is defined or s.id == 'wing') and s.id not in (traefik_skip_ids | default([])) %}
{% set _flag_value = lookup('vars', s.install_flag, default=false) %}
{% if _flag_value is string %}
{%   set _enabled = (_flag_value | lower) in ['true', '1', 'yes'] %}
{% else %}
{%   set _enabled = _flag_value | bool %}
{% endif %}
{% if _enabled %}
{% if s.id == 'wing' %}{% set _port = 80 %}{% else %}{% set _port = lookup('vars', s.port_var, default=0) | int %}{% endif %}
{# Anti-loop guard: 80 / 443 are Traefik's own entry points #}
{% if _port in [80, 443] and s.id != 'wing' %}
    # WARNING: skipping {{ s.id }} — port_var={{ s.port_var }} resolved to {{ _port }}
    # which would loop into Traefik itself. Define {{ s.port_var }} explicitly
    # in default.config.yml.
{% else %}
{# Tier-1 Host fallback — when a service in state/manifest.yml has no
   matching <svc>_domain var, build the FQDN from the new Track-F segments
   so host_alias slot is honoured for auto-routed services. #}
{% set _host = lookup('vars', s.domain_var, default=(s.id | replace('_', '-')) ~ (_host_alias_seg | default('')) ~ '.' ~ tenant_domain) %}
{% set _auth = traefik_auth_modes.get(s.id, 'proxy') %}
{% set _router = s.id | replace('_', '-') %}
{# SEC-6 (2026-05-23): wing router gets the wing-edge@file middleware
   that injects X-Wing-Edge-Token. Wing's BasePresenter rejects requests
   without it (closing the direct-loopback bypass class). #}
{% set _extra_mw = ['wing-edge@file'] if s.id == 'wing' else [] %}
{# nOS face: same edge-trust pattern — inject X-Face-Edge-Token so the BFF
   trusts the Authentik identity headers only for edge-transited requests. #}
{% if s.id == 'face' %}{% set _extra_mw = _extra_mw + ['face-edge@file'] %}{% endif %}
{# SEC-02: keap router gets keap-proxy@file, injecting x-keap-proxy-secret at
   the SAME hop as authentik@file's X-Authentik-* — KEAP checks it before
   trusting the identity headers (peer-forgery fix). #}
{% if s.id == 'keap' %}{% set _extra_mw = _extra_mw + ['keap-proxy@file'] %}{% endif %}
{# SSO autologin (sso-autologin-plan.md Batch 3): Miniflux has no upstream
   auto-redirect, so when its autologin gate is on we attach the
   miniflux-autologin@file redirect middleware (defined in middlewares.yml.j2
   under the SAME gate) that 302s /login → /oauth2/oidc/redirect. When the
   gate is off the middleware is absent and the route is untouched. #}
{% if s.id == 'miniflux' and ((sso_autologin_miniflux | default(sso_autologin_min_tier_3 | default(sso_autologin | default(false)))) | bool) %}
{% set _extra_mw = _extra_mw + ['miniflux-autologin@file'] %}
{% endif %}
{# Document server (OnlyOffice / euro-office): never edge-cache a live-collab
   editor — its secure_link-signed /cache/* URLs get CloudFlare-cached (empty
   during the conversion race → "Download failed"). Force no-store. #}
{% if s.id in ['onlyoffice', 'euro_office'] %}
{% set _extra_mw = _extra_mw + ['docserver-nocache@file'] %}
{% endif %}
{% for _sfx, _ep, _tls in _doors %}
    {{ _router }}{{ _sfx }}:
      rule: "Host(`{{ _host }}`)"
      entryPoints: ["{{ _ep }}"]
      service: "{{ _router }}"
      tls: {{ _tls | to_json }}
{% if _auth == 'proxy' %}
      middlewares: {{ (['authentik@file', 'security-headers@file', 'compress@file'] + _extra_mw) | to_json }}
{% else %}
      middlewares: {{ (['security-headers@file', 'compress@file'] + _extra_mw) | to_json }}
{% endif %}
{% endfor %}
{# ── Machine lanes ────────────────────────────────────────────────────────
   A path prefix that must reach the service WITHOUT authentik@file, because
   the caller is a machine and the gate 302s it into Authentik's HTML. Declared
   per service in `traefik_machine_lanes` (roles/pazny.traefik/vars/main.yml),
   which carries the per-entry rationale — each one is public surface, so each
   one is a decision someone wrote down. A longer rule means a higher default
   Traefik priority than the plain host router, so no explicit priority is set.

   These lanes carry NO identity middleware at all: without the outpost hop
   there are no X-Authentik-* headers to vouch for, and a backend that trusts
   those headers (SEC-02) must see this lane as anonymous, never as proxied.
   The service behind a lane therefore has to authenticate the caller ITSELF.

   Optional keys (nos-forum, 2026-10-03): `upstream: {svc, port}` sends the lane
   to a DIFFERENT container (its own `<router>-<lane>` service); `strip_prefix`
   removes the prefix before it (`<router>-<lane>-strip@file`); `allow_paths`
   narrows the lane to exact post-strip paths, so it is not a whole-API door;
   `access_log: false` drops the lane from the access log (a credential in its URL).
#}
{% for _lane in (traefik_machine_lanes | default({})).get(s.id, []) %}
{% if _lane.allow_paths is defined %}
{%   set _match = '(' ~ (_lane.allow_paths | map('regex_replace', '^(.*)$', 'Path(`' ~ _lane.prefixes[0] ~ '\\1`)') | join(' || ')) ~ ')' %}
{% else %}
{%   set _match = 'PathPrefix(' ~ (_lane.prefixes | map('regex_replace', '^(.*)$', '`\\1`') | join(', ')) ~ ')' %}
{% endif %}
{% set _lane_mw = ([_router ~ '-' ~ _lane.name ~ '-strip'] if _lane.strip_prefix | default(false) else []) + ['security-headers@file', 'compress@file'] %}
{% for _sfx, _ep, _tls in _doors %}
    {{ _router }}-{{ _lane.name }}{{ _sfx }}:
      rule: "Host(`{{ _host }}`) && {{ _match }}"
      entryPoints: ["{{ _ep }}"]
      service: "{{ (_router ~ '-' ~ _lane.name) if _lane.upstream is defined else _router }}"
      tls: {{ _tls | to_json }}
      middlewares: {{ _lane_mw | to_json }}
{% if not (_lane.access_log | default(true)) %}
      observability: {accessLogs: false}
{% endif %}
{% endfor %}
{% endfor %}
{% endif %}
{% endif %}
{% endif %}
{% endfor %}
{# ── Extra (non-manifest) routers from traefik_extra_routers var ──────── #}
{# Anti-duplicate guard: skip any extra entry whose id clashes with a       #}
{# manifest service — that would produce duplicate YAML mapping keys and   #}
{# Traefik's file provider rejects the entire file (drops to 0 routers).   #}
{% set _manifest_ids = (nos_manifest.services | default([])) | map(attribute='id') | list %}
{% for r in traefik_extra_routers | default([]) %}
{% if r.id in _manifest_ids %}
    # WARNING: skipping extra router '{{ r.id }}' — already defined as a
    # manifest entry. Remove it from traefik_extra_routers in vars/main.yml.
{% else %}
{% for _sfx, _ep, _tls in _doors %}
    {{ r.id | replace('_', '-') }}{{ _sfx }}:
      rule: "Host(`{{ r.host }}`)"
      entryPoints: ["{{ _ep }}"]
      service: "{{ r.id | replace('_', '-') }}"
      tls: {{ _tls | to_json }}
{% if r.auth | default('proxy') == 'proxy' %}
      middlewares: ["authentik@file", "security-headers@file", "compress@file"]
{% else %}
      middlewares: ["security-headers@file", "compress@file"]
{% endif %}
{% endfor %}
{% endif %}
{% endfor %}

{# ── REM-194: SSO-gated Traefik dashboard (api@internal) ─────────────────── #}
{# The dashboard/API is NO LONGER anonymous on :8080 (api.insecure:false). This #}
{# router is the ONLY way in, and it is gated by authentik@file. It is NOT the  #}
{# REM-144 shape: the upstream is the built-in api@internal service (not the    #}
{# Docker host-gateway), and `traefik` stays in traefik_skip_ids so the manifest #}
{# auto-loop emits nothing for it. Gate: test_traefik_api_not_insecure.py.       #}
{% if traefik_dashboard_route_enabled | default(true) | bool %}
{% for _sfx, _ep, _tls in _doors %}
    traefik-dashboard{{ _sfx }}:
      rule: "Host(`{{ traefik_domain }}`)"
      entryPoints: ["{{ _ep }}"]
      service: "api@internal"
      middlewares: ["authentik@file", "security-headers@file", "compress@file"]
      tls: {{ _tls | to_json }}
{% endfor %}
{% endif %}

  services:
{% for s in nos_manifest.services | default([]) %}
{% if s.domain_var is defined and s.port_var is defined and s.id not in (traefik_skip_ids | default([])) %}
{% set _flag_value = lookup('vars', s.install_flag, default=false) %}
{% if _flag_value is string %}
{%   set _enabled = (_flag_value | lower) in ['true', '1', 'yes'] %}
{% else %}
{%   set _enabled = _flag_value | bool %}
{% endif %}
{% if _enabled %}
{% set _port = lookup('vars', s.port_var, default=0) | int %}
{% if _port not in [80, 443] %}
{% set _router = s.id | replace('_', '-') %}
{% set _is_https = s.id in (traefik_https_upstream_ids | default([])) %}
{% set _scheme = 'https' if _is_https else 'http' %}
{% set _cu = (traefik_container_upstreams | default({})).get(s.id) %}
    {{ _router }}:
      loadBalancer:
        servers:
{% if _cu %}
          # A19 (2026-05-23): containerized service — reach the container
          # DIRECTLY on shared_net (compose alias : internal port). Bypasses
          # the IPv6 host-gateway that broke `nos-host` routing (502s) and the
          # fact that the IPv4 host-gateway can't reach Docker-published
          # loopback ports anyway.
          - url: "{{ _scheme }}://{{ _cu.svc | default(_router) }}:{{ _cu.port }}"
{% else %}
          # Host daemon (wing/openclaw/hermes) — served by a launchd process on
          # the host's 127.0.0.1; the IPv4 host-gateway DOES reach host-process
          # loopback (the IPv6 `nos-host` alias does not). Override the IP per
          # host via traefik_host_gateway_ip.
          - url: "{{ _scheme }}://{{ traefik_host_gateway_ip | default('192.168.65.254') }}:{{ _port }}"
{% endif %}
{% if _is_https %}
        serversTransport: "noverify@file"
{% endif %}
{% for _lane in (traefik_machine_lanes | default({})).get(s.id, []) if _lane.upstream is defined %}
    {{ _router }}-{{ _lane.name }}:
      loadBalancer:
        servers:
          - url: "http://{{ _lane.upstream.svc }}:{{ _lane.upstream.port }}"
{% endfor %}
{% endif %}
{% endif %}
{% endif %}
{% endfor %}
{# ── Extra services for traefik_extra_routers ─────────────────────────── #}
{% for r in traefik_extra_routers | default([]) %}
{% if r.id not in _manifest_ids %}
    {{ r.id | replace('_', '-') }}:
      loadBalancer:
        servers:
          - url: "{{ r.upstream }}"
{% endif %}
{% endfor %}
{# ── stripPrefix middlewares for machine lanes that declare strip_prefix ── #}
{% set _strip_lanes = [] %}
{% for _sid, _lanes in (traefik_machine_lanes | default({})).items() %}
{% for _lane in _lanes if _lane.strip_prefix | default(false) %}
{% set _ = _strip_lanes.append((_sid | replace('_', '-'), _lane)) %}
{% endfor %}
{% endfor %}
{% if _strip_lanes %}
  middlewares:
{% for _r, _lane in _strip_lanes %}
    {{ _r }}-{{ _lane.name }}-strip:
      stripPrefix:
        prefixes: {{ _lane.prefixes | to_json }}
{% endfor %}
{% endif %}
