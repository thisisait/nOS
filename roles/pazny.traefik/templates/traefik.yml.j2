# {{ ansible_managed }}
# Traefik static configuration — rendered by pazny.traefik. Edge proxy.

api:
  dashboard: true
  # REM-194 (HIGH, live-confirmed 2026-08-12): `insecure: true` served the WHOLE
  # unauthenticated API — including /api/http/middlewares, which reflects the
  # face-edge/wing-edge anti-spoof tokens verbatim — on the built-in "traefik"
  # entry point (:8080, bound 0.0.0.0 INSIDE the container). The compose host-port
  # map (127.0.0.1:{{ traefik_dashboard_port }}) constrained only HOST callers; the
  # container also sits on infra_net/shared_net/gated_net, so ~40 peer containers
  # read the tokens off `http://infra-traefik-1:8080/` anonymously and forged
  # Tier-1 identity into the Face BFF. `insecure: false` takes the API off :8080
  # entirely. The dashboard is instead reachable ONLY through the SSO-gated
  # api@internal router in dynamic/services.yml.j2 (authentik@file, websecure).
  insecure: false

global:
  checkNewVersion: false
  sendAnonymousUsage: false

entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
          permanent: true
  websecure:
    address: ":443"
    http:
      tls:
        options: "modern@file"
      # ── Path-traversal hardening (REM-LOW Traefik) ────────────────────────
      # Reject requests that contain encoded slash / backslash / null in
      # the path. Defaults are all `true` (allow) — we set them all to
      # false to defend against URL-canonicalization confusion where
      # downstream services normalize differently than Traefik's router
      # rule (e.g. an authentik@file middleware gated on `/admin/`
      # silently lets a request to `/admin%2F../foo` through).
      # https://doc.traefik.io/traefik/reference/install-configuration/entrypoints/#encodedcharacters
      encodedCharacters:
        allowEncodedSlash: false
        allowEncodedBackSlash: false
        allowEncodedNullCharacter: false
  # REM-194: a dedicated entry point that serves ONLY /ping (see `ping:` below).
  # It carries no routers (every router binds `websecure`), so a peer container
  # reaching :8080 gets the harmless 200 "OK" of /ping and a 404 on /api/*.
  # The compose host-port map (127.0.0.1:{{ traefik_dashboard_port }} → :8080)
  # and the container healthcheck both hit /ping here — unchanged.
  ping:
    address: ":8080"

providers:
  docker:
    # Tier-2 apps (apps_runner) + any future labelled containers.
    exposedByDefault: false
    network: "{{ stacks_shared_network | default('shared_net') }}"
    endpoint: "tcp://docker-socket-proxy:2375"
    watch: true
  file:
    # Tier-1 services (existing pazny.* roles) — services.yml, middlewares.yml,
    # tls.yml rendered by tasks/main.yml. Watch=true → hot-reload on change.
    directory: "/etc/traefik/conf.d"
    watch: true

log:
  level: "{{ traefik_log_level | default('INFO') }}"
  filePath: "/var/log/traefik/traefik.log"
  format: "json"

accessLog:
  filePath: "/var/log/traefik/access.log"
  format: "json"
  bufferingSize: 100

# Liveness endpoint for the docker healthcheck + host smoke probe. Pinned to the
# dedicated loopback-published `ping` entry point (:8080) — NOT the built-in API
# entry point, which no longer exists now that api.insecure is false (REM-194).
ping:
  entryPoint: "ping"
