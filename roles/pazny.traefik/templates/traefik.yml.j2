# {{ ansible_managed }}
# Traefik static configuration — rendered by pazny.traefik. Edge proxy.

api:
  dashboard: true
  # REM-194 (HIGH, live-confirmed 2026-08-12): `insecure: true` served the WHOLE
  # unauthenticated API — including /api/http/middlewares, which reflects the
  # face-edge/wing-edge anti-spoof tokens verbatim — on the built-in "traefik"
  # entry point (:8080, bound 0.0.0.0 INSIDE the container). The compose host-port
  # map (127.0.0.1:{{ traefik_dashboard_port }}) constrained only HOST callers; the
  # container also sits on infra_net/shared_net/gated_net, so ~40 peer containers
  # read the tokens off `http://infra-traefik-1:8080/` anonymously and forged
  # Tier-1 identity into the Face BFF. `insecure: false` takes the API off :8080
  # entirely. The dashboard is instead reachable ONLY through the SSO-gated
  # api@internal router in dynamic/services.yml.j2 (authentik@file, websecure).
  insecure: false

global:
  checkNewVersion: false
  sendAnonymousUsage: false

entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
          permanent: true
  websecure:
    address: ":443"
    http:
      tls:
        options: "modern@file"
      # ── Path-traversal hardening (REM-LOW Traefik) ────────────────────────
      # Reject requests that contain encoded slash / backslash / null in
      # the path. Defaults are all `true` (allow) — we set them all to
      # false to defend against URL-canonicalization confusion where
      # downstream services normalize differently than Traefik's router
      # rule (e.g. an authentik@file middleware gated on `/admin/`
      # silently lets a request to `/admin%2F../foo` through).
      # https://doc.traefik.io/traefik/reference/install-configuration/entrypoints/#encodedcharacters
      encodedCharacters:
        allowEncodedSlash: false
        allowEncodedBackSlash: false
        allowEncodedNullCharacter: false
  # REM-194: a dedicated entry point that carries no ROUTERS (every router binds
  # `websecure`), so a peer container reaching :8080 gets a 404 on /api/*. It
  # serves two built-ins: /ping (see `ping:` below) and, since 2026-08-31,
  # /metrics (see `metrics:` — the exposure that gives is weighed there).
  # The compose host-port map (127.0.0.1:{{ traefik_dashboard_port }} → :8080)
  # and the container healthcheck both hit /ping here — unchanged.
  ping:
    address: ":8080"

providers:
  docker:
    # Tier-2 apps (apps_runner) + any future labelled containers.
    exposedByDefault: false
    network: "{{ stacks_shared_network | default('shared_net') }}"
    endpoint: "tcp://docker-socket-proxy:2375"
    watch: true
  file:
    # Tier-1 services (existing pazny.* roles) — services.yml, middlewares.yml,
    # tls.yml rendered by tasks/main.yml. Watch=true → hot-reload on change.
    directory: "/etc/traefik/conf.d"
    watch: true

log:
  level: "{{ traefik_log_level | default('INFO') }}"
  format: "json"

# NO `filePath` ON EITHER LOG — measured 2026-08-31, and this is the whole reason:
# access.log had reached 5.2 GB / 4 157 848 lines across 38 days, unrotated and
# unread. Traefik has no rotation of its own, the compose `logging: max-size 20m`
# caps only the container's STDOUT (a bind-mounted file the log driver never
# sees), and nothing tailed the file — not Alloy, not a Pulse job, nothing. It
# was 5 GB of the estate's most complete request record that no reader could
# reach: wired observability that was never observed.
#
# Writing to stdout instead hands both problems to machinery already standing:
# the json-file driver rotates at 20m x 5 (100 MB ceiling, from ~140 MB/day of
# growth), and Alloy's `discovery.docker` already tails every container in the
# estate, so the lines land in Loki under the same retention as everything else.
accessLog:
  format: "json"
  bufferingSize: 100

# ── Edge tracing (2026-08-31) ────────────────────────────────────────────────
# Traefik fronts ~50 services and emitted no trace at all, so every one of them
# was invisible to Tempo and to the agents that query it through grafana-mcp.
#
# Direct to Tempo's container, NOT to Alloy: REM-107 bound Alloy's OTLP receiver
# to 127.0.0.1 on purpose, and Traefik is a container. Both sit on
# `{{ stacks_shared_network | default('shared_net') }}`, so the collector hop is
# one the estate does not need here. Alloy stays the pipeline for HOST emitters
# (the three organs), which is where the loopback bind is the right answer.
tracing:
  # Measured 1.3 req/s at the edge, so full sampling costs Tempo ~110k spans/day
  # against a 7-day block_retention. The knob is here for when a service starts
  # polling; drop it before you widen retention.
  sampleRate: {{ traefik_tracing_sample_rate | default(1.0) }}
  otlp:
    http:
      endpoint: "http://observability-tempo-1:{{ tempo_otlp_http_port | default(4328) }}/v1/traces"

# ── Edge metrics ─────────────────────────────────────────────────────────────
# Per-service request rate, latency and status breakdown for every routed
# service, which no other exporter in the estate produces.
#
# On the `ping` entry point, which means ~40 peer containers on the shared
# fabric can read it anonymously — the same exposure REM-194 had to close for
# the API. It is a deliberate and much narrower call: these series carry router
# and service NAMES and request COUNTS, no tokens and no bodies, and the names
# are already discoverable from Docker DNS by any peer that can reach this port.
# If that stops being acceptable, the fix is a separate entry point published
# only on the observability network, not an allow-list here.
metrics:
  prometheus:
    entryPoint: ping
    addRoutersLabels: true
    addServicesLabels: true

# Liveness endpoint for the docker healthcheck + host smoke probe. Pinned to the
# dedicated loopback-published `ping` entry point (:8080) — NOT the built-in API
# entry point, which no longer exists now that api.insecure is false (REM-194).
ping:
  entryPoint: "ping"
