# =============================================================================
# pazny.superset — superset_config.py (rendered by Ansible)
#
# Bind-mounted into the container at /app/pythonpath/superset_config.py.
# Superset autoloads everything in /app/pythonpath; we additionally set
# SUPERSET_CONFIG_PATH to this exact file so it always wins.
#
# Flask-AppBuilder OIDC integration (Authlib) against Authentik.
# Authentik group names are mapped to FAB roles via AUTH_ROLES_MAPPING.
# =============================================================================

import os
from flask_appbuilder.security.manager import AUTH_OAUTH

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------
SECRET_KEY = os.environ.get(
    "SUPERSET_SECRET_KEY",
    "{{ superset_secret_key }}",
)

# SQLAlchemy connection string to PostgreSQL (from infra stack)
SQLALCHEMY_DATABASE_URI = (
    "postgresql+psycopg2://"
    "{{ superset_db_user | default('superset') }}:"
    "{{ superset_db_password | default(nos_derived_secrets.superset) }}"
    "@postgresql:5432/"
    "{{ superset_db_name | default('superset') }}"
)

# Behind Nginx TLS termination
ENABLE_PROXY_FIX = True
PROXY_FIX_CONFIG = {"x_for": 1, "x_proto": 1, "x_host": 1, "x_port": 1, "x_prefix": 1}

# Allow iframe embedding from the nOS face web desktop
TALISMAN_ENABLED = False
HTTP_HEADERS = {}
WTF_CSRF_ENABLED = True
WTF_CSRF_EXEMPT_LIST = ["superset.views.core.log"]

# -----------------------------------------------------------------------------
# Authentication — native OIDC via Authentik
# -----------------------------------------------------------------------------
{# GUARDED like every sibling plugin. Unguarded until 2026-09-01: FAB served the
   OAuth provider page with no Authentik behind it, so there was NO working UI
   login — only post.yml's `provider: db` API path. Guarded, FAB falls back to
   its AUTH_DB default. A Jinja comment, not a `#` one: a `#` comment naming the
   symbol RENDERS, and defeats the gate that greps the artifact for it. #}
{% if install_authentik | default(false) | bool %}
AUTH_TYPE = AUTH_OAUTH
AUTH_USER_REGISTRATION = True
AUTH_USER_REGISTRATION_ROLE = "Gamma"
AUTH_ROLES_SYNC_AT_LOGIN = True

# Authentik group -> FAB role, derived from authentik_rbac_tiers (a LIST of
# tier dicts). The previous `.admin`/`.manager` attribute lookups were always
# Undefined on a list, so the `| default()` literals were the only thing that
# ever rendered — a renamed tier group silently never reached Superset, and
# nos-providers (tier-1 everywhere else in the estate) landed as Gamma
# (found 2026-08-18). Tier group lists are cumulative, so each group maps at
# the FIRST tier that names it: every tier-1 group -> Admin, the group tier 2
# adds -> Alpha, and so on — same derivation idiom as open-webui-base.
{% set _fab_role = {1: 'Admin', 2: 'Alpha', 3: 'Gamma', 4: 'Public'} %}
{% set _ns = namespace(seen=[]) %}
AUTH_ROLES_MAPPING = {
{% for t in authentik_rbac_tiers | sort(attribute='tier') %}
{% for g in t.groups if g not in _ns.seen %}
    "{{ g }}": ["{{ _fab_role[t.tier] }}"],
{% set _ns.seen = _ns.seen + [g] %}
{% endfor %}
{% endfor %}
}

OAUTH_PROVIDERS = [
    {
        "name": "authentik",
        "icon": "fa-key",
        "token_key": "access_token",
        "remote_app": {
            "client_id": "{{ authentik_oidc_superset_client_id }}",
            "client_secret": "{{ authentik_oidc_superset_client_secret }}",
            "client_kwargs": {"scope": "openid profile email groups"},
            "server_metadata_url": "https://{{ authentik_domain }}/application/o/superset/.well-known/openid-configuration",
            "api_base_url": "https://{{ authentik_domain }}/application/o/userinfo/",
        },
    },
]
{% endif %}

# -----------------------------------------------------------------------------
# SSO autologin (force-OIDC) — sso-autologin-plan.md Batch 2
# -----------------------------------------------------------------------------
# When sso_autologin is enabled for Superset (tier-2 chain below), skip the
# OAuth provider-selection page and auto-redirect to the single Authentik
# provider. Stays dormant behind sso_autologin=false default.
#
# VERSION-DEPENDENT (supports=partial): OAUTH_SKIP_PROVIDER_SELECTION landed
# AFTER 6.0.0 and the exact min-version is unconfirmed. The pinned image is
# apache/superset:6.0.0-dev — verify the running version honors this flag
# before enabling. On an unsupporting build the flag is simply ignored (the
# provider-selection page renders as before), so it is safe to set.
# Break-glass: set the enable chain back to false → flag becomes False and the
# provider-selection page returns (the local /login form is never hidden).
{% if (sso_autologin_superset | default(sso_autologin_min_tier_2 | default(sso_autologin | default(false)))) | bool %}
OAUTH_SKIP_PROVIDER_SELECTION = True
{% else %}
OAUTH_SKIP_PROVIDER_SELECTION = False
{% endif %}
