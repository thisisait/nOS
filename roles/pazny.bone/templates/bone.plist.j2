<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>{{ bone_launchd_label }}</string>

    <!--
        Run bone via the role-managed venv's uvicorn directly. main.app is
        the FastAPI ASGI app; uvicorn binds to the loopback. Traefik
        reaches it via host.docker.internal:{{ bone_port }} (file-provider).
    -->
    <key>ProgramArguments</key>
    <array>
        <string>{{ bone_venv }}/bin/uvicorn</string>
        <string>main:app</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>{{ bone_port }}</string>
    </array>

    <key>WorkingDirectory</key>
    <string>{{ bone_runtime_dir }}</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>{{ ansible_facts['env']['HOME'] }}</string>
        <key>PATH</key>
        {# The pyenv shim dir is here for the LOOP'S JUDGES. Measured on the
           first real turn (2026-08-03): `ansible-lint` lives only at
           ~/.pyenv/shims/ansible-lint, launchd hands the daemon a bare PATH,
           and the judge was therefore SKIPPED — correctly INDETERMINATE, never
           a pass, but a gate set that can never reach a verdict is not a gate.
           The shim directory is stable across interpreter versions; the
           versioned `versions/*/bin` deliberately is not listed.
           Same class as `resolve_openssl` in the backup script, which the
           estate already solved once for exactly this reason.

           ORDER IS LOAD-BEARING, and venv-first was measured wrong (2026-08-03,
           the second real turn): with the daemon's venv bin FIRST, the judges'
           committed `python3 -m pytest` resolved to {{ bone_venv }}/bin/python3
           — which has no pytest ("No module named pytest") — so gate sets
           `repo` and `full` could never reach a verdict. The venv bin stays
           LAST, only for the daemon's own tooling; judges.judge_spawn_env
           additionally filters it out engine-side, so the engine does not
           depend on this ordering. #}
        <string>{{ ansible_facts['env']['HOME'] }}/.pyenv/shims:{{ homebrew_prefix | default('/opt/homebrew') }}/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:{{ bone_venv }}/bin</string>

        <!-- Bone-specific config (matches container env from Track A) -->
        {# SEC L-BONE2 (2026-05-24): BONE_SECRET (legacy API-key channel) is
           retired (auth.py decision O4) — no live read. Dropped to stop
           exposing a dead secret in the launchd env. #}
        <key>WING_EVENTS_HMAC_SECRET</key>
        <string>{{ wing_events_hmac_secret | default(bone_secret | default('')) }}</string>
        <key>WING_AUDIT_CHAIN_ENABLED</key>
        <string>{{ '1' if (wing_audit_chain_enabled | default(false) | bool) else '' }}</string>
        <key>INSTANCE_NAME</key>
        <string>{{ instance_name | default('nos') }}</string>
        <!-- Track F: Bone reads INSTANCE_TLD; resolved from tenant_domain -->
        <key>INSTANCE_TLD</key>
        <string>{{ tenant_domain | default('dev.local') }}</string>

        <!-- Direct host paths (formerly /playbook, /state, /registry, /wing-db mounts) -->
        <key>PLAYBOOK_DIR</key>
        <string>{{ playbook_dir }}</string>
        <key>STATE_DIR</key>
        <string>{{ bone_state_dir }}</string>
        <key>SERVICE_REGISTRY_PATH</key>
        <string>{{ bone_registry_dir }}/service-registry.json</string>
        <key>WING_DB_DIR</key>
        <string>{{ bone_wing_db_dir }}</string>
        <!-- Bone's events/main.py read WING_DB_PATH (full file path), not the
             directory. Set both so either convention resolves correctly. -->
        <key>WING_DB_PATH</key>
        <string>{{ bone_wing_db_dir }}/wing.db</string>

        <!-- nOS face VFS (vfs.py): the class-3 per-user tree lives under the
             doctrine data root; Bone reaches it host-natively. BONE_VFS_TOKEN
             is the static bearer the face BFF presents (empty ⇒ VFS 503s). -->
        <key>NOS_DATA_ROOT</key>
        <string>{{ nos_data_root }}</string>
        <key>NOS_TENANT_SLUG</key>
        <string>{{ nos_tenant_slug | default('pazny') }}</string>
        <key>BONE_VFS_TOKEN</key>
        <string>{{ face_vfs_token | default('') }}</string>

        <!-- Agentic loop (docs/idea/11-agentic-loop-contract.md). Two tokens,
             two identities: the proposer may read + propose, the evaluator may
             read + judge. Bone treats an empty OR `_pw_`-derived value as
             UNCONFIGURED and answers 503, so a half-wired host is loud rather
             than quietly open. NOS_LOOP_REPO_ROOT is PLAYBOOK_DIR above; the
             reader needs no further paths. -->
        <key>BONE_LOOP_PROPOSE_TOKEN</key>
        <string>{{ loop_propose_token | default('') }}</string>
        <key>BONE_LOOP_JUDGE_TOKEN</key>
        <string>{{ loop_judge_token | default('') }}</string>

        {% if install_authentik | default(false) %}
        <!-- Track B JWT auth: Bone validates incoming tokens against Authentik. -->
        <!-- In host mode, Bone reaches Authentik via the public Traefik path -->
        <!-- (was http://authentik-server:9000 internal compose net). -->
        <key>AUTHENTIK_OIDC_ISSUER</key>
        <string>{{ authentik_oidc_issuer | default('https://' + (authentik_domain | default('auth' ~ (_host_alias_seg | default('')) ~ '.' ~ (tenant_domain | default('dev.local')))) + '/') }}</string>
        <key>AUTHENTIK_JWKS_URL</key>
        <string>{{ bone_jwks_url | default('https://' + (authentik_domain | default('auth' ~ (_host_alias_seg | default('')) ~ '.' ~ (tenant_domain | default('dev.local')))) + '/application/o/nos-state-manager/jwks/') }}</string>
        <key>BONE_REQUIRE_JWT_AUTH</key>
        <string>1</string>
        {% else %}
        <key>BONE_REQUIRE_JWT_AUTH</key>
        <string>0</string>
        {% endif %}

        {# ── Qdrant vector-DB substrate (apps/qdrant.yml). Empty when ──────── #}
        {# install_qdrant=false; Bone's clients/qdrant_client.py treats     #}
        {# empty URL as "no vector backend, raise NotConfigured on call".  #}
        <key>QDRANT_URL</key>
        <string>{{ qdrant_url | default('http://127.0.0.1:' + (qdrant_port | default(6333) | string) if (install_qdrant | default(false)) else '') }}</string>
        <key>QDRANT_API_KEY</key>
        <string>{{ qdrant_api_key | default('') }}</string>
    </dict>

    <!-- launchd respawns on crash; ThrottleInterval prevents tight loops. -->
    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <!-- Raise the file-descriptor ceiling: the default launchd soft limit
         (~256) is too low for a FastAPI daemon that holds sqlite-WAL handles
         (each user-state connection = db + -wal + -shm) plus VFS streaming +
         keep-alive sockets. Under the face desktop's polling this creeps to the
         cap and every request then fails with OSError [Errno 24] Too many open
         files (surfaced as a 500 in the Files app). 8192 is generous headroom. -->
    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>8192</integer>
    </dict>
    <key>HardResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>8192</integer>
    </dict>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>{{ bone_log_dir }}/launchd.out.log</string>

    <key>StandardErrorPath</key>
    <string>{{ bone_log_dir }}/launchd.err.log</string>
</dict>
</plist>
