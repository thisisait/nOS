# {{ ansible_managed }} — roles/pazny.landing
server {
    listen 80;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;
    index index.html;
    add_header Cache-Control "no-cache";
    location / {
        try_files $uri $uri/ =404;
    }
    location = /nos-root-ca.crt { default_type application/x-x509-ca-cert; }
    location = /hosts.txt { default_type text/plain; }
}
