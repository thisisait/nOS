# =============================================================================
# pazny.wordpress — compose override fragment
# Merged into `docker compose -p iiab up` by tasks/stacks/stack-up.yml via
# ansible.builtin.find over {{ stacks_dir }}/iiab/overrides/*.yml.
# =============================================================================

services:
  wordpress:
    image: wordpress:{{ wordpress_version }}
    restart: unless-stopped
    ports:
      - "127.0.0.1:{{ wordpress_port | default(8084) }}:80"
    volumes:
      - {{ wordpress_dir }}:/var/www/html
      # mu-plugins mounted as a DIRECTORY, not individual files: on a fresh
      # blank wp-content/mu-plugins does not exist yet, and Docker cannot
      # create single-FILE bind-mountpoints inside an external/virtiofs volume
      # (wordpress_dir on /Volumes/...) — it fails hard with "mountpoint ... is
      # outside of rootfs" and the whole iiab stack-up dies. A directory mount
      # creates one mountpoint cleanly. The staging dir holds whatever the role
      # staged (oidc-bootstrap always; devlog-app-passwords + rbac-role-sync
      # conditionally) — WP loads every .php in it. WP core ships no mu-plugins,
      # so the read-only mount shadows nothing on first-boot install.
      - {{ stacks_dir }}/iiab/wordpress/mu-plugins:/var/www/html/wp-content/mu-plugins:ro
    environment:
      WORDPRESS_DB_HOST: "{% if install_mariadb | default(false) %}mariadb{% else %}{{ wordpress_db_host | default('127.0.0.1') }}{% endif %}"
      WORDPRESS_DB_USER: "{{ wordpress_db_user }}"
      WORDPRESS_DB_PASSWORD: "{{ wordpress_db_password }}"
      WORDPRESS_DB_NAME: "{{ wordpress_db_name }}"
      WORDPRESS_TABLE_PREFIX: "{{ wordpress_table_prefix | default('wp_') }}"
{% if mariadb_ssl_enabled and install_mariadb %}
      # ENCRYPTION WITHOUT AUTHENTICATION, deliberately, and it is the ceiling.
      # wpdb passes MYSQL_CLIENT_FLAGS straight to mysqli_real_connect
      # (wp-includes/class-wpdb.php:1959) and never calls mysqli_ssl_set, so
      # WordPress has no way to name a CA from PHP. No CA is mounted here for
      # that reason: a file nothing reads is the defect in hidden fee 28.
      #
      # MEASURED 2026-08-23 inside the running container: the flag alone
      # negotiates TLS_AES_256_GCM_SHA384. That closes the passive read of
      # every WordPress row crossing the fabric; an active MITM is still open,
      # and the route to closing it is php.ini `mysqli.default_ca` plus
      # MYSQLI_CLIENT_SSL_VERIFY_SERVER_CERT — untested, so not shipped.
      #
      # wp-config.php:127 evals this on every request, so it applies to an
      # EXISTING install without regenerating the file.
      WORDPRESS_CONFIG_EXTRA: "define('MYSQL_CLIENT_FLAGS', MYSQLI_CLIENT_SSL);"
{% endif %}
    healthcheck:
      # WP image ships curl (wp-cli is NOT in this image — that's wordpress:cli).
      # Fresh WP `/` 302→install is <400 so `curl -f` passes once Apache serves.
      test: ["CMD-SHELL", "curl -fsS -o /dev/null http://localhost:80/ || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s
    networks:
      - iiab_net
      - {{ stacks_shared_network }}
    logging:
      driver: "json-file"
      options:
        max-size: "20m"
        max-file: "5"
    mem_limit: {{ wordpress_mem_limit | default(docker_mem_limit_standard) }}
    cpus: {{ docker_cpus_standard | default('1.0') }}
