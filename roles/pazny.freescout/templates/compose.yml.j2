# =============================================================================
# pazny.freescout — compose override fragment
# Merged into `docker compose up` in tasks/stacks/stack-up.yml via
# ansible.builtin.find over {{ stacks_dir }}/b2b/overrides/*.yml.
# =============================================================================

services:
  freescout:
    # Image moved tiredofit/freescout (EOL at 1.17.999) → nfrastack/freescout for
    # the 2.x line (REM-118: 1.17.159 bundles the vulnerable FreeScout 1.8.219;
    # 2.1.3-php8.3 bundles 1.8.226, above the CVE-2026-53595 9.4 fix at 1.8.224).
    image: nfrastack/freescout:{{ freescout_version }}
    restart: unless-stopped
    ports:
{% if services_lan_access %}
      - "{{ freescout_port }}:80"
{% else %}
      - "127.0.0.1:{{ freescout_port }}:80"
{% endif %}
    volumes:
      - {{ freescout_data_dir }}:/data
    environment:
      CONTAINER_NAME: freescout
      DB_HOST: mariadb
      DB_PORT: "3306"
      DB_NAME: "{{ freescout_db_name }}"
      DB_USER: "{{ freescout_db_user }}"
      DB_PASS: "{{ freescout_db_password }}"
      # nfrastack 2.x renamed SITE_URL → APP_URL (SITE_URL deprecated but still
      # read as a fallback). Set BOTH so the transition is clean either way.
      SITE_URL: "https://{{ freescout_domain }}"
      APP_URL: "https://{{ freescout_domain }}"
      ADMIN_EMAIL: "{{ freescout_admin_email }}"
      ADMIN_PASS: "{{ freescout_admin_password }}"
      TIMEZONE: "{{ freescout_timezone }}"
      ENABLE_SSL_PROXY: "TRUE"
{% if install_mailpit %}
      # ── SMTP relay → Mailpit (dev mail capture) ────────────────────────────
      # Mailpit lives on iiab_net only; reach it via host-gateway.
      # Switches MODE_MAIL away from the image's bundled postfix-relay default.
      MODE_MAIL: "SMTP"
      SMTP_HOST: "host.docker.internal"
      SMTP_PORT: "1025"
      SMTP_USERNAME: ""
      SMTP_PASSWORD: ""
      SMTP_ENCRYPTION: "null"
      MAIL_FROM_ADDRESS: "helpdesk@{{ tenant_domain }}"
{% endif %}
{% if install_mailpit %}
    extra_hosts:
      - "host.docker.internal:host-gateway"
{% endif %}
    healthcheck:
      # nfrastack image ships curl. Root 302→/login is <400 so `curl -f` passes.
      # Long start_period — first-boot composer + DB migrations are slow.
      test: ["CMD-SHELL", "curl -fsS -o /dev/null http://localhost:80/ || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 120s
    networks:
      - b2b_net
      - {{ stacks_shared_network }}
    logging:
      driver: "json-file"
      options:
        max-size: "20m"
        max-file: "5"
    mem_limit: {{ freescout_mem_limit | default(docker_mem_limit_light) }}
    cpus: {{ freescout_cpus | default(docker_cpus_light) }}
