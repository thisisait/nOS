# =============================================================================
# pazny.woodpecker — compose override fragment (server + agent)
# Merged do `docker compose -p devops up` v tasks/stacks/stack-up.yml pres
# ansible.builtin.find nad {{ stacks_dir }}/devops/overrides/*.yml.
#
# Obe sluzby (woodpecker-server a woodpecker-agent) jsou jeden logicky celek
# a zustavaji v jednom fragmentu — agent sam o sobe bez serveru nema smysl.
#
# Nedeklaruje top-level networks: — devops_net a {{ stacks_shared_network }}
# jsou definovane v base templates/stacks/devops/docker-compose.yml.j2.
# =============================================================================

services:
  woodpecker-server:
    image: woodpeckerci/woodpecker-server:{{ woodpecker_version }}
    restart: unless-stopped
    ports:
      - "127.0.0.1:{{ woodpecker_port | default(8060) }}:8000"
      - "127.0.0.1:{{ woodpecker_grpc_port | default(9060) }}:9000"
    volumes:
      - {{ woodpecker_data_dir }}:/var/lib/woodpecker
    environment:
      WOODPECKER_AGENT_SECRET: "{{ woodpecker_agent_secret | default(nos_derived_secrets.woodpecker) }}"
      WOODPECKER_HOST: "https://{{ woodpecker_domain | default('ci' ~ (_host_alias_seg | default('')) ~ '.' ~ (tenant_domain | default('dev.local'))) }}"
      # ── Gitea OAuth2 forge (A19, 2026-05-23) ────────────────────────────────
      # Woodpecker logs in users through Gitea. The OAuth2 application is
      # AUTOWIRED by roles/pazny.woodpecker/tasks/post-oauth.yml (idempotent
      # Gitea Admin-API create); client/secret persist to ~/.nos/secrets.yml so
      # this render picks them up on reruns. Empty on the very first render —
      # post-oauth.yml re-renders + recreates this service once it captures them.
      WOODPECKER_GITEA: "true"
      WOODPECKER_GITEA_URL: "https://{{ gitea_domain | default('git' ~ (_host_alias_seg | default('')) ~ '.' ~ (tenant_domain | default('dev.local'))) }}"
      WOODPECKER_GITEA_CLIENT: "{{ woodpecker_gitea_client | default('') }}"
      WOODPECKER_GITEA_SECRET: "{{ woodpecker_gitea_secret | default('') }}"
      WOODPECKER_OPEN: "{{ woodpecker_open_registration | default(false) | string | lower }}"
      # ── A16 (2026-05-18): pre-seeded admin bypasses OPEN=false ──────────
      # Without this, the very first OAuth2 login from Gitea fails with
      # "The registration is closed" because Woodpecker refuses to create
      # the matching local user. WOODPECKER_ADMIN lists usernames (matching
      # Gitea identity) that Woodpecker auto-creates + grants admin to,
      # regardless of OPEN. Defaults to gitea_admin_user so the first
      # operator login on a fresh install works without manual flip.
      WOODPECKER_ADMIN: "{{ woodpecker_admin | default(gitea_admin_user | default(ansible_facts['user_id'])) }}"
      WOODPECKER_REPO_OWNERS: "{{ woodpecker_repo_owners | default(gitea_admin_user | default('')) }}"
      # ── REM-002: trusted-repos / privileged-plugins hardening ───────────────
      # Empty allowlist = NO plugin can request `privileged: true` containers
      # (effectively root-on-host). Default is empty in Woodpecker v3 but
      # pinning explicitly prevents silent regression on env merge.
      WOODPECKER_PLUGINS_PRIVILEGED: "{{ woodpecker_plugins_privileged | default('') }}"
      # Forked-PR / unaffiliated-contributor public repos do NOT trigger
      # pipelines. Defends against pipeline-as-RCE from a malicious
      # `.woodpecker.yml` push.
      WOODPECKER_AUTHENTICATE_PUBLIC_REPOS: "false"
      # Prometheus metrics (Grafana observability epic). Woodpecker exposes
      # /metrics by default; setting this token gates the endpoint behind
      # `Authorization: Bearer <token>` so only the Alloy scrape (which carries
      # the matching woodpecker_prom_token) can read woodpecker_pipeline_*
      # (the source series the woodpecker_pipeline_mttr_seconds recording rule
      # derives). No separate enable flag — the token presence is the gate.
      WOODPECKER_PROMETHEUS_AUTH_TOKEN: "{{ woodpecker_prom_token | default(nos_derived_secrets.wp_prom) }}"
    networks:
      - devops_net
      - {{ stacks_shared_network }}
    logging:
      driver: "json-file"
      options:
        max-size: "20m"
        max-file: "5"
    mem_limit: {{ woodpecker_mem_limit | default(docker_mem_limit_light) }}
    cpus: {{ docker_cpus_light | default('0.5') }}

  woodpecker-agent:
    image: woodpeckerci/woodpecker-agent:{{ woodpecker_version }}
    restart: unless-stopped
    depends_on:
      - woodpecker-server
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      # ── Stable agent identity (2026-08-19) ──────────────────────────────
      # On first connect the agent registers via WOODPECKER_AGENT_SECRET and
      # the server hands back an agent ID, which the agent persists to
      # /etc/woodpecker/agent.conf. Without this mount the ID dies with the
      # container: every `compose up --force-recreate` re-registered a NEW
      # agent row and orphaned the old one (measured 2026-08-19: 4 server
      # rows, 1 running container, 3 phantom rows x capacity 4 = 12 slots
      # that do not exist). Persisting the conf makes the identity survive
      # recreate; tasks/post-agents.yml sweeps the rows already orphaned.
      - {{ woodpecker_data_dir }}/agent:/etc/woodpecker
    environment:
      WOODPECKER_SERVER: "woodpecker-server:9000"
      WOODPECKER_AGENT_SECRET: "{{ woodpecker_agent_secret | default(nos_derived_secrets.woodpecker) }}"
      # Display name. Defaults to the container hostname = the Docker ID,
      # which changes on every recreate and reads as a different machine in
      # the server UI. A declared name makes the agent list legible.
      WOODPECKER_HOSTNAME: "{{ woodpecker_agent_hostname | default('nos-woodpecker-agent') }}"
      WOODPECKER_MAX_WORKFLOWS: "{{ woodpecker_max_workflows | default(4) }}"
      WOODPECKER_BACKEND: docker
    networks:
      - devops_net
    logging:
      driver: "json-file"
      options:
        max-size: "20m"
        max-file: "5"
    mem_limit: {{ woodpecker_agent_mem_limit | default(docker_mem_limit_standard) }}
    cpus: {{ docker_cpus_standard | default('1.0') }}
