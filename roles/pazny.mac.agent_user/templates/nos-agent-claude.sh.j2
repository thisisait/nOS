#!/bin/bash
# Rendered by pazny.mac.agent_user. NOS_CLAUDE_BIN points here when agents_separate_user is on.
# The agent presents its own Wing token when it has one, never the operator's alongside.
if [ -n "${NOS_AGENT_WING_TOKEN:-}" ]; then export WING_API_TOKEN="$NOS_AGENT_WING_TOKEN"; fi
cd / && exec /usr/bin/sudo -n -u {{ agents_user }} -- {{ agents_launcher }} "$@"
