# =============================================================================
# pazny.miniflux — compose override fragment
# Merged do `docker compose -p iiab up` v tasks/stacks/stack-up.yml pres
# ansible.builtin.find nad {{ stacks_dir }}/iiab/overrides/*.yml.
# =============================================================================

services:
  miniflux:
    image: miniflux/miniflux:{{ miniflux_version | default('2.2.19') }}
    restart: unless-stopped
    ports:
{% if services_lan_access | default(false) %}
      - "{{ miniflux_port | default(3011) }}:8080"
{% else %}
      - "127.0.0.1:{{ miniflux_port | default(3011) }}:8080"
{% endif %}
    environment:
      DATABASE_URL: "postgres://{{ miniflux_db_user | default('miniflux') }}:{{ (miniflux_db_password | default(global_password_prefix + '_pw_miniflux')) | urlencode }}@postgresql:5432/{{ miniflux_db_name | default('miniflux') }}?sslmode=prefer"
      RUN_MIGRATIONS: "1"
      CREATE_ADMIN: "1"
      ADMIN_USERNAME: "admin"
      ADMIN_PASSWORD: "{{ miniflux_admin_password | default(global_password_prefix + '_pw_miniflux_admin') }}"
      BASE_URL: "https://{{ miniflux_domain | default('rss' ~ (_host_alias_seg | default('')) ~ '.' ~ (tenant_domain | default('dev.local'))) }}"
      LISTEN_ADDR: ":8080"
      LOG_LEVEL: "info"
      METRICS_COLLECTOR: "1"
      METRICS_ALLOWED_NETWORKS: "172.16.0.0/12"
{% if install_mailpit | default(false) %}
      # ── SMTP relay → Mailpit (dev mail capture) ────────────────────────────
      # Mailpit is on iiab_net — reachable by docker DNS as 'mailpit'.
      SMTP_HOST: "mailpit"
      SMTP_PORT: "1025"
      SMTP_USERNAME: ""
      SMTP_PASSWORD: ""
      SMTP_FROM: "miniflux@{{ tenant_domain | default('dev.local') }}"
{% endif %}
    healthcheck:
      # DB-AWARE ON PURPOSE. The canonical upstream probe
      # (`miniflux -healthcheck auto` → /healthcheck) answers 200 from the HTTP
      # layer alone and NEVER touches Postgres. On 2026-07-20 that let a
      # miniflux whose schema had vanished (Postgres was reinitialised at 05:25
      # while this container had been up since 22:08 the previous day, so it
      # alone missed the re-migration every restarted service got) report
      # `healthy` for 19 hours while every real request 500'd — and the STRICT
      # health-wait passed it. `/` renders a session, so it fails when the DB
      # is empty; wget exits non-zero on 5xx and is present in the image.
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8080/"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
    networks:
      - iiab_net
      - {{ stacks_shared_network }}
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    mem_limit: {{ miniflux_mem_limit | default('512m') }}
    cpus: {{ miniflux_cpus | default(docker_cpus_light | default('0.5')) }}
