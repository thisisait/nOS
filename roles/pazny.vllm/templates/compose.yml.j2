# =============================================================================
# pazny.vllm — compose override fragment (iiab stack). Rendered only once the
# pinned snapshot is complete on disk (tasks/main.yml).
# =============================================================================

services:
  vllm:
    image: {{ vllm_image }}
{% if nos_container_user | default('') | length > 0 %}
    user: "{{ nos_container_user }}"
{% endif %}
    restart: unless-stopped
    # The GPU through CDI (NVIDIA Container Toolkit): no runtime switch, no privileges.
    devices:
      - "nvidia.com/gpu=all"
    ipc: host
{% if vllm_masked_paths | default([]) | length > 0 %}
    # Paths inside the image hidden behind an empty tmpfs (vllm_masked_paths):
    # a broken optional package then fails as ImportError, which vLLM handles.
    tmpfs:
{% for p in vllm_masked_paths %}
      - "{{ p }}"
{% endfor %}
{% endif %}
    ports:
      - "127.0.0.1:{{ vllm_port }}:{{ vllm_container_port }}"
    volumes:
      - {{ vllm_data_dir }}/hf:/hf
    environment:
      HF_HOME: /hf
      # The snapshot sits at /hf/models--<org>--<name> (the fetch's cache_dir).
      # Model CONFIG is resolved through the hub cache, not --download-dir, so
      # without this the offline start looks in /hf/hub and finds nothing.
      HF_HUB_CACHE: /hf
      HOME: /tmp
      # Exactly the pinned revision, never a fetch at start.
      HF_HUB_OFFLINE: "1"
      VLLM_API_KEY: "{{ vllm_api_key }}"
    # Explicit: NGC images start a wrapper script, upstream ones `vllm serve`.
    entrypoint: ["vllm", "serve"]
    command:
      - "{{ vllm_model }}"
      - --revision
      - "{{ vllm_model_revision }}"
      - --download-dir
      - /hf
      - --served-model-name
      - "{{ vllm_served_model_name }}"
      - --host
      - 0.0.0.0
      - --port
      - "{{ vllm_container_port }}"
      - --gpu-memory-utilization
      - "{{ vllm_gpu_memory_utilization }}"
      - --max-model-len
      - "{{ vllm_max_model_len }}"
{% for a in vllm_extra_args | default([]) %}
      - "{{ a }}"
{% endfor %}
    healthcheck:
      test: ["CMD", "python3", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:{{ vllm_container_port }}/health', timeout=4)"]
      interval: 30s
      timeout: 6s
      retries: 3
      # Loading tens of GB of weights and capturing CUDA graphs takes minutes.
      start_period: {{ vllm_start_period | default('900s') }}
    networks:
      - iiab_net
      - {{ stacks_shared_network }}
    logging:
      driver: "json-file"
      options:
        max-size: "20m"
        max-file: "5"
