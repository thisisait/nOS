{# The keys nOS declares; toml_merge.py keeps every other key already in the file. #}
default_model = "{{ _oh_model }}"
chat_provider = "{{ _oh_route }}"
reasoning_provider = "{{ _oh_route }}"
agentic_provider = "{{ _oh_route }}"
coding_provider = "{{ _oh_route }}"
# Background work stays on Ollama in both modes; unset means cloud. learning_provider is retired after v0.64.10.
memory_provider = "ollama:{{ _oh_local_model }}"
embeddings_provider = "ollama:{{ openhuman_embed_model }}"
learning_provider = "ollama:{{ _oh_local_model }}"

[privacy]
# local_only refuses every cloud route, claude-code included: that mode needs standard.
mode = "{{ 'local_only' if openhuman_provider == 'ollama' else 'standard' }}"
[observability]
analytics_enabled = false
share_usage_data = false
[update]
enabled = false
rpc_mutations_enabled = false
[gitbooks]
enabled = false
[memory]
# auto_save is the schema's memory switch; [memory.conversations]/[memory.recall] are not v0.64.10 keys (dropped on save).
auto_save = false
embedding_provider = "ollama"
embedding_model = "{{ openhuman_embed_model }}"
embedding_dimensions = {{ openhuman_embed_dimensions }}
[memory_tree]
llm_extractor_model = "{{ _oh_local_model }}"
llm_summariser_model = "{{ _oh_local_model }}"
[local_ai]
runtime_enabled = true
opt_in_confirmed = true
provider = "ollama"
base_url = "http://127.0.0.1:11434"
chat_model_id = "{{ ollama_small_model }}"
embedding_model_id = "{{ openhuman_embed_model }}"
num_ctx = 8192
{% if openhuman_register_mcp | bool %}
# The static MCP set read at boot (mcp::host::static_registry). env is literal, so the RO token is read by sh at spawn.
[[mcp_client.servers]]
name = "nos-tables"
description = "nOS DataTables, read-only"
command = "/bin/sh"
args = ["-c", "KEAP_AGENT_TOKEN_RO=$({{ docker_bin }} exec {{ openhuman_keap_container }} printenv KEAP_AGENT_TOKEN_RO) KEAP_API_URL=http://127.0.0.1:{{ keap_port }} NOS_MCP_AGENT=openhuman exec /usr/bin/python3 {{ nos_main_checkout }}/tools/mcp-tables-server.py"]
{% endif %}
