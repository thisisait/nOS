{
	"name": "nos-cortex",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"description": "Cortex — the nOS reasoning organ. Verbatim port of KEAP v1.27.0's cortex-* modules (ontology typecheck, late binding, onto1 digest) as a standalone loopback daemon.",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "tsc -p tsconfig.server.json && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.js",
		"typecheck": "tsc -p tsconfig.server.json --noEmit",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"conformance": "node knowledge/onto1-conformance.mjs",
		"start": "node dist-server/index.js"
	},
	"dependencies": {
		"express": "^4.21.0",
		"libsql": "^0.5.29",
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@playwright/test": "^1.61.1",
		"@types/express": "^4.17.21",
		"@types/node": "^22.5.5",
		"esbuild": "^0.24.0",
		"tsx": "^4.19.0",
		"typescript": "^5.5.3",
		"vitest": "^4.1.9"
	}
}
