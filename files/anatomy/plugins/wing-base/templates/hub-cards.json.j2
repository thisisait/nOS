{#-
  hub-cards.json — generated by the plugin loader at post_compose (P1a, 2026-05-29).

  Source of truth: each INSTALLED peer plugin's `ui-extension.hub_card` block,
  harvested by wing-base's aggregator (`aggregates:` block_path ui-extension).
  The loader's feature-flag gate means only enabled services appear, and
  _deep_render resolves the card `url` against the live domain vars.

  Consumer: App\Model\HubCardRepository → HubPresenter renders the cards on
  /hub, RBAC-filtered so a viewer only sees cards at or below their tier.

  Card shape: { slug, title, icon, url, tier, description, health_check }.
-#}
{#- `generated_at` intentionally omitted: a volatile per-run timestamp made the
    rendered file differ every run, so post_compose reported `changed` even when
    the harvested cards were identical. Dropping it makes a steady-state re-render
    changed=0 (same fix as templates/service-registry.json.j2). Consumers read the
    field defensively (HubCardRepository: `?? null`). -#}
{%- set cards = inputs.hub_cards | default([]) -%}
{
  "cards": [
{%- set ns = namespace(first=true) %}
{%- for e in cards %}
{%-   set c = e.hub_card | default({}) %}
{%-   if c.title is defined and c.url is defined %}
{%-     if not ns.first %},{% endif %}
{%-     set ns.first = false %}
    {
      "slug": {{ (e.slug | default('unknown')) | to_json }},
      "title": {{ c.title | to_json }},
      "icon": {{ (c.icon | default('grid')) | to_json }},
      "url": {{ c.url | to_json }},
      "tier": {{ c.tier | default(3) }},
      "description": {{ (c.description | default('')) | to_json }},
      "health_check": {{ (c.health_check | default('')) | to_json }}
    }
{%-   endif %}
{%- endfor %}
  ]
}
