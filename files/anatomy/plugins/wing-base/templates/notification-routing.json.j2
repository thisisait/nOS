{#-
  notification-routing.json — generated by plugin loader at post_compose.

  Source of truth: each peer plugin's `notification:` block, harvested by
  the aggregator (see plugin.yml `aggregates:` spec).

  Consumers:
    - Bone's clients/wing.py::insert_notification — falls back to this
      routing when the emitter provides `origin_plugin` + `severity` but
      no explicit `channels:`.
    - Wing-side tooling (debug surfaces, operator audit) — flat view of
      "which plugins page on critical".

  Format: object keyed by plugin/agent slug; each value carries the
  per-severity channel arrays declared in the manifest.
-#}
{%- set entries = inputs.notification_routing | default([]) -%}
{
  "generated_at": "{{ ansible_date_time.iso8601 | default('') }}",
  "entries": {
{%- set ns = namespace(first=true) %}
{%- for e in entries %}
{%-   set key = e.plugin_name | default(e.slug) | default('unknown') %}
{%-   if not ns.first %},
{%-   endif %}
{%-   set ns.first = false %}
    "{{ key }}": {
      "on_critical": {{ (e.on_critical | default([], true)) | to_json }},
      "on_high":     {{ (e.on_high     | default([], true)) | to_json }},
      "on_medium":   {{ (e.on_medium   | default([], true)) | to_json }},
      "on_low":      {{ (e.on_low      | default([], true)) | to_json }},
      "on_info":     {{ (e.on_info     | default([], true)) | to_json }}
    }
{%- endfor %}
  }
}
