{#-
  backend-slugs.json — generated by the plugin loader at post_compose
  (phi-hub-card-icon-gap, 2026-06-14).

  Source of truth: each INSTALLED peer plugin's top-level `kind: backend`
  flag, harvested by wing-base's aggregator (`aggregates:` from consumer_kind,
  block_path `kind`). The loader's feature-flag gate means only enabled
  services appear, so a disabled backend never lands here.

  Consumer: App\Presenters\HubPresenter reads this list and suppresses the
  /hub tile for each slug (services with a domain route but no clickable
  browser-root UI — daemons / APIs / OGC endpoints; they surface via Grafana
  Explore / native clients instead). Replaces the hardcoded
  HubPresenter::BACKEND_ONLY_SLUGS allow-list. Non-plugin host services (e.g.
  nginx) have no manifest, so HubPresenter keeps a minimal hardcoded floor.

  Slugs are underscore-normalised to match the systems-table id shape
  (open_webui, bluesky_pds) so the presenter's `in_array` check matches.
-#}
{#- `generated_at` intentionally omitted so a steady-state re-render is
    changed=0 (same fix as hub-cards.json.j2 / service-registry.json.j2). -#}
{%- set entries = inputs.backend_kinds | default([]) -%}
{
  "backend_slugs": [
{%- set ns = namespace(first=true) %}
{%- for e in entries %}
{%-   if (e.kind | default('')) == 'backend' and e.slug is defined %}
{%-     if not ns.first %},{% endif %}
{%-     set ns.first = false %}
    {{ (e.slug | replace('-', '_')) | to_json }}
{%-   endif %}
{%- endfor %}
  ]
}
