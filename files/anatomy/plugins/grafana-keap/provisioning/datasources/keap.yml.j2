# ==============================================================================
# Grafana datasource — KEAP cortex store (rendered by the grafana-keap
# composition plugin). Generated by the plugin loader — manual edits are
# overwritten.
#
# Read-only direct read of keap.db, bind-mounted into the Grafana container at
# /var/lib/grafana/keap/keap.db by roles/pazny.grafana (gated on install_keap).
# Surfaces the knowledge layer — taxonomy, relations, knowledge_objects and the
# DataTables rows — next to the Wing operational store, so a dashboard can put
# "what the estate did" and "what the estate knows" on one page.
#
# TWO THINGS TO KNOW BEFORE WRITING PANELS AGAINST THIS
#
#   1. It is a libSQL store. Plain tables read normally under stock SQLite, but
#      the vector index is a virtual table backed by libsql_vector_idx(), which
#      this datasource does NOT have. A panel that touches
#      embeddings_vec_idx_shadow will error; taxonomy_nodes_ext, relations,
#      concept_relations, knowledge_objects, data_tables and table_rows are all
#      ordinary tables and are fine.
#
#   2. mode=ro is load-bearing. The KEAP container writes continuously (fs-sync,
#      embed-sync, consolidation); opening read-only keeps Grafana out of the
#      WAL writer's way, exactly as the Wing datasource does.
# ==============================================================================

apiVersion: 1

datasources:
  - name: KEAP Cortex
    type: frser-sqlite-datasource
    uid: keap_sqlite
    access: proxy
    jsonData:
      path: /var/lib/grafana/keap/keap.db
      pathOptions: "mode=ro"
    version: 1
    editable: false
