# infisical-base — compose-extension fragment.
# Rendered into {{ stacks_dir }}/infra/overrides/infisical-base.yml.
#
# SSO MODE = forward_auth (Authentik access gate), NOT native OIDC.
# CORRECTED 2026-06-02 (live-verified on v0.159.16): Infisical's org-level OIDC
# SSO is an ENTERPRISE-licensed feature — `oidc-config-service` throws "due to
# plan restriction" on a CE plan, so the OIDC_* env that used to live here was
# INERT (verified: oidc_configs table = 0 rows, /api/v1/sso/redirect/oidc = 404,
# unauthenticated GET vault.<tld> = 200 = NO gate). That left a Tier-1 vault with
# NO Authentik gate AND a false native_oidc promise. We removed the dead OIDC env
# and gate Infisical at the edge via the Traefik authentik@file forward-auth
# middleware (plugin.yml mode: forward_auth + traefik_auth_modes: infisical=proxy).
# Honest CE ceiling: Authentik gates ACCESS, then Infisical shows its OWN email +
# password form (gate-only). A working SSO button needs an Infisical Enterprise
# license; do NOT re-add OIDC_* env on CE (it does nothing and re-opens the lie).
# =============================================================================

services:
  infisical:
    environment:
      # Defensive placeholder (anatomy P0.12).
      _NOS_PLUGIN: "infisical-base"
