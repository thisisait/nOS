# ==============================================================================
# Loki configuration – local single-binary mode (Docker stack)
# ==============================================================================

auth_enabled: false

server:
  http_listen_port: 3100
  grpc_listen_port: 9096
  log_level: warn

common:
  instance_addr: 127.0.0.1
  path_prefix: /loki
  storage:
    filesystem:
      chunks_directory: /loki/chunks
      rules_directory: /loki/rules
  replication_factor: 1
  ring:
    kvstore:
      store: inmemory

# Measured 2026-10-29: a 03:01 burst left two 536 MB WAL segments; every start replayed them into
# the 1 GiB container, was OOM-killed (137) and restarted — about every 15 s from 03:40, logs lost.
# Loki's replay ceiling defaults to 4 GB; past this one it flushes and goes on. A WAL copy
# replayed in the same image and 1 GiB limit: 384MB was OOM-killed at 20 s, 64MB ready at 40 s (420 MiB).
ingester:
  wal:
    replay_memory_ceiling: {{ loki_wal_replay_ceiling | default('64MB') }}

query_range:
  results_cache:
    cache:
      embedded_cache:
        enabled: true
        max_size_mb: 100

schema_config:
  configs:
    - from: 2024-01-01
      store: tsdb
      object_store: filesystem
      schema: v13
      index:
        prefix: index_
        period: 24h

ruler:
  alertmanager_url: http://localhost:9093

limits_config:
  retention_period: {{ loki_retention | default('744h') }}
  # 16 MB/s let ~1 GB in within two minutes (10-29); a burst past this is refused (429), not stored.
  ingestion_rate_mb: 4
  ingestion_burst_size_mb: 8
  max_query_series: 10000
  max_query_lookback: 0    # 0 = unlimited
  volume_enabled: true

compactor:
  working_directory: /loki/retention
  compaction_interval: 10m
  retention_enabled: true
  retention_delete_delay: 2h
  retention_delete_worker_count: 150
  delete_request_store: filesystem

analytics:
  reporting_enabled: false
