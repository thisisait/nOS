  "description": "OpenClaw (autonomous DevOps agent) + Paperclip (multi-agent org). Most deep telemetry (tokens, latency, model usage) arrives in Wave 2 via InfluxDB poller.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "type": "text",
      "id": 1,
      "title": "AI agents \u2014 data sources",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "OpenClaw writes JSONL to `~/.openclaw/metrics.jsonl` (Alloy tails \u2192 Loki). Paperclip stats come from its PostgreSQL database. The header stat row is a **Wave 2 placeholder** \u2014 full tokens/latency metrics arrive when OpenClaw + Open WebUI push to **InfluxDB**. Wing telemetry (`callback_plugins/wing_telemetry.py`) streams agent runs to Loki today."
      }
    },
    {
      "type": "stat",
      "id": 2,
      "title": "Agent sessions last 1h",
      "description": "Count of AgentKit sessions started in the last hour (agent_sessions table, Wing SQLite).",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "wing_sqlite"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 3
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "table",
          "rawQueryText": "SELECT COUNT(*) AS actions FROM agent_sessions WHERE started_at >= datetime('now', '-1 hour')",
          "queryText": "SELECT COUNT(*) AS actions FROM agent_sessions WHERE started_at >= datetime('now', '-1 hour')",
          "timeColumns": []
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "type": "stat",
      "id": 3,
      "title": "Runs an oracle called satisfied",
      "description": "WAS `status = 'idle'`, which is 'the process ended' \u2014 18 of 55 sessions ended with no outcome at all and every one of them counted as a success. `outcome_result = 'satisfied'` is the verdict something actually wrote. Denominator is ended runs only, so a run still going does not depress it.",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "wing_sqlite"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 3
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "table",
          "rawQueryText": "SELECT ROUND(100.0 * SUM(outcome_result = 'satisfied') / NULLIF(COUNT(*), 0), 1) AS satisfied_rate FROM agent_sessions WHERE ended_at IS NOT NULL",
          "queryText": "SELECT ROUND(100.0 * SUM(outcome_result = 'satisfied') / NULLIF(COUNT(*), 0), 1) AS satisfied_rate FROM agent_sessions WHERE ended_at IS NOT NULL",
          "timeColumns": []
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 50
              },
              {
                "color": "green",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "type": "stat",
      "id": 4,
      "title": "Avg session duration",
      "description": "Average agent session wallclock (ended_at - started_at) in milliseconds, across completed sessions.",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "wing_sqlite"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 3
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "table",
          "rawQueryText": "SELECT ROUND(AVG((julianday(ended_at) - julianday(started_at)) * 86400000.0), 0) AS avg_ms FROM agent_sessions WHERE ended_at IS NOT NULL",
          "queryText": "SELECT ROUND(AVG((julianday(ended_at) - julianday(started_at)) * 86400000.0), 0) AS avg_ms FROM agent_sessions WHERE ended_at IS NOT NULL",
          "timeColumns": []
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "type": "stat",
      "id": 5,
      "title": "Tokens used (24h)",
      "description": "Sum of tokens_input + tokens_output across agent_sessions started in the last 24h.",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "wing_sqlite"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 3
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "table",
          "rawQueryText": "SELECT COALESCE(SUM(COALESCE(tokens_input, 0) + COALESCE(tokens_output, 0)), 0) AS tokens FROM agent_sessions WHERE started_at >= datetime('now', '-1 day')",
          "queryText": "SELECT COALESCE(SUM(COALESCE(tokens_input, 0) + COALESCE(tokens_output, 0)), 0) AS tokens FROM agent_sessions WHERE started_at >= datetime('now', '-1 day')",
          "timeColumns": []
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "purple",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
