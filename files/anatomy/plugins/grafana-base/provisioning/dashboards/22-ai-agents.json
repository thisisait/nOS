    {
      "type": "timeseries",
      "id": 6,
      "title": "Ansible task rate (Wing events)",
      "description": "Per-minute count of Ansible task events reaching Wing SQLite. Covers any playbook run emitting wing_telemetry callback events (gated on NOS_TELEMETRY_ENABLED=1).",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "wing_sqlite"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "time series",
          "rawQueryText": "SELECT strftime('%s', ts) * 1 AS time, type AS metric, COUNT(*) AS value FROM events WHERE type IN ('task_ok','task_changed','task_failed','task_skipped') AND ts >= datetime('now','-6 hours') GROUP BY strftime('%Y-%m-%d %H:%M', ts), type ORDER BY time ASC",
          "queryText": "SELECT strftime('%s', ts) * 1 AS time, type AS metric, COUNT(*) AS value FROM events WHERE type IN ('task_ok','task_changed','task_failed','task_skipped') AND ts >= datetime('now','-6 hours') GROUP BY strftime('%Y-%m-%d %H:%M', ts), type ORDER BY time ASC",
          "timeColumns": [
            "time"
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
