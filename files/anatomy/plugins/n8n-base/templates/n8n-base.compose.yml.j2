# =============================================================================
# n8n-base — compose-extension fragment (Track Q U5, Phase 1).
#
# Rendered into {{ stacks_dir }}/iiab/overrides/n8n-base.yml at pre_compose.
# Carries Authentik native-OIDC env vessel + mkcert CA mount conditional.
# =============================================================================

services:
  n8n:
{% if install_authentik | default(false) and (tenant_domain_is_local | default(true) | bool) %}
    # mkcert CA conditional — local TLDs only, and only when something in this
    # container has a reason to trust the estate CA. The install_authentik half
    # was missing until 2026-08-07: without it an Authentik-less local install
    # bind-mounts {{ stacks_dir }}/shared-certs/rootCA.pem, a path
    # tasks/stacks/core-up.yml writes only when `mkcert -CAROOT` returns 0.
    volumes:
      - {{ stacks_dir }}/shared-certs/rootCA.pem:/usr/local/share/ca-certificates/mkcert-ca.crt:ro
{% endif %}
    environment:
      _NOS_PLUGIN: "n8n-base"
{% if n8n_ssrf_protection | default(true) | bool %}
      # ── SSRF protection (REM-043) ──────────────────────────────────────────
      # Block the HTTP Request node + webhooks from reaching internal/private IPs
      # (n8n built-in since 2.12; default-OFF upstream). n8n's default blocked set
      # covers all RFC-1918 + loopback → every nOS peer (shared_net 172.30/16,
      # iiab_net 172.20/16 ⊂ 172.16/12, infra postgres/redis/portainer/prometheus).
      # Closes the unauth SSRF internal-net scan (REM-043), the SEC-02 amplifier.
      # Re-open specific internal targets via n8n_ssrf_allowed_hostnames.
      N8N_SSRF_PROTECTION_ENABLED: "true"
{% if (n8n_ssrf_blocked_ip_ranges | default('default')) != 'default' %}
      N8N_SSRF_BLOCKED_IP_RANGES: "{{ n8n_ssrf_blocked_ip_ranges }}"
{% endif %}
{% if (n8n_ssrf_allowed_hostnames | default('')) | length > 0 %}
      N8N_SSRF_ALLOWED_HOSTNAMES: "{{ n8n_ssrf_allowed_hostnames }}"
{% endif %}
{% if (n8n_ssrf_allowed_ip_ranges | default('')) | length > 0 %}
      N8N_SSRF_ALLOWED_IP_RANGES: "{{ n8n_ssrf_allowed_ip_ranges }}"
{% endif %}
{% endif %}
{% if install_authentik | default(false) and (tenant_domain_is_local | default(true) | bool) %}
      # Pairs with the volume above — same guard, or Node points at a path that
      # the un-rendered mount never created.
      NODE_EXTRA_CA_CERTS: "/usr/local/share/ca-certificates/mkcert-ca.crt"
{% endif %}
{% if install_authentik | default(false) %}
      # ── Authentik SSO (OIDC) ───────────────────────────────────────────────
      N8N_AUTH_OIDC_ENABLED: "true"
      N8N_AUTH_OIDC_CLIENT_ID: "nos-n8n"
      N8N_AUTH_OIDC_CLIENT_SECRET: "{{ nos_derived_secrets.oidc_n8n }}"
      N8N_AUTH_OIDC_ISSUER: "https://{{ authentik_domain | default('auth' ~ (_host_alias_seg | default('')) ~ '.' ~ (tenant_domain | default('dev.local'))) }}/application/o/n8n/"
      N8N_AUTH_OIDC_ALLOWED_GROUPS: ""
    extra_hosts:
      - "{{ authentik_domain | default('auth' ~ (_host_alias_seg | default('')) ~ '.' ~ (tenant_domain | default('dev.local'))) }}:host-gateway"
{% endif %}
