# yaml-language-server: $schema=https://goauthentik.io/blueprints/schema.json
# ── nOS OAuth2 / Proxy providers + applications ─────────────────────────
# D1.2 (2026-05-05): blueprint switched from iterating
# `authentik_oidc_apps | default([])` (central pre-Q2 list in
# default.config.yml) to `inputs.clients | default([])` — the per-plugin
# `authentik:` blocks harvested by load_plugins.run_aggregators.
#
# Loader pre-renders Jinja inside each block AND filters out plugins
# whose `requires.feature_flag` is off (D1.2.a aggregator extension),
# so the `enabled` field below already reflects the live install set.
#
# Mode/provider mapping:
#   - native_oidc / oauth2     → authentik_providers_oauth2.oauth2provider
#   - header_oidc              → proxy provider (outpost forwards
#                                  REMOTE_USER/REMOTE_EMAIL to service)
#   - forward_auth / proxy     → proxy provider (pure access gate)
#
# Both header_oidc and forward_auth render as proxy providers in
# Authentik (same protocol object); the doctrine difference lives in
# the plugin manifest (`mode:`) and informs whether the service has
# per-user state. Outpost binds to all proxy providers regardless.

version: 1
metadata:
  name: nos-oidc-apps
  labels:
    managed-by: nos
    blueprint-version: "2"

{# D1.3 (2026-05-05): merge Tier-1 plugin blocks (inputs.clients, post-Q2
   per-plugin authentik:) with Tier-2 apps_runner extras (authentik_oidc_apps
   list, runtime-built from apps/<name>.yml manifests). Same blueprint
   handles both shapes — proven by aggregator-dry-run before the cutover. #}
{# ADR-0001 Phase 1 (2026-06-11): Authentik AUTO-APPLIES every file in the
   mounted /blueprints/custom (container start + inotify) — gating the
   `ak apply_blueprint` loops alone is NOT enough. Under authentik_engine=tofu
   the providers/apps/attachments layer belongs to OpenTofu, so this template
   renders ZERO client entries (the first tofu-engine blank died on 36×
   "provider with this name already exists" at `tofu apply`). The outpost
   entry below survives, but its `providers:` key is omitted so a blueprint
   apply can never unbind tofu-attached providers — only the outpost `config:`
   (authentik_host) stays blueprint-owned. #}
{% set _tofu_owns_clients = (authentik_engine | default('blueprint')) == 'tofu' %}
{% set _all_clients = [] if _tofu_owns_clients else ((inputs.clients | default([])) + (authentik_oidc_apps | default([]))) %}

entries:
{% for c in _all_clients %}
{% if c.enabled | default(false) | bool %}
{%- set _type_legacy = c.type | default(none) -%}
{%- set _mode = c.mode | default(c.provider_type) | default('native_oidc' if _type_legacy != 'proxy' else 'forward_auth') -%}
{%- set _is_proxy = _mode in ['forward_auth', 'proxy', 'header_oidc', 'proxy_auth'] or _type_legacy == 'proxy' -%}
{%- set _name = c.name | default(c.slug | replace('-', ' ') | title) -%}
{%- set _redirects = c.redirect_uris if (c.redirect_uris is iterable and c.redirect_uris is not string) else ([c.redirect_uris] if c.redirect_uris else []) -%}
{%- set _launch = c.launch_url | default(c.external_host) | default('') -%}
{# P0-MFA: route ONLY Tier-1 providers through the dedicated MFA flow when
   enforce_mfa is on. A Tier-1 provider ALWAYS carries an explicit
   authentication_flow so flipping enforce_mfa OFF RESETS it off nos-tier1-mfa-flow
   back to the stock flow (Authentik state:present is a partial update — an OMITTED
   authentication_flow would strand the provider on the MFA flow). Non-Tier-1
   providers omit the key (null = brand default), byte-identical to today's render. #}
{%- set _tier = c.tier | default(authentik_app_tiers[c.slug] | default(3)) -%}
{%- if (enforce_mfa | default(false) | bool) and (_tier | int == 1) -%}
{%-   set _auth_flow = 'nos-tier1-mfa-flow' -%}
{%- elif (_tier | int == 1) -%}
{%-   set _auth_flow = 'default-authentication-flow' -%}
{%- else -%}
{%-   set _auth_flow = none -%}
{%- endif -%}
{# Batch 5 REVERTED (2026-06-01, live-validated failure): the custom
   nos-autologin-flow was a broken authorization flow (built without a
   provider-authorization stage) → Authentik rejected every bound client with
   "Invalid grant_type for provider" / "The request is otherwise malformed",
   breaking OIDC login for ALL autologin native_oidc services (grafana, gitlab,
   gitea, nextcloud, HA…). Confirmed in a browser test: Jellyfin (supports:no →
   default flow) worked, every nos-autologin-flow-bound client failed. The plan
   flagged this exact risk (GH #15814 implicit-consent silent-skip). So we bind
   EVERY client to the stock implicit-consent flow — service-side force-OIDC
   (Batch 1-3 env/config) still delivers autologin; we only drop the
   consent-screen-skip polish that was breaking authorization. #}
{%- set _authz_flow = 'default-provider-authorization-implicit-consent' -%}
{% if not _is_proxy %}
  # ── {{ _name }} (OAuth2 / OIDC) ──
  - model: authentik_providers_oauth2.oauth2provider
    state: present
    identifiers:
      name: "{{ _name }}"
    attrs:
      client_type: "confidential"
      client_id: "{{ c.client_id }}"
      client_secret: "{{ c.client_secret }}"
      # Authentik 2026.5.x made OAuth2Provider.grant_types an explicit ArrayField
      # that defaults to EMPTY — an unset list rejects every authorize with
      # "Invalid grant_type for provider" → "The request is otherwise malformed",
      # breaking ALL OIDC login. (Surfaced by a fresh blank under 2026.5.2;
      # older Authentik implied the grant.) Standard OIDC authorization-code +
      # refresh. See live root-cause 2026-06-01.
      grant_types:
        - "authorization_code"
        - "refresh_token"
      authorization_flow: !Find [authentik_flows.flow, [slug, {{ _authz_flow }}]]
{% if _auth_flow %}      authentication_flow: !Find [authentik_flows.flow, [slug, {{ _auth_flow }}]]
{% endif %}      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      access_code_validity: "minutes=10"
      access_token_validity: "minutes=10"
      refresh_token_validity: "days=30"
      sub_mode: "hashed_user_id"
      include_claims_in_id_token: true
      issuer_mode: "per_provider"
      redirect_uris:{% if not _redirects %} []
{% else %}

{% for r in _redirects %}
        - matching_mode: "strict"
          url: "{{ r }}"
{% endfor %}{% endif %}
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, email]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, profile]]
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, authentik Self-signed Certificate]]

  - model: authentik_core.application
    state: present
    identifiers:
      slug: "{{ c.slug }}"
    attrs:
      name: "{{ _name }}"
      meta_launch_url: "{{ _launch }}"
      provider: !Find [authentik_providers_oauth2.oauth2provider, [name, "{{ _name }}"]]
      policy_engine_mode: "any"
      open_in_new_tab: true
{% else %}
  # ── {{ _name }} ({{ _mode }} → proxy provider) ──
  - model: authentik_providers_proxy.proxyprovider
    state: present
    identifiers:
      name: "{{ _name }}"
    attrs:
      external_host: "{{ _launch }}"
      mode: "forward_single"
      internal_host_ssl_validation: false
      authorization_flow: !Find [authentik_flows.flow, [slug, {{ _authz_flow }}]]
{% if _auth_flow %}      authentication_flow: !Find [authentik_flows.flow, [slug, {{ _auth_flow }}]]
{% endif %}      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]

  - model: authentik_core.application
    state: present
    identifiers:
      slug: "{{ c.slug }}"
    attrs:
      name: "{{ _name }}"
      meta_launch_url: "{{ _launch }}"
      provider: !Find [authentik_providers_proxy.proxyprovider, [name, "{{ _name }}"]]
      policy_engine_mode: "any"
      open_in_new_tab: true
{% endif %}
{% endif %}
{% endfor %}

  # ── Embedded outpost: bind every proxy provider (forward_auth + header_oidc) ──
  - model: authentik_outposts.outpost
    state: present
    identifiers:
      managed: "goauthentik.io/outposts/embedded"
    attrs:
      name: "authentik Embedded Outpost"
      type: "proxy"
{% if not _tofu_owns_clients %}
      providers:
{% for c in _all_clients %}
{%- set _type_legacy = c.type | default(none) -%}
{%- set _mode = c.mode | default(c.provider_type) | default('native_oidc' if _type_legacy != 'proxy' else 'forward_auth') -%}
{%- set _is_proxy = _mode in ['forward_auth', 'proxy', 'header_oidc', 'proxy_auth'] or _type_legacy == 'proxy' -%}
{%- set _name = c.name | default(c.slug | replace('-', ' ') | title) -%}
{% if (c.enabled | default(false) | bool) and _is_proxy %}
        - !Find [authentik_providers_proxy.proxyprovider, [name, "{{ _name }}"]]
{% endif %}
{% endfor %}
{% endif %}
      config:
        authentik_host: "https://{{ authentik_domain | default('auth' ~ (_host_alias_seg | default('')) ~ '.' ~ (tenant_domain | default('dev.local'))) }}"
        authentik_host_browser: "https://{{ authentik_domain | default('auth' ~ (_host_alias_seg | default('')) ~ '.' ~ (tenant_domain | default('dev.local'))) }}"
        authentik_host_insecure: false
        log_level: "info"
        object_naming_template: "ak-outpost-%(name)s"
        docker_labels: null
        docker_network: null
        container_image: null
        kubernetes_replicas: 1
        kubernetes_namespace: "authentik"
