# yaml-language-server: $schema=https://goauthentik.io/blueprints/schema.json
# ── nOS P0-MFA — enforced MFA (TOTP + WebAuthn/passkey) on Tier-1 ──────────────
#
# Gated behind `enforce_mfa` (default FALSE in default.config.yml; gov-local.yml
# opts in). DEFAULT-OFF SAFETY rests SOLELY on the enforce_mfa Jinja body-wrap
# below (the `if enforce_mfa ... endif` around `entries:`): the authentik-base
# plugin lifecycle render_dir (provisioning.blueprints) renders EVERY .j2 in this
# dir UNCONDITIONALLY, so this file always lands at
# <stacks_dir>/infra/authentik/blueprints/50-mfa-policy.yaml and is auto-discovered
# by Authentik's blueprint engine. With the flag off it renders `entries: []`
# -> the blueprint IMPORTS and applies zero objects. (It used to render a bare
# `entries:`; see the else-branch at the foot of this file for why that was a failed
# import rather than the no-op this line used to claim.) DO NOT remove the
# Jinja if/endif wrap believing the render is gated elsewhere — it is NOT. Removing
# it would enforce MFA on every non-gov install.
# (NB: this header avoids literal Jinja brace-tags — Jinja parses them even inside
# YAML # comments, so a stray tag here would break the render.)
#
# WHY A DEDICATED FLOW, NOT AN OVERRIDE OF THE SHARED VALIDATE STAGE:
# default-authentication-flow's order-30 mfa-validation binding already carries
# the upstream `default-authentication-flow-authenticator-validate-optional`
# policy (failure_result:true). Stacking a Tier-1 gate onto that shared binding
# is BROKEN under any policy_engine_mode (any -> MFA runs for everyone; all ->
# Tier-1 passwordless skips MFA). So we DO NOT touch default-authentication-flow.
# Instead we build a self-contained flow `nos-tier1-mfa-flow` (ident -> password ->
# our own MFA validate stage) and route ONLY Tier-1 providers' authentication_flow
# at it (see 10-oidc-apps.yaml.j2). Non-Tier-1 providers keep the stock flow,
# byte-unchanged. Tier-1 scoping is therefore STRUCTURAL, not policy-mode-dependent.
#
# LOCKOUT AVOIDANCE: not_configured_action='configure' (NOT 'deny') + a populated
# configuration_stages -> a brand-new / un-enrolled Tier-1 user (incl. a fresh
# akadmin) is prompted to enrol a device INLINE on first login, then continues.
# Never a hard deny, never a dead end.
#
# UN-WEDGE (if a future edit ever regresses to 'deny' or you must roll back):
#   1. set enforce_mfa: false and re-run `ansible-playbook main.yml --tags authentik`
#      (file renders empty + drops out of the reapply loop; 10-oidc re-routes Tier-1
#      providers back to the stock flow). state:present does NOT delete the orphaned
#      flow object, but it sits unused once providers no longer reference it.
#   2. or reset the validate stage directly:
#      docker compose -p infra exec -T authentik-worker ak shell -c \
#        "from authentik.stages.authenticator_validate.models import AuthenticatorValidateStage as S; \
#         s=S.objects.filter(name='nos-mfa-validate').first(); \
#         (s and (setattr(s,'not_configured_action','skip'), s.save()))"
#   3. or use Authentik's built-in recovery flow / a static-token device.
#
# UPSTREAM IDENTIFIERS (stock authentik 2026.5): flow slugs
# default-authentication-identification, default-authentication-password,
# default-password-change; stage default-authentication-password
# (authentik_stages_password.passwordstage); prompt stage
# default-password-change-prompt. Re-verify on any Authentik MAJOR upgrade — a
# rename makes !Find return null and MFA silently won't enforce (worker logs it).
version: 1
metadata:
  name: nos-mfa-policy
  labels:
    managed-by: nos
    blueprint-version: "1"

{% if enforce_mfa | default(false) | bool %}
entries:
  # ── 1. TOTP setup stage (inline-configure target + self-enrol path) ───────
  - model: authentik_stages_authenticator_totp.authenticatortotpstage
    state: present
    identifiers:
      name: nos-mfa-totp-setup
    attrs:
      digits: "6"                       # Google-Authenticator compatible
      friendly_name: "TOTP authenticator"
      configure_flow: !Find [authentik_flows.flow, [slug, default-password-change]]

  # ── 2. WebAuthn / passkey setup stage ─────────────────────────────────────
  - model: authentik_stages_authenticator_webauthn.authenticatorwebauthnstage
    state: present
    identifiers:
      name: nos-mfa-webauthn-setup
    attrs:
      user_verification: required             # gov-grade user verification — KEPT strict
      resident_key_requirement: preferred     # was 'required' (discoverable-only): too strict
                                              # in practice — passkey enrollment took ~3 tries
                                              # on common authenticators. 'preferred' keeps UV
                                              # but accepts non-discoverable creds -> first-try.
      configure_flow: !Find [authentik_flows.flow, [slug, default-password-change]]

  # ── 3. Our OWN MFA validate stage (NOT the upstream shared one) ───────────
  - model: authentik_stages_authenticator_validate.authenticatorvalidatestage
    state: present
    identifiers:
      name: nos-mfa-validate
    attrs:
      not_configured_action: configure        # inline self-enrol — NEVER deny
      device_classes:
        - totp
        - webauthn
      configuration_stages:
        - !Find [authentik_stages_authenticator_totp.authenticatortotpstage, [name, nos-mfa-totp-setup]]
        - !Find [authentik_stages_authenticator_webauthn.authenticatorwebauthnstage, [name, nos-mfa-webauthn-setup]]
      webauthn_user_verification: required
      # Posture B (global MFA, remembered): re-challenge once per mfa_remember_window
      # instead of every login (was seconds=0 every-login step-up). For a strict
      # gov step-up posture, pin mfa_remember_window: "seconds=0" in gov-local.yml.
      last_auth_threshold: "{{ mfa_remember_window | default('hours=8') }}"

  # ── 3b. Tame the STOCK shared MFA-validate stage (posture B: global-but-remembered) ──
  # The stock default-authentication-flow keeps an order-30 'default-authentication-
  # mfa-validation' (not_configured_action='skip') that challenges ANY enrolled user
  # on EVERY tier — which defeats the Tier-1 scoping the instant nos-mfa-validate
  # force-enrols a device (symptom: 2FA prompt on Tier-2 twofauth / Tier-4 jellyfin).
  # We DELIBERATELY do NOT re-arm it (leave not_configured_action / device_classes to
  # upstream — that is the lockout/over-scope footgun); we ONLY widen its remember
  # window so an enrolled user re-challenges once per mfa_remember_window instead of
  # every login. THRESHOLD-ONLY by design — pinned by tests/anatomy/test_mfa_blueprint.py.
  # ROLLBACK GAP: state:present never restores the upstream seconds=0 — disabling
  # enforce_mfa later leaves this stage at the wide window. Un-wedge (reset to the
  # upstream per-login step-up):
  #   docker compose -p infra exec -T authentik-worker ak shell -c \
  #     "from authentik.stages.authenticator_validate.models import AuthenticatorValidateStage as S; \
  #      s=S.objects.filter(name='default-authentication-mfa-validation').first(); \
  #      (s and (setattr(s,'last_auth_threshold','seconds=0'), s.save()))"
  - model: authentik_stages_authenticator_validate.authenticatorvalidatestage
    state: present
    identifiers:
      name: default-authentication-mfa-validation
    attrs:
      last_auth_threshold: "{{ mfa_remember_window | default('hours=8') }}"

  # ── 4. Dedicated Tier-1 authentication flow ───────────────────────────────
  # Self-contained: identification → password → MFA validate. Tier-1 providers
  # route their authentication_flow here (10-oidc-apps.yaml.j2). Non-Tier-1
  # providers keep the stock default-authentication-flow, byte-unchanged.
  - model: authentik_flows.flow
    state: present
    identifiers:
      slug: nos-tier1-mfa-flow
    attrs:
      name: "nOS — Tier-1 privileged sign-in (MFA enforced)"
      title: "Sign in (MFA required)"
      designation: authentication
      authentication: require_unauthenticated
      compatibility_mode: false
      denied_action: message_continue
      layout: stacked
      policy_engine_mode: any

  # ── 5. Stage bindings on the dedicated flow (10/20/30) ─────────────────────
  # !Find each binding by BOTH target AND order (multi-condition Find ANDs the
  # Q objects) so it can never resolve to another flow's same-order binding.
  - model: authentik_flows.flowstagebinding
    state: present
    identifiers:
      target: !Find [authentik_flows.flow, [slug, nos-tier1-mfa-flow]]
      order: 10
    attrs:
      stage: !Find [authentik_stages_identification.identificationstage, [name, default-authentication-identification]]
      evaluate_on_plan: true
      re_evaluate_policies: false
      invalid_response_action: retry
      policy_engine_mode: any
  - model: authentik_flows.flowstagebinding
    state: present
    identifiers:
      target: !Find [authentik_flows.flow, [slug, nos-tier1-mfa-flow]]
      order: 20
    attrs:
      stage: !Find [authentik_stages_password.passwordstage, [name, default-authentication-password]]
      evaluate_on_plan: true
      re_evaluate_policies: false
      invalid_response_action: retry
      policy_engine_mode: any
  - model: authentik_flows.flowstagebinding
    state: present
    identifiers:
      target: !Find [authentik_flows.flow, [slug, nos-tier1-mfa-flow]]
      order: 30
    attrs:
      stage: !Find [authentik_stages_authenticator_validate.authenticatorvalidatestage, [name, nos-mfa-validate]]
      evaluate_on_plan: true
      re_evaluate_policies: true
      invalid_response_action: retry
      policy_engine_mode: any

  # ── 6. Password policy (zxcvbn local always-on; HIBP opt-in egress) ───────
  - model: authentik_policies_password.passwordpolicy
    state: present
    identifiers:
      name: nos-password-policy
    attrs:
      password_field: password         # MUST match the prompt-stage field_key
      length_min: {{ mfa_password_min_length | default(15) }}
      amount_uppercase: 1
      amount_lowercase: 1
      amount_digits: 1
      amount_symbols: 1
      check_static_rules: true
      check_zxcvbn: true               # local, air-gap-safe
      zxcvbn_score_threshold: 3
      check_have_i_been_pwned: {{ (mfa_password_hibp | default(false) | bool) | to_json }}
      hibp_allowed_count: 0
      error_message: "Password must be at least {{ mfa_password_min_length | default(15) }} chars with mixed case, a digit and a symbol (nOS gov policy)."

  # ── 7. NOTE — password policy is created (above) but NOT blueprint-bound ──
  # Authentik's blueprint `policybinding.target` for a PROMPT stage proved
  # fragile on the live 2026-05-31 blank+gov run (atomic-fail of the WHOLE
  # blueprint): binding the non-existent `nos-enrollment-prompts` null-targeted
  # ("field may not be null"), and binding the stock `default-password-change-
  # prompt` resolved to a raw stage pk that policybinding.target (a
  # PolicyBindingModel pbm_uuid) rejects ("does not exist"). The core gov MFA
  # control — the `nos-mfa-validate` stage + the dedicated `nos-tier1-mfa-flow`
  # — does NOT depend on the policy binding, so we keep the policy OBJECT (for a
  # manual/UI bind or a future validation_policies M2M wire) and drop the brittle
  # blueprint bindings rather than let one bad target tank all 9 entries.
{% else %}
# `[]`, NOT a bare `entries:` — measured 2026-08-31. With the flag off this used
# to render `entries:` followed by nothing, which YAML-loads as None and makes
# authentik's `Importer.from_string` raise EntryInvalidError. The instance then
# sat at status='error' indefinitely for a feature that is deliberately OFF: a
# standing red on a healthy estate, which is the thing that teaches an operator
# to stop reading a status column. The header above called it a "harmless
# no-op"; measured, it was a failed import that applied nothing and said so
# nowhere anyone looked.
entries: []
{% endif %}
