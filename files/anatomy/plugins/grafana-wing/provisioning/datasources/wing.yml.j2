# ==============================================================================
# Grafana datasource — Wing SQLite (rendered by the grafana-wing composition
# plugin). Generated by Ansible / plugin loader — manual edits will be
# overwritten.
#
# Read-only direct SQLite read of Wing's wing.db, bind-mounted into the Grafana
# container at /var/lib/grafana/wing/wing.db by roles/pazny.grafana (gated on
# install_wing). Backs the 99-playbook + 22-ai-agents dashboards (playbook
# events, migration / upgrade / coexistence history, agent-session telemetry)
# without needing a Loki pipeline. mode=ro opens the WAL-mode DB without
# contending with Bone's / Wing's writer.
#
# Uses the community plugin frser-sqlite-datasource, installed via
# GF_INSTALL_PLUGINS in files/anatomy/plugins/grafana-base/templates/
# grafana-base.compose.yml.j2 (gated on the same install_wing condition).
# ==============================================================================

apiVersion: 1

datasources:
  - name: Wing SQLite
    type: frser-sqlite-datasource
    uid: wing_sqlite
    access: proxy
    jsonData:
      path: /var/lib/grafana/wing/wing.db
      # Open read-only so we don't race with the Nette / Bone writer.
      pathOptions: "mode=ro"
    version: 1
    editable: false
