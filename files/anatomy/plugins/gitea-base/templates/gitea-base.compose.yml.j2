# =============================================================================
# gitea-base — compose-extension fragment (SSO autologin, sso-autologin-plan.md
# Batch 3 / matrix (b)).
#
# Rendered into {{ stacks_dir }}/devops/overrides/gitea-base.yml at pre_compose.
# Compose merges this additively with the role's own override fragment
# (roles/pazny.gitea/templates/compose.yml.j2 → .../overrides/gitea.yml). The
# override files load alphabetically — `gitea-base.yml` < `gitea.yml` — and the
# env keys set here (GITEA__service__ENABLE_PASSWORD_SIGNIN_FORM /
# ENABLE_BASIC_AUTHENTICATION) are NOT set by the role file, so the merge is
# purely additive (no last-writer conflict).
#
# The OIDC client itself is registered via the Gitea Admin API
# (authentik.post_setup: gitea_admin_api), NOT compose env — so this fragment
# carries ONLY the force-OIDC form-hide toggle, behind the autologin gate.
# =============================================================================

services:
  gitea:
    environment:
      _NOS_PLUGIN: "gitea-base"
      # Force basic auth ON (UNCONDITIONAL, independent of autologin): the
      # playbook's Gitea Admin API autowire (post.yml + post-repo.yml) sends
      # `Authorization: Basic <admin:pass>`. Gitea PERSISTS env-set keys into
      # app.ini and does NOT reset a key when its env var is later removed — so a
      # stale ENABLE_BASIC_AUTHENTICATION=false (from a pre-fix render) survives
      # every recreate and 401s the autowire. Setting it true EXPLICITLY forces
      # gitea to rewrite that app.ini line. Web password form is hidden
      # separately by the autologin block below; the API/git Basic path is
      # loopback :3003 and unaffected.
      GITEA__service__ENABLE_BASIC_AUTHENTICATION: "true"
{% if (sso_autologin_gitea | default(sso_autologin_min_tier_2 | default(sso_autologin | default(false)))) | bool %}
      # ── SSO autologin (force-OIDC) — sso-autologin-plan.md Batch 3 (matrix b) ─
      # When on, Gitea HIDES the local username/password sign-in form, leaving
      # only the "Sign in with Authentik" OAuth2 button (no auto-redirect —
      # supports: yes for form-hide, no for redirect). Basic auth for the API
      # stays ON (above), so the autowire is unaffected.
      #
      # CRITICAL (plan caveat): the OIDC-backed admin MUST exist before the form
      # is locked (the gitea_admin_api post_setup provisions it on converge) —
      # else the only login path is OIDC and a broken Authentik = lockout.
      #
      # BREAK-GLASS (no live UI param — form is env-hidden): set
      # sso_autologin_gitea=false (or sso_autologin=false) + re-converge
      # (`--tags gitea` recreates). See docs/break-glass-runbook.md.
      GITEA__service__ENABLE_PASSWORD_SIGNIN_FORM: "false"
{% endif %}
