<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{ifset title}{include title} | {/ifset}Wing — nOS operator console</title>
	{* W2 (2026-05-17): tokens.css loaded first — single source of truth
	   for colors, spacing, radii, fonts, plus utility classes that every
	   page can rely on. style.css + per-page CSS still load below. *}
	<link rel="stylesheet" href="/assets/tokens.css?v={$assetVer}">
	<link rel="stylesheet" href="/assets/style.css?v={$assetVer}">
</head>
<body>

<div class="header">
	<div class="header-left">
		<button type="button" class="nav-burger" id="navBurger" aria-label="Open navigation menu" aria-controls="navOverlay" aria-expanded="false">
			<span></span><span></span><span></span>
		</button>
		<div>
			<h1><a href="/" style="color:inherit">Wing</a> <span class="header-tagline" style="color:var(--text2); font-weight:400">nOS operator console</span></h1>
			<div class="subtitle">Inbox · agents · audit · security findings · platform state</div>
		</div>
	</div>
	<div class="header-right">
		<span id="headerStatus"></span>
		{if $isAuthenticated}
			<span style="color:var(--text2);font-size:12px">{$authName ?? $authUser}</span>
			<a href="https://{$authentikDomain}/application/o/wing/end-session/" style="font-size:12px;color:var(--text2);margin-left:4px">Logout</a>
		{/if}
		{* Audit-chain integrity badge — set only when WING_AUDIT_CHAIN_ENABLED=1 (gov). *}
		{if isset($auditChainVerdict)}
			{if !($auditChainVerdict['known'] ?? false)}
				<span style="background:var(--text2);color:#fff;font-size:11px;padding:1px 6px;border-radius:3px;margin-left:6px" title="audit chain not yet verified by the Pulse job">Audit chain unverified</span>
			{elseif ($auditChainVerdict['ok'] ?? false)}
				<span style="background:#0a7d33;color:#fff;font-size:11px;padding:1px 6px;border-radius:3px;margin-left:6px" title="verified {$auditChainVerdict['at'] ?? ''}">&#10003; Audit chain OK</span>
			{else}
				<span style="background:#a00;color:#fff;font-size:11px;padding:1px 6px;border-radius:3px;margin-left:6px" title="tamper detected — see verify-audit-chain.php">&#10007; Audit chain BROKEN</span>
			{/if}
		{/if}
	</div>
</div>

{* W5 (2026-05-26): nav moved from a horizontal tab bar to a burger-toggled
   fullscreen overlay (operator request). Links keep the .tab class + .tab-key
   chips so keyboard-nav.js (digit → tab) and the unread/pending counts keep
   working unchanged. Groups become labelled sections; tap targets are large
   for touch. The overlay is `hidden` by default; nav-overlay.js toggles it. *}
<nav class="nav-overlay" id="navOverlay" aria-label="Main navigation" hidden>
	<div class="nav-overlay-inner">
		<div class="nav-overlay-header">
			<span class="nav-overlay-title">Navigate <kbd>m</kbd></span>
			<button type="button" class="nav-overlay-close" id="navClose" aria-label="Close navigation menu">&times;</button>
		</div>
		<div class="nav-overlay-groups">
		<div class="nav-overlay-group">
			<h2>Operate</h2>
			<a class="tab{if $activeTab === 'hub'} active{/if}" href="/hub" data-tab="hub">Hub <span class="tab-key">1</span></a>
			{* A11 retired 2026-08-08: the Approvals tab (key 3) is gone —
			   approvals are kind='approval' questions answered on /inbox. The
			   second badge below counts OPEN QUESTIONS: a blocked run is more
			   urgent than an unread notification, so it gets its own number
			   rather than being summed away. Key 3 stays unassigned so the
			   other digits keep their muscle memory. *}
			<a class="tab{if $activeTab === 'inbox'} active{/if}" href="/inbox" data-tab="inbox">Inbox{if ($unreadInboxCount ?? 0) > 0} <span class="tab-count" aria-label="unread notifications">{$unreadInboxCount}</span>{/if}{if ($openQuestionsCount ?? 0) > 0} <span class="tab-count" aria-label="open agent questions">{$openQuestionsCount} blocking</span>{/if} <span class="tab-key">2</span></a>
			{* Ledger beside the queue: /inbox answers, /questions accounts for it. *}
			<a class="tab{if $activeTab === 'questions'} active{/if}" href="/questions" data-tab="questions">Questions</a>
		</div>

		<div class="nav-overlay-group">
			<h2>Insights</h2>
			<a class="tab{if $activeTab === 'overview'} active{/if}" href="/dashboard" data-tab="overview">Dashboard <span class="tab-key">4</span></a>
			<a class="tab{if $activeTab === 'timeline'} active{/if}" href="/timeline" data-tab="timeline">Timeline <span class="tab-key">5</span></a>
			<a class="tab{if $activeTab === 'audit'} active{/if}" href="/audit" data-tab="audit">Audit <span class="tab-key">6</span></a>
			<a class="tab{if $activeTab === 'pulse'} active{/if}" href="/pulse" data-tab="pulse">Pulse</a>
			<a class="tab{if $activeTab === 'agents'} active{/if}" href="/agents" data-tab="agents">Agents <span class="tab-key">7</span></a>
		</div>

		<div class="nav-overlay-group">
			<h2>Security</h2>
			<a class="tab{if $activeTab === 'pentest'} active{/if}" href="/pentest" data-tab="pentest">Pentest <span class="tab-key">8</span></a>
			<a class="tab{if $activeTab === 'remediation'} active{/if}" href="/remediation" data-tab="remediation">Remediation <span class="tab-key">9</span></a>
			<a class="tab{if $activeTab === 'gdpr'} active{/if}" href="/gdpr" data-tab="gdpr">GDPR</a>
			{if $isSuperAdmin}<a class="tab{if $activeTab === 'breaches'} active{/if}" href="/breaches" data-tab="breaches">Breaches</a>{/if}
		</div>

		<div class="nav-overlay-group">
			<h2>Platform</h2>
			<a class="tab{if $activeTab === 'migrations'} active{/if}" href="/migrations" data-tab="migrations">Migrations</a>
			<a class="tab{if $activeTab === 'upgrades'} active{/if}" href="/upgrades" data-tab="upgrades">Upgrades</a>
			<a class="tab{if $activeTab === 'coexistence'} active{/if}" href="/coexistence" data-tab="coexistence">Coexistence</a>
			{if $isSuperAdmin}
				<a class="tab{if $activeTab === 'users'} active{/if}" href="/users" data-tab="users">Users</a>
			{/if}
		</div>

		<div class="nav-overlay-group">
			<h2>More</h2>
			<a class="tab{if $activeTab === 'help'} active{/if}" href="/help" data-tab="help">Help <span class="tab-key">0</span></a>
			{if $isSuperAdmin}
				<a class="tab tab-admin{if $activeTab === 'admin'} active{/if}" href="/admin" data-tab="admin">Admin</a>
			{/if}
		</div>
		</div>
	</div>
</nav>

<div class="container">
	{* Flash messages — operator feedback from redirecting actions (e.g. the
	   agent operator-trigger). Nette exposes $flashes to every template. *}
	<div n:foreach="$flashes as $flash" n:class="flash, 'flash-' . $flash->type">{$flash->message}</div>
	{include content}
</div>

{* W5-fix (2026-06-10 review): cache-buster was ?v={$basePath} — basePath is
   the URL path ('' at root), so these two scripts shipped with ?v= and were
   never cache-busted (the same stale-asset class the $assetVer mechanism was
   built to prevent). Key all three on $assetVer like the stylesheets. *}
<script src="/assets/dashboard.js?v={$assetVer}"></script>
<script src="/assets/keyboard-nav.js?v={$assetVer}" defer></script>
<script src="/assets/nav-overlay.js?v={$assetVer}" defer></script>
</body>
</html>
