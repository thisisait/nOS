<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{ifset title}{include title} | {/ifset}Wing — nOS operator console</title>
	{* W2 (2026-05-17): tokens.css loaded first — single source of truth
	   for colors, spacing, radii, fonts, plus utility classes that every
	   page can rely on. style.css + per-page CSS still load below. *}
	<link rel="stylesheet" href="/assets/tokens.css?v={$basePath}">
	<link rel="stylesheet" href="/assets/style.css">
</head>
<body>

<div class="header">
	<div class="header-left">
		<div>
			<h1><a href="/" style="color:inherit">Wing</a> <span style="color:var(--text2); font-weight:400">nOS operator console</span></h1>
			<div class="subtitle">Inbox · agents · audit · security findings · platform state</div>
		</div>
	</div>
	<div class="header-right">
		<span id="headerStatus"></span>
		{if $isAuthenticated}
			<span style="color:var(--text2);font-size:12px">{$authName ?? $authUser}</span>
			<a href="https://{$authentikDomain}/application/o/wing/end-session/" style="font-size:12px;color:var(--text2);margin-left:4px">Logout</a>
		{/if}
	</div>
</div>

<div class="tabs" id="tabs">
	{* W1 Information Architecture (2026-05-17): 5 visual groups instead of
	   12-tab flat soup. Group separators are pure CSS (.tab-sep ::before
	   border-left). Numeric tab-key chips renumbered to reflect new order;
	   the chip hint will become wired keyboard nav in W4. *}

	{* Operate — daily attention surfaces *}
	<a class="tab{if $activeTab === 'hub'} active{/if}" href="/hub" data-tab="hub">Hub <span class="tab-key">1</span></a>
	<a class="tab{if $activeTab === 'inbox'} active{/if}" href="/inbox" data-tab="inbox">Inbox <span class="tab-key">2</span></a>
	<a class="tab{if $activeTab === 'approvals'} active{/if}" href="/approvals" data-tab="approvals">Approvals <span class="tab-key">3</span></a>

	{* Insights — look-back / audit trail *}
	<a class="tab tab-sep{if $activeTab === 'overview'} active{/if}" href="/dashboard" data-tab="overview">Dashboard <span class="tab-key">4</span></a>
	<a class="tab{if $activeTab === 'timeline'} active{/if}" href="/timeline" data-tab="timeline">Timeline <span class="tab-key">5</span></a>
	<a class="tab{if $activeTab === 'audit'} active{/if}" href="/audit" data-tab="audit">Audit <span class="tab-key">6</span></a>
	<a class="tab{if $activeTab === 'agents'} active{/if}" href="/agents" data-tab="agents">Agents <span class="tab-key">7</span></a>

	{* Security — findings + remediation + GDPR register *}
	<a class="tab tab-sep{if $activeTab === 'pentest'} active{/if}" href="/pentest" data-tab="pentest">Pentest <span class="tab-key">8</span></a>
	<a class="tab{if $activeTab === 'remediation'} active{/if}" href="/remediation" data-tab="remediation">Remediation <span class="tab-key">9</span></a>
	<a class="tab{if $activeTab === 'gdpr'} active{/if}" href="/gdpr" data-tab="gdpr">GDPR</a>

	{* Platform — state-change machinery (migrations, upgrades, coexistence) *}
	<a class="tab tab-sep{if $activeTab === 'migrations'} active{/if}" href="/migrations" data-tab="migrations">Migrations</a>
	<a class="tab{if $activeTab === 'upgrades'} active{/if}" href="/upgrades" data-tab="upgrades">Upgrades</a>
	<a class="tab{if $activeTab === 'coexistence'} active{/if}" href="/coexistence" data-tab="coexistence">Coexistence</a>

	{* Right-aligned: help (always visible) + admin (Tier-1 super-admin only) *}
	<a class="tab tab-right tab-sep{if $activeTab === 'help'} active{/if}" href="/help" data-tab="help">Help <span class="tab-key">0</span></a>
	{if $isSuperAdmin}
		<a class="tab tab-admin{if $activeTab === 'admin'} active{/if}" href="/admin" data-tab="admin">Admin</a>
	{/if}
</div>

<div class="container">
	{include content}
</div>

<script src="/assets/dashboard.js"></script>
</body>
</html>
