{block title}Upgrades{/block}

{block content}
<link rel="stylesheet" href="/assets/migrations.css?v={$basePath}">
<link rel="stylesheet" href="/assets/upgrades.css?v={$basePath}">
<link rel="stylesheet" href="/assets/coexistence.css?v={$basePath}">

<div class="upg-page-header">
	<div>
		<h2>Upgrades</h2>
		<div class="sub">Version matrix across services. Upstream = latest published; Latest = latest available in our pipeline; Stable = recommended; Installed = currently running.</div>
	</div>
</div>

<div class="upg-legend" role="note" aria-label="Version severity legend">
	<span class="upg-legend-item"><span class="upg-legend-swatch" style="background:rgba(63,185,80,0.14); border-color:rgba(63,185,80,0.3)"></span> Current / at target</span>
	<span class="upg-legend-item"><span class="upg-legend-swatch" style="background:rgba(91,143,217,0.14); border-color:rgba(91,143,217,0.3)"></span> Patch / minor upgrade</span>
	<span class="upg-legend-item"><span class="upg-legend-swatch" style="background:rgba(232,162,59,0.14); border-color:rgba(232,162,59,0.3)"></span> Breaking upgrade</span>
	<span class="upg-legend-item"><span class="upg-legend-swatch" style="background:rgba(224,92,92,0.14); border-color:rgba(224,92,92,0.3)"></span> Security-critical</span>
</div>

{if empty($matrix)}
	<div class="mig-empty">
		<div>No services tracked. Check <code>state/manifest.yml</code>.</div>
	</div>
{else}
<div style="overflow-x:auto">
<table class="upg-matrix" aria-label="Service upgrade matrix">
	<thead>
		<tr>
			<th scope="col">Service</th>
			<th scope="col">Installed</th>
			<th scope="col">Stable</th>
			<th scope="col">Latest</th>
			<th scope="col">Upstream</th>
			<th scope="col" class="upg-action-col">Actions</th>
		</tr>
	</thead>
	<tbody>
		{foreach $matrix as $row}
			<tr data-service="{$row['service']}">
				<td>
					<div class="upg-service-cell">
						<div>
							<div class="name">{$row['service']}</div>
							{if !empty($row['category'])}
								<div class="cat">{$row['category']}</div>
							{/if}
							{* B4c: a coexisting service renders TWICE (primary + secondary).
							   The role badge + version + a deep-link to the authoritative
							   toggle on /coexistence#<service> (no duplicated toggle here). *}
							{if !empty($row['coexist_role'])}
								<div class="upg-coexist-row">
									<span class="coex-role-badge coex-role-{$row['coexist_role'] === 'primary' ? 'primary' : 'secondary'}">{$row['coexist_role']}</span>
									{if !empty($row['coexist_tag'])}<span class="coex-track-tag">{$row['coexist_tag']}</span>{/if}
									{if !empty($row['coexist_version'])}<span class="coex-track-version">{$row['coexist_version']}</span>{/if}
									<a class="upg-coexist-link" href="/coexistence#{$row['service']}" title="Toggle primary / deactivate on /coexistence">toggle &rarr;</a>
								</div>
							{/if}
						</div>
					</div>
				</td>
				<td>
					<span class="upg-ver upg-ver-{$row['installed_class'] ?? 'unknown'}">
						{$row['installed'] ?? '—'}
					</span>
				</td>
				<td>
					<span class="upg-ver upg-ver-{$row['stable_class'] ?? 'unknown'}">
						{$row['stable'] ?? '—'}
					</span>
				</td>
				<td>
					<span class="upg-ver upg-ver-{$row['latest_class'] ?? 'unknown'}">
						{$row['latest'] ?? '—'}
					</span>
				</td>
				<td>
					<span class="upg-ver upg-ver-{$row['upstream_class'] ?? 'unknown'}">
						{$row['upstream'] ?? '—'}
					</span>
				</td>
				<td class="upg-action-col">
					{if !empty($row['planned'])}
						{* F2: the "planned" badge is a LINK to the recipe — /upgrades/<service>
						   renders the recipe cards (steps/changelog), so the operator can see
						   WHAT the queued upgrade will do. When the planned recipe id is known
						   the link deep-anchors that card (#recipe-<id>); otherwise it lands on
						   the service page. The matrix never duplicates recipe rendering — it
						   only links to the single surface that owns it. *}
						{var $plannedAnchor = !empty($row['planned_recipe_id']) ? '#recipe-' . $row['planned_recipe_id'] : ''}
						<a class="badge badge-warning upg-planned-link"
						   href="/upgrades/{$row['service']}{$plannedAnchor}"
						   title="Queued by {$row['planned_by']}{if !empty($row['planned_recipe_id'])} ({$row['planned_recipe_id']}){/if} — applies under --tags upgrade. View the recipe (what it will do).">planned{if $row['planned_target']} &rarr; {$row['planned_target']}{/if}</a>
						<a class="mig-btn upg-planned-recipe-link" href="/upgrades/{$row['service']}{$plannedAnchor}"
						   aria-label="View the planned recipe for {$row['service']}">view recipe</a>
					{elseif !empty($row['recipe_available']) && !empty($row['recipes'])}
						{var $matrixRecipeId = $row['next_recipe_id'] ?? $row['recipes'][0]['recipe_id']}
						{* B4b/F1: Plan opens the plan-choice modal. The matrix plans the
						   next applicable recipe ($next), and data-coexist-supported now
						   flows truthfully from upgrade_recipes.coexistence_supported
						   (ingested from the recipe YAML) — so option (b) is enabled for
						   coexistence-capable recipes (postgresql/grafana) and greyed out
						   (with a tooltip) otherwise, exactly as on /upgrades/<svc>. The
						   <noscript> form below is the JS-off in-place fallback. *}
						<button type="button"
								class="mig-btn"
								data-action="open-plan-choice"
								data-service="{$row['service']}"
								data-recipe-id="{$matrixRecipeId}"
								data-target="{$row['stable'] ?? $row['latest'] ?? ''}"
								data-coexist-supported="{if !empty($row['coexistence_supported'])}1{else}0{/if}"
								title="Plan {$matrixRecipeId}">Plan</button>
						<noscript>
							<form method="post" action="{plink Upgrades:planChoice, service => $row['service'], recipe => $matrixRecipeId}" style="display:inline">
								<input type="hidden" name="_csrf" value="{$csrfToken}">
								<input type="hidden" name="plan_mode" value="migration">
								<input type="hidden" name="target_version" value="{$row['stable'] ?? $row['latest'] ?? ''}">
								<button type="submit" class="mig-btn" title="Queue {$matrixRecipeId} → applied under --tags upgrade">Plan (in-place)</button>
							</form>
						</noscript>
					{/if}
					<a class="mig-btn" href="/upgrades/{$row['service']}"
					   aria-label="Open upgrades for {$row['service']}">Recipes</a>
				</td>
			</tr>
		{/foreach}
	</tbody>
</table>
</div>
{/if}

{include '@plan-choice-modal.latte'}

<script src="/assets/upgrades-plan-choice.js?v={$basePath}" defer></script>
{/block}
