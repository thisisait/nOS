{block title}{$service ?? 'Service'} — Upgrades{/block}

{block content}
<link rel="stylesheet" href="/assets/migrations.css?v={$basePath}">
<link rel="stylesheet" href="/assets/upgrades.css?v={$basePath}">
<link rel="stylesheet" href="/assets/coexistence.css?v={$basePath}">

<div style="margin-bottom:12px">
	<a href="/upgrades" style="font-size:12px;color:var(--text2)">&larr; All services</a>
</div>

{* B4c: Proposals strip — agent-authored migration drafts (migrations_authored).
   The FIRST place the local-forge MR link surfaces in the UI. The operator NEVER
   merges in Wing: Review MR → sends them to the local GitLab forge (GATE 2);
   Lineage → deep-links the authoring agent_sessions run. *}
{if !empty($drafts)}
	<div class="mig-proposed-strip">
		<h3>Proposals — agent-authored migration drafts</h3>
		{foreach $drafts as $d}
			<div class="mig-proposal-card" data-uuid="{$d['uuid']}">
				<span class="mig-review-badge review-{$d['review_status']}">{$d['review_status']}</span>
				<span class="coex-track-tag">{$d['migration_id'] ?? $d['uuid']}</span>
				<span class="mig-proposal-meta">{$d['artifact_kind']}</span>
				{if !empty($d['from_version']) || !empty($d['to_version'])}
					<span class="mig-proposal-meta">{$d['from_version'] ?? '?'} &rarr; {$d['to_version'] ?? '?'}</span>
				{/if}
				<span class="mig-proposal-meta">by {$d['author_agent']}</span>
				{if !empty($d['mr_url'])}
					<a class="mig-btn mig-mr-link" href="{$d['mr_url']}" target="_blank" rel="noopener"
					   title="Review + merge on the local forge (GATE 2 — Wing never merges)">Review MR &rarr;</a>
				{/if}
				{if !empty($d['session_uuid'])}
					<a class="mig-btn" href="/agents/{$d['author_agent']}/sessions/{$d['session_uuid']}"
					   title="Authoring run lineage">Lineage</a>
				{/if}
			</div>
		{/foreach}
	</div>
{/if}

<div class="upg-svc-hdr">
	<div>
		<h2>{$service}</h2>
		<div class="svc-meta">
			Installed: <span class="upg-ver upg-ver-{$installed_class ?? 'unknown'}">{$installed ?? '—'}</span>
			{if !empty($category)} &middot; {$category}{/if}
		</div>
	</div>
	{if !empty($docs_url)}
		<a class="docs" href="{$docs_url}" target="_blank" rel="noopener">Upstream docs &rarr;</a>
	{/if}
</div>

{if empty($recipes)}
	<div class="mig-empty">
		<div>No upgrade recipes defined for this service.</div>
		<p style="margin-top:8px;font-size:12px">Add one at <code>upgrades/{$service}.yml</code>.</p>
	</div>
{else}
	{foreach $recipes as $r}
		{* F2: id="recipe-<id>" is the deep-link target for the matrix's
		   "planned" badge (default.latte → /upgrades/<svc>#recipe-<id>), so a
		   queued upgrade's badge lands directly on the card that renders its
		   steps/changelog. The card body below is the single recipe-rendering
		   surface; the matrix only links here. *}
		<article id="recipe-{$r['id']}" class="upg-recipe" data-recipe-id="{$r['id']}">
			<div class="upg-recipe-hdr">
				<span class="sev-badge sev-{$r['severity']}">{$r['severity']}</span>
				<span class="upg-recipe-from-to">
					{$r['from_regex'] ?? $r['from'] ?? '?'}
					<span class="upg-recipe-arrow">&rarr;</span>
					{$r['to'] ?? '?'}
				</span>
				<span class="upg-recipe-id">{$r['id']}</span>
				{if !empty($r['coexistence_supported'])}
					<span class="upg-coex-tag" title="Supports running old + new side by side">Coexistence</span>
				{/if}
				{if !empty($r['applied']) && $r['applied']}
					<span class="mig-status mig-status-ok" style="margin-left:auto">applied</span>
				{/if}
			</div>
			<div class="upg-recipe-body">
				{if !empty($r['notes'])}
					<div class="notes">{$r['notes']}</div>
				{/if}
				{if !empty($r['changelog_url'])}
					<div class="changelog">
						<a href="{$r['changelog_url']}" target="_blank" rel="noopener">Changelog &rarr;</a>
					</div>
				{/if}
				<div class="upg-recipe-actions">
					{* B4b: Plan opens the plan-choice modal (migration in-place vs
					   coexist + data copy). data-coexist-supported gates option (b);
					   data-target seeds the coexistence port/version. The <noscript>
					   below is the JS-off in-place fallback (queues migration mode). *}
					<button type="button"
							class="mig-btn"
							data-action="open-plan-choice"
							data-service="{$service}"
							data-recipe-id="{$r['id']}"
							data-target="{$r['to'] ?? ''}"
							data-coexist-supported="{if !empty($r['coexistence_supported'])}1{else}0{/if}"
							data-session-risk="{if !empty($r['session_risk'])}1{else}0{/if}"
							data-reset-scope="{$r['reset_scope'] ?? 'container'}"
							data-estimated-sec="{$r['reset']['estimated_sec'] ?? ''}"
							data-affected-services="{($r['reset']['affected_services'] ?? [])|implode:', '}"
							data-affected-host-apps="{($r['reset']['affected_host_apps'] ?? [])|implode:', '}"
							data-reset-reason="{$r['reset']['reason'] ?? ''}"
							aria-label="Plan upgrade {$r['id']}">Plan</button>
					<noscript>
						<form method="post"
							  action="{plink Upgrades:planChoice, service => $service, recipe => $r['id']}"
							  style="display:inline">
							<input type="hidden" name="_csrf" value="{$csrfToken}">
							<input type="hidden" name="plan_mode" value="migration">
							<input type="hidden" name="target_version" value="{$r['to'] ?? ''}">
							<button type="submit" class="mig-btn" title="Queue in-place migration (JS off)">Plan (in-place)</button>
						</form>
					</noscript>
					<button type="button"
							class="mig-btn mig-btn-primary"
							data-action="apply-upgrade"
							data-service="{$service}"
							data-recipe-id="{$r['id']}"
							data-severity="{$r['severity']}"
							aria-label="Apply upgrade {$r['id']}">Apply</button>
					{* A3.2 (Q5): Promote to migration — fires the native AgentKit
					   migration-author. Tier-1 (inherited; presenter gates). The
					   self-contained hidden CSRF form + a JS-delegated window.confirm
					   (upgrades-plan-choice.js, case 'promote-to-migration') is the
					   lightweight supervision gate — appropriate because this is
					   NON-destructive (working-tree write + review MR, makes nothing
					   live), so a typed-PRIMARY modal would be overkill. The _csrf
					   input is the FIRST child of <form> (SEC-14 placement; keeps it
					   inside the CSRF sweep's lookahead window even though the {plink}
					   action carries a `=>` arrow). Rendered for unapplied recipes
					   (an already-applied recipe has nothing to author). *}
					{if empty($r['applied'])}
						<form method="post" style="display:inline"
							  action="{plink Upgrades:promoteToMigration, service => $service, recipe => $r['id']}">
							<input type="hidden" name="_csrf" value="{$csrfToken}">
							<button type="submit"
									class="mig-btn"
									data-action="promote-to-migration"
									data-service="{$service}"
									data-recipe-id="{$r['id']}"
									title="Author the migration record + version bump via the migration-author agent (writes a review MR; nothing goes live)"
									aria-label="Promote {$r['id']} to a migration">Promote to migration</button>
						</form>
					{/if}
					{if !empty($r['applied'])}
						<button type="button"
								class="mig-btn mig-btn-danger"
								data-action="rollback-upgrade"
								data-service="{$service}"
								data-recipe-id="{$r['id']}"
								aria-label="Rollback upgrade {$r['id']}">Rollback</button>
					{/if}
				</div>
			</div>
		</article>
	{/foreach}
{/if}

{include '@plan-choice-modal.latte'}

<script src="/assets/migrations.js?v={$basePath}" defer></script>
<script src="/assets/upgrades-plan-choice.js?v={$basePath}" defer></script>
{/block}
