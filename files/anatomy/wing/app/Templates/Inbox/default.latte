{block title}Inbox{/block}

{block content}
<h2 style="margin-bottom: 4px; font-size: 18px;">
	Inbox
	{if $unreadCount > 0}
		<span class="badge badge-critical" style="font-size:13px; margin-left:8px;">{$unreadCount} unread</span>
	{/if}
	{if $findingCount > 0}
		<span class="badge badge-warning" style="font-size:13px; margin-left:8px;">{$findingCount} findings</span>
	{/if}
	{if count($questions) > 0}
		<span class="badge badge-critical" style="font-size:13px; margin-left:8px;">{count($questions)} blocking</span>
	{/if}
</h2>
<div style="color:var(--text2); font-size:13px; margin-bottom:20px;">
	Agent questions + operator-attention notifications + unresolved secret findings + conductor agent runs.
</div>

{* ── Agent questions (agents-inbox, 2026-08-08) ──────────────────────────────
   FIRST on the page because a run is STOPPED until one of these is answered,
   and a question with a deadline will decide for itself if nobody arrives.

   Absence is rendered explicitly. An empty section that simply disappears reads
   as "nothing to do" and is indistinguishable from a broken query — this page
   already learned that lesson elsewhere in the estate. *}
<h3 style="font-size:15px; margin-bottom:10px;">Agent questions</h3>
{if count($questions) === 0}
	<div style="color:var(--text2); font-size:13px; margin-bottom:20px;">
		No agent is waiting on an answer.
	</div>
{else}
	<table style="margin-bottom:24px;">
		<thead>
			<tr>
				<th>Agent</th><th>Question</th><th>Kind</th><th>Asked</th><th>Deadline</th><th>Answer</th>
			</tr>
		</thead>
		<tbody>
			{foreach $questions as $q}
				<tr>
					<td style="font-size:12px;">{$q['agent_name']}</td>
					<td>
						<div style="max-width:520px;">{$q['prompt']}</div>
						{if !empty($q['default_on_expiry'])}
							<div style="font-size:11px; color:var(--text2); margin-top:2px;">
								if nobody answers: {$q['default_on_expiry']}
							</div>
						{/if}
					</td>
					<td style="font-size:11px; color:var(--text2)">{$q['kind']}</td>
					<td style="font-size:11px; color:var(--text2)">{($q['created_at'] ?? '')|substr:0,19}</td>
					<td style="font-size:11px; color:var(--text2)">
						{if !empty($q['expires_at'])}{$q['expires_at']|substr:0,19}{else}—{/if}
					</td>
					<td>
						<form method="post" action="{plink Inbox:answer, uuid => $q['uuid']}" style="display:inline;">
							<input type="hidden" name="_csrf" value="{$csrfToken}">{* SEC-14 CSRF *}
							{if $q['kind'] === 'approval'}
								<button type="submit" name="answer" value="approve" class="btn btn-small">Approve</button>
								<button type="submit" name="answer" value="reject" class="btn btn-small">Reject</button>
							{elseif $q['kind'] === 'choice' && !empty($q['options_json'])}
								{foreach json_decode($q['options_json'], true) ?? [] as $opt}
									<button type="submit" name="answer" value="{$opt}" class="btn btn-small">{$opt}</button>
								{/foreach}
							{else}
								<input type="text" name="answer" placeholder="answer…" style="width:160px;">
								<button type="submit" class="btn btn-small">Send</button>
							{/if}
						</form>
					</td>
				</tr>
			{/foreach}
		</tbody>
	</table>
{/if}

{* ── Notifications (A9 — operator-attention fanout, 2026-05-16) ─────────── *}
<h3 style="font-size:15px; margin-bottom:10px;">Notifications</h3>

<div class="filter-bar" style="margin-bottom:10px;">
	<a class="filter-btn {if !$severityFilter}active{/if}" href="{plink Inbox:default, severity => null, unreadOnly => $unreadOnly}">All</a>
	<a class="filter-btn {if $severityFilter === 'critical'}active{/if}" href="{plink Inbox:default, severity => 'critical', unreadOnly => $unreadOnly}">Critical</a>
	<a class="filter-btn {if $severityFilter === 'high'}active{/if}"     href="{plink Inbox:default, severity => 'high',     unreadOnly => $unreadOnly}">High</a>
	<a class="filter-btn {if $severityFilter === 'medium'}active{/if}"   href="{plink Inbox:default, severity => 'medium',   unreadOnly => $unreadOnly}">Medium</a>
	<a class="filter-btn {if $severityFilter === 'low'}active{/if}"      href="{plink Inbox:default, severity => 'low',      unreadOnly => $unreadOnly}">Low</a>
	<a class="filter-btn {if $severityFilter === 'info'}active{/if}"     href="{plink Inbox:default, severity => 'info',     unreadOnly => $unreadOnly}">Info</a>
	<a class="filter-btn" style="margin-left:auto;" href="{plink Inbox:default, severity => $severityFilter, unreadOnly => !$unreadOnly}">
		{$unreadOnly ? 'Show read too' : 'Unread only'}
	</a>
</div>

{if !$notifications}
	<div class="empty" style="margin-bottom:32px;">
		{if $unreadOnly}No unread notifications.{else}No notifications match the current filter.{/if}
	</div>
{else}
	<table class="rem-table" style="margin-bottom:32px;">
		<thead>
			<tr>
				<th>Severity</th>
				<th>Title</th>
				<th>Source</th>
				<th>Channels</th>
				<th>Created</th>
				<th>Action</th>
			</tr>
		</thead>
		<tbody>
			{foreach $notifications as $n}
				<tr style="{if $n['wing_inbox_read_at']}opacity:0.6;{/if}">
					<td><span class="badge badge-{$n['severity']|lower}">{$n['severity']}</span></td>
					<td>
						<div style="font-size:13px;">{$n['title']}</div>
						{if !empty($n['body'])}
							<div style="font-size:11px; color:var(--text2); margin-top:2px; max-width:480px; overflow:hidden; text-overflow:ellipsis;">{$n['body']|substr:0,240}{if strlen($n['body']) > 240}…{/if}</div>
						{/if}
					</td>
					<td style="font-size:11px; color:var(--text2)">
						{if !empty($n['origin_plugin'])}plugin:{$n['origin_plugin']}{/if}
						{if !empty($n['origin_agent'])}agent:{$n['origin_agent']}{/if}
						{if empty($n['origin_plugin']) && empty($n['origin_agent']) && !empty($n['actor_id'])}{$n['actor_id']}{/if}
					</td>
					<td style="font-size:11px; color:var(--text2)">{implode(', ', $n['channels'] ?? [])}</td>
					<td style="font-size:11px; color:var(--text2)">{($n['created_at'] ?? '')|substr:0,19}</td>
					<td>
						{if !$n['wing_inbox_read_at']}
							<form method="post" action="{plink Inbox:markRead, uuid => $n['uuid']}" style="display:inline;">
								<input type="hidden" name="_csrf" value="{$csrfToken}">{* SEC-14 CSRF *}
								<button type="submit" class="btn btn-small">Mark read</button>
							</form>
						{else}
							<span style="font-size:11px; color:var(--text2)">read {($n['wing_inbox_read_at'] ?? '')|substr:11,8}</span>
						{/if}
					</td>
				</tr>
			{/foreach}
		</tbody>
	</table>
{/if}

{* ── Gitleaks findings ──────────────────────────────────────────────────── *}
<h3 style="font-size:15px; margin-bottom:10px;">Secret Findings</h3>

{if !$findings}
	<div class="empty" style="margin-bottom:32px;">No unresolved secret findings — clean.</div>
{else}
	<div class="filter-bar" style="margin-bottom:10px;">
		<button class="filter-btn active" data-filter="severity" data-value="">All</button>
		<button class="filter-btn" data-filter="severity" data-value="critical">Critical</button>
		<button class="filter-btn" data-filter="severity" data-value="high">High</button>
		<button class="filter-btn" data-filter="severity" data-value="medium">Medium</button>
		<input type="text" class="filter-search" id="inboxSearch" placeholder="Search findings...">
	</div>

	<table class="rem-table" id="inboxTable" style="margin-bottom:32px;">
		<thead>
			<tr>
				<th>Severity</th>
				<th>Rule</th>
				<th>File</th>
				<th>Line</th>
				<th>Secret (masked)</th>
				<th>Commit</th>
				<th>Author</th>
				<th>Scan ID</th>
				<th>Found</th>
			</tr>
		</thead>
		<tbody id="inboxBody">
			{foreach $findings as $f}
				<tr data-severity="{$f['severity']|lower}"
				    data-search="{$f['rule_id']|lower} {$f['file_path']|lower} {($f['author'] ?? '')|lower}">
					<td><span class="badge badge-{$f['severity']|lower}">{$f['severity']}</span></td>
					<td style="font-size:12px"><strong>{$f['rule_id']}</strong></td>
					<td style="font-size:11px; word-break:break-all">{$f['file_path']}</td>
					<td style="font-size:12px; text-align:right">{$f['line_start']}</td>
					<td style="font-family:monospace; font-size:12px">{$f['secret_masked'] ?? 'N/A'}</td>
					<td style="font-size:11px; font-family:monospace">{($f['commit_sha'] ?? '')|substr:0,8}</td>
					<td style="font-size:12px">{$f['author'] ?? ''}</td>
					<td style="font-size:11px; color:var(--text2)">{($f['scan_id'] ?? '')|substr:0,16}</td>
					<td style="font-size:11px; color:var(--text2)">{($f['created_at'] ?? '')|substr:0,10}</td>
				</tr>
			{/foreach}
		</tbody>
	</table>

	<p style="font-size:12px; color:var(--text2)">
		Resolve a finding via:
		<code>POST /api/v1/gitleaks_findings/&#123;id&#125;/resolve</code>
	</p>
{/if}

{* ── Conductor runs ──────────────────────────────────────────────────────── *}
<h3 style="font-size:15px; margin-bottom:10px; margin-top:32px;">Conductor Runs</h3>

{if !$conductorEvents}
	<div class="empty">No conductor runs recorded yet. The conductor agent (A8) posts events here.</div>
{else}
	<table class="rem-table" style="margin-bottom:16px;">
		<thead>
			<tr>
				<th>Type</th>
				<th>Run ID</th>
				<th>Timestamp</th>
				<th>Result</th>
			</tr>
		</thead>
		<tbody>
			{foreach $conductorEvents as $ev}
				<tr>
					<td><span class="badge badge-{$ev['type'] === 'agent_run_end' ? 'resolved' : 'pending'}">{$ev['type']}</span></td>
					<td style="font-size:11px; font-family:monospace">{($ev['run_id'] ?? '')|substr:0,24}</td>
					<td style="font-size:12px; color:var(--text2)">{($ev['ts'] ?? '')|substr:0,19}</td>
					<td style="font-size:12px">
						{if !empty($ev['result_json'])}
							{var $res = json_decode($ev['result_json'], true)}
							{if isset($res['exit_code'])}
								exit={$res['exit_code']}
								{if !empty($res['summary'])}&nbsp;· {$res['summary']|substr:0,80}{/if}
							{/if}
						{/if}
					</td>
				</tr>
			{/foreach}
		</tbody>
	</table>
{/if}

<script src="/assets/inbox.js?v={$basePath}" defer></script>
{/block}
