{
	"name": "nos-face",
	"version": "0.8.0",
	"private": true,
	"type": "module",
	"description": "nOS face — the unified web-desktop shell (vendored into the nOS monorepo).",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build/index.js",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^6.0.2",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/d3-force": "^3.0.10",
		"@types/node": "^22.10.5",
		"eslint": "^9.17.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.46.1",
		"globals": "^15.14.0",
		"happy-dom": "21.0.4",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.2",
		"svelte": "^5.57.1",
		"svelte-check": "^4.1.1",
		"typescript": "^6.0.0",
		"typescript-eslint": "^8.19.0",
		"vite": "^8.0.12",
		"vitest": "^4.1.12",
		"yaml": "^2.9.0",
		"zod": "^4.6.7"
	},
	"engines": {
		"node": ">=22.17"
	},
	"dependencies": {
		"@xyflow/svelte": "^1.6.6",
		"d3-force": "^3.0.0",
		"devalue": "^5.9.4",
		"html-to-image": "^1.11.13"
	},
	"overrides": {
		"postcss-selector-parser": "^7.1.6"
	}
}
