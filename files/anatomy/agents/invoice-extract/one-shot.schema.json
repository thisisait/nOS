{
  "$comment": "Reuses state/schema/isdoc-record.schema.yaml VERBATIM (frozen phase-1 contract) as Ollama's native structured-output `format` param — the constrained-decoding half of the invoice-structured-extractor unit. tests/anatomy/test_invoice_extractor_pipeline.py pins the two files to the same property set so they cannot drift apart. `required` is empty on purpose (ops-extract precedent): a field absent from the source document must stay a legal answer, not a schema violation.",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nos.thisisait.eu/schema/isdoc-record.yaml",
  "title": "ISDOC record dict",
  "type": "object",
  "required": [],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string" },
    "issue": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "due": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "currency": { "type": "string", "enum": ["CZK", "EUR"] },
    "payable": { "type": "number" },
    "net": { "type": "number" },
    "vat": { "type": "number" },
    "vat_breakdown": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["base", "vat"],
        "additionalProperties": false,
        "properties": {
          "rate": { "type": "number" },
          "base": { "type": "number" },
          "vat": { "type": "number" }
        }
      }
    },
    "seller": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ico": { "type": "string", "pattern": "^[0-9]{1,8}$" },
        "name": { "type": "string" }
      }
    },
    "buyer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ico": { "type": "string", "pattern": "^[0-9]{1,8}$" },
        "name": { "type": "string" }
      }
    }
  }
}
