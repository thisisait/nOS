{#- ADR-0001 Phase 1: build the authentik_services map from the committed
    registry (state/tofu-authentik-services.yml, loaded as tofu_authentik_services
    via lookup('template') — the FILE render resolves the nested Jinja in each
    registry value; post-2.19 data-tagging means lookup('file')+from_yaml would
    leave them as literal '{{ x_domain }}' strings (untrusted, never templated).
    STRUCTURE is in services.tf (for_each); this is just VALUES. -#}
{%- set _svcmap = {} -%}
{%- for s in tofu_authentik_services | default([]) -%}
  {#- Disabled-service filter: the registry carries each client's enable
      expression as raw Jinja; lookup('template') has already rendered it by
      now, so `s.enabled` arrives as a STRING like "True"/"False" — coerce
      with `bool`. Missing field = disabled, mirroring the blueprint filter
      (10-oidc-apps.yaml.j2: `c.enabled | default(false) | bool`).
      OPERATIONAL CONSEQUENCE: on an already-provisioned tenant, a service
      that flips enabled→false drops out of var.authentik_services and plans
      as a DESTROY — the destroy guard in tasks/tofu-authentik.yml then
      refuses apply. The operator resolves via a supervised one-time apply
      (review the plan, run `tofu apply tfplan` by hand) or the next blank. -#}
  {%- if s.enabled | default(false) | bool -%}
  {%- set _e = {
        "mode": s.mode,
        "name": s.name,
        "external_host": s.external_host,
        "tier": s.tier | default(2),
        "client_id": s.client_id | default("nos-" ~ s.slug),
        "client_secret": s.client_secret | default(""),
        "redirect_uris": s.redirect_uris | default([]),
      } -%}
  {%- set _ = _svcmap.update({s.slug: _e}) -%}
  {%- endif -%}
{%- endfor -%}
{{
  {
    "authentik_url": "http://127.0.0.1:" ~ (authentik_port | default(9000)),
    "authentik_token": authentik_bootstrap_token,
    "authentik_services": _svcmap,
  } | to_nice_json
}}
