{# ── Style definitions ──────────────────────────────────────────────────── #}
{% set S_dot = "display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:6px;background:#3fb950" %}
{% set S_card = "background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.1);border-radius:8px;padding:16px;display:inline-block;width:210px;vertical-align:top;margin:6px" %}
{% set S_link = "color:#58a6ff;text-decoration:none;font-weight:600;font-size:14px" %}
{% set S_desc = "color:rgba(230,237,243,0.6);font-size:12px;margin:4px 0 8px 0" %}
{% set S_meta = "font-size:11px;color:rgba(230,237,243,0.4)" %}
{% set S_badge = "background:rgba(88,166,255,0.15);color:#58a6ff;padding:2px 6px;border-radius:3px;margin-left:4px;font-size:10px" %}
{% set S_th = "text-align:left;padding:8px 12px;border-bottom:2px solid rgba(255,255,255,0.1);color:rgba(230,237,243,0.6);font-weight:600;font-size:13px" %}
{% set S_td = "padding:6px 12px;border-bottom:1px solid rgba(255,255,255,0.05);font-size:13px" %}
{% set S_port = "font-family:monospace;color:#79c0ff" %}
{% set S_docker = "color:#58a6ff" %}
{% set S_brew = "color:#f0883e" %}
{% set S_bin = "color:#d2a8ff" %}
{% set S_name = "font-weight:600;font-size:14px;color:#e6edf3" %}
{% set S_ver = "color:rgba(230,237,243,0.5);font-size:12px;margin-left:6px" %}
{% set S_sub = "font-size:12px;color:rgba(230,237,243,0.5);padding:1px 0" %}
{% set S_section = "font-size:12px;font-weight:600;color:rgba(230,237,243,0.8);margin:12px 0 6px;padding-bottom:4px;border-bottom:1px solid rgba(255,255,255,0.1)" %}
{% set S_pkg = "font-size:11px;font-family:monospace;color:rgba(230,237,243,0.6);background:rgba(255,255,255,0.04);padding:2px 6px;border-radius:3px;display:inline-block;margin:2px 3px" %}
{# ── Macro for a clickable card (subdomain + Tailscale port) ───────────── #}
{% set _ts = tailscale_hostname | default('') %}
{% macro card(id, name, domain, port, desc, badge) %}
<div data-id='{{ id }}' style='{{ S_card }}'><span style='{{ S_dot }}'></span><a href='https://{{ domain }}' target='_blank' style='{{ S_link }}'>{{ name }}</a><div style='{{ S_desc }}'>{{ desc }}</div><div style='{{ S_meta }}'><a href='https://{{ domain }}' style='color:rgba(230,237,243,0.5);text-decoration:none'>{{ domain }}</a>{% if port %} · <a href='http://{{ _ts if _ts else "localhost" }}:{{ port }}' style='{{ S_port }};text-decoration:none'>:{{ port }}</a>{% endif %} <span style='{{ S_badge }}'>{{ badge }}</span></div></div>
{% endmacro %}
{# ── Panels 1+2 render from the one list: service-registry.json (cards = a
   routed url and not `backend`, the rest is the internal table).
   Gate: tests/anatomy/test_one_service_directory.py ─────────────────────── #}
{% set _registry = (lookup('template', playbook_dir ~ '/templates/service-registry.json.j2') | from_json).services %}
{% set _cards = [] %}
{% set _rows = [] %}
{% macro trow(id, name, ports, ttype, stack, desc) %}
{% set _ = _rows.append("<tr data-id='" ~ id ~ "'><td style='" ~ S_td ~ "'><span style='" ~ S_dot ~ "'></span>" ~ name ~ "</td><td style='" ~ S_td ~ ";" ~ S_port ~ "'>" ~ ports ~ "</td><td style='" ~ S_td ~ ";" ~ ({'docker': S_docker, 'binary': S_bin}.get(ttype, S_brew)) ~ "'>" ~ ttype ~ "</td><td style='" ~ S_td ~ "'>" ~ stack ~ "</td><td style='" ~ S_td ~ "'>" ~ desc ~ "</td></tr>") %}
{% endmacro %}
{% for s in _registry %}
{%   if s.get('url') and not s.get('backend') %}
{%     set _ = _cards.append(card(s.id, s.name, s.domain, s.get('port') or '', s.get('description', ''), s.get('stack') or s.category)) %}
{%   else %}
{{ trow(s.id, s.name, (s.get('port') or '') | string, s.get('type', ''), s.get('stack') or 'host', s.get('description', '')) }}
{%   endif %}
{% endfor %}
{# ── Panel 3: Languages ─────────────────────────────────────────────────── #}
{% set _lang_items = [] %}
{% if install_php | default(true) %}
{% set _subs = [] %}
{% for ext in php_extensions | default([]) %}
{% set _ = _subs.append("<li style='" ~ S_sub ~ "'>&#10003; " ~ ext.split('-')[-1] ~ "</li>") %}
{% endfor %}
{% set _ = _lang_items.append("<li style='margin-bottom:12px'><span style='" ~ S_dot ~ "'></span><span style='" ~ S_name ~ "'>PHP</span><span style='" ~ S_ver ~ "'>" ~ (php_version | default('8.3')) ~ "</span><ul style='list-style:none;padding-left:20px;margin-top:4px'>" ~ _subs | join('') ~ "</ul></li>") %}
{% endif %}
{% if install_node | default(true) %}
{% set _subs = [] %}
{% for pkg in node_global_packages | default([]) %}
{% set _ = _subs.append("<li style='" ~ S_sub ~ "'>&#10003; " ~ pkg ~ "</li>") %}
{% endfor %}
{% set _ = _lang_items.append("<li style='margin-bottom:12px'><span style='" ~ S_dot ~ "'></span><span style='" ~ S_name ~ "'>Node.js</span><span style='" ~ S_ver ~ "'>" ~ (node_nvm_version | default('lts/*')) ~ "</span><ul style='list-style:none;padding-left:20px;margin-top:4px'>" ~ _subs | join('') ~ "</ul></li>") %}
{% endif %}
{% if install_bun | default(true) %}
{% set _ = _lang_items.append("<li style='margin-bottom:12px'><span style='" ~ S_dot ~ "'></span><span style='" ~ S_name ~ "'>Bun</span><span style='" ~ S_ver ~ "'>latest</span></li>") %}
{% endif %}
{% if install_python | default(true) %}
{% set _subs = [] %}
{% for pkg in pip_packages | default([]) %}
{% set _ = _subs.append("<li style='" ~ S_sub ~ "'>&#10003; " ~ pkg.name ~ "</li>") %}
{% endfor %}
{% set _ = _lang_items.append("<li style='margin-bottom:12px'><span style='" ~ S_dot ~ "'></span><span style='" ~ S_name ~ "'>Python</span><span style='" ~ S_ver ~ "'>" ~ (python_version | default('3.13')) ~ "</span><ul style='list-style:none;padding-left:20px;margin-top:4px'>" ~ _subs | join('') ~ "</ul></li>") %}
{% endif %}
{% if install_golang | default(true) %}
{% set _subs = [] %}
{% for pkg in go_packages | default([]) %}
{% set _ = _subs.append("<li style='" ~ S_sub ~ "'>&#10003; " ~ pkg.split('/')[-1].split('@')[0] ~ "</li>") %}
{% endfor %}
{% set _ = _lang_items.append("<li style='margin-bottom:12px'><span style='" ~ S_dot ~ "'></span><span style='" ~ S_name ~ "'>Go</span><span style='" ~ S_ver ~ "'>latest</span><ul style='list-style:none;padding-left:20px;margin-top:4px'>" ~ _subs | join('') ~ "</ul></li>") %}
{% endif %}
{% if install_dotnet | default(true) %}
{% set _subs = [] %}
{% for tool in dotnet_global_tools | default([]) %}
{% set _ = _subs.append("<li style='" ~ S_sub ~ "'>&#10003; " ~ tool.name ~ "</li>") %}
{% endfor %}
{% set _ = _lang_items.append("<li style='margin-bottom:12px'><span style='" ~ S_dot ~ "'></span><span style='" ~ S_name ~ "'>.NET</span><span style='" ~ S_ver ~ "'>latest</span><ul style='list-style:none;padding-left:20px;margin-top:4px'>" ~ _subs | join('') ~ "</ul></li>") %}
{% endif %}
{# ── Panel 4: Homebrew packages ─────────────────────────────────────────── #}
{% set _brew_cli = [] %}
{% for pkg in homebrew_installed_packages | default([]) %}
{% set _ = _brew_cli.append("<span style='" ~ S_pkg ~ "'>" ~ pkg ~ "</span>") %}
{% endfor %}
{% set _brew_cask = [] %}
{% for app in homebrew_cask_apps | default([]) %}
{% set _ = _brew_cask.append("<span style='" ~ S_pkg ~ "'>" ~ app ~ "</span>") %}
{% endfor %}
{# ── JSON output ────────────────────────────────────────────────────────── #}
