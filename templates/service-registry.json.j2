{# =============================================================================
   SERVICE REGISTRY – catalog of all services, languages and packages
   Generated by Ansible – DO NOT EDIT MANUALLY
   ============================================================================= #}
{
  {# `generated_at` intentionally omitted: a volatile per-run timestamp made the
     rendered file differ every run, so the template task reported changed even
     when nothing about the catalog changed. The catalog content below is
     deterministic, so dropping the stamp makes a steady-state re-run changed=0.
     Consumers read this field defensively (ServiceRegistry.php: `?? null`). #}
  "hostname": "{{ ansible_facts['hostname'] }}",
  "domain": "{{ tenant_domain | default(dnsmasq_dev_domain | default('dev.local')) }}",
  "services": [
{# Membership is the installed set — nos_identity.installed via filter nos_installed,
   the services-status derivation. A row has a card (domain/url) when Traefik routes
   it. Display fields (name, icon, description, rbac_tier, backend) join from each
   plugin's hub_card (filter nos_hub_cards); _meta below is only what a hub_card
   cannot give: a loopback health_url, and name/description for rows with no card.
   Gates: test_service_registry_is_the_installed_set.py, test_one_service_directory.py #}
{% set _cards = playbook_dir | nos_hub_cards %}
{% set _meta = {
  'jellyfin': {"health_url": "http://127.0.0.1:" ~ (jellyfin_port | default(8096)) ~ "/health"},
  'bluesky_pds': {"name": "Bluesky PDS", "description": "AT Protocol Personal Data Server"},
  'dnsmasq': {"name": "dnsmasq", "description": "DNS resolver (*." ~ (dnsmasq_dev_domain | default('dev.local')) ~ ")"},
  'mariadb': {"name": "MariaDB", "description": "Relational database",
              "health_url": "tcp://127.0.0.1:" ~ (mariadb_port | default(3306))},
  'postgresql': {"name": "PostgreSQL", "description": "Relational database (Outline, Metabase, Superset)",
                 "health_url": "tcp://127.0.0.1:" ~ (postgresql_port | default(5432))},
  'redis': {"name": "Redis (Docker)", "description": "In-memory cache (shared across stacks)",
            "health_url": "tcp://127.0.0.1:" ~ (redis_port | default(6379))},
  'prometheus': {"name": "Prometheus", "description": "Metrics and alerting",
                 "health_url": "http://127.0.0.1:" ~ (prometheus_port | default(9090)) ~ "/-/healthy"},
  'loki': {"name": "Loki", "description": "Log aggregation",
           "health_url": "http://127.0.0.1:" ~ (loki_port | default(3100)) ~ "/ready"},
  'tempo': {"name": "Tempo", "description": "Distributed tracing",
            "health_url": "http://127.0.0.1:" ~ (tempo_http_port | default(3200)) ~ "/ready"},
  'alloy': {"name": "Alloy", "description": "Metrics and logs collector",
            "health_url": "http://127.0.0.1:" ~ (alloy_ui_port | default(12345)) ~ "/-/ready"},
  'ollama': {"name": "Ollama", "description": "LLM inference engine",
             "health_url": "http://127.0.0.1:11434/api/version"},
  'uptime_kuma': {"health_url": "http://127.0.0.1:" ~ (uptime_kuma_port | default(3001))},
  'calibre_web': {"health_url": "http://127.0.0.1:" ~ (calibreweb_port | default(8083))},
  'homeassistant': {"health_url": "http://127.0.0.1:" ~ (homeassistant_port | default(8123))},
  'rustfs': {"health_url": "http://127.0.0.1:" ~ (rustfs_api_port | default(9010)) ~ "/health"},
} %}
{% set _rows = (lookup('file', playbook_dir ~ '/state/manifest.yml') | from_yaml).services %}
{% set _skip = (lookup('file', playbook_dir ~ '/roles/pazny.traefik/vars/main.yml') | from_yaml).traefik_skip_ids %}
{% set _flags = {} %}
{% for r in _rows if r.install_flag is defined %}
{%   set _ = _flags.update({r.install_flag: lookup('vars', r.install_flag, default=false)}) %}
{% endfor %}
{% set _services = [] %}
{% for r in _flags | nos_installed(_rows) %}
{%   set _svc = {"id": r.id, "name": r.id | replace('_', ' ') | title, "category": r.category,
                 "tier": 2, "enabled": true, "toggle_var": r.install_flag,
                 "type": "docker" if r.stack else "host", "stack": r.stack} %}
{%   if r.port_var is defined %}{% set _ = _svc.update({"port": lookup('vars', r.port_var, default=none)}) %}{% endif %}
{%   if r.domain_var is defined and (r.id not in _skip or (r.id == 'traefik' and traefik_dashboard_route_enabled | default(true) | bool)) %}
{%     set _host = lookup('vars', r.domain_var, default=(r.id | replace('_', '-')) ~ (_host_alias_seg | default('')) ~ '.' ~ (tenant_domain | default('dev.local'))) %}
{%     set _ = _svc.update({"tier": 1, "domain": _host, "url": "https://" ~ _host}) %}
{%   endif %}
{%   set _ver = lookup('vars', r.version_var, default='') if r.version_var is defined else '' %}
{%   if _ver is string and _ver %}{% set _ = _svc.update({"version": _ver}) %}{% endif %}
{%   if r.rbac_tier is defined %}{% set _ = _svc.update({"rbac_tier": r.rbac_tier}) %}{% endif %}
{%   set _ = _services.append(_svc | combine(_cards.get(r.id, {}), _meta.get(r.id, {}))) %}
{% endfor %}
{# ── Host nginx + exporters: install_nginx, no manifest row ───────────── #}
{% if install_nginx | default(true) %}
{% set _ = _services.append({
  "name": "Nginx",
  "id": "nginx",
  "category": "web",
  "tier": 2,
  "enabled": true,
  "toggle_var": "install_nginx",
  "port": 443,
  "health_url": "https://127.0.0.1:443",
  "type": "homebrew",
  "description": "Reverse proxy + SSL"
}) %}
{% set _ = _services.append({
  "name": "PHP-FPM",
  "id": "phpfpm",
  "category": "web",
  "tier": 2,
  "enabled": true,
  "toggle_var": "install_php",
  "port": 0,
  "type": "homebrew",
  "description": "PHP FastCGI (socket)"
}) %}
{% endif %}
{% if install_nginx | default(false) %}
{% set _ = _services.append({
  "name": "nginx-exporter",
  "id": "nginx_exporter",
  "category": "observability",
  "tier": 2,
  "enabled": true,
  "toggle_var": "install_observability",
  "port": 9113,
  "health_url": "http://127.0.0.1:9113/metrics",
  "type": "binary",
  "description": "Nginx metrics"
}) %}
{% endif %}
{% if install_nginx | default(false) %}
{% set _ = _services.append({
  "name": "php-fpm_exporter",
  "id": "phpfpm_exporter",
  "category": "observability",
  "tier": 2,
  "enabled": true,
  "toggle_var": "install_observability",
  "port": phpfpm_exporter_port | default(9253),
  "health_url": "http://127.0.0.1:" ~ (phpfpm_exporter_port | default(9253)) ~ "/metrics",
  "type": "binary",
  "description": "PHP-FPM metrics"
}) %}
{% endif %}
{# ── Tier-2: apps onboarded via pazny.apps_runner ──────────────────────── #}
{# apps_extra_services is a runtime fact set by roles/pazny.apps_runner/    #}
{# tasks/post.yml — one entry per parsed apps/<name>.yml manifest. Each     #}
{# entry already has the same shape as Tier-1 entries above (registry_entry #}
{# in nos_apps_render).                                                     #}
{% for svc in (apps_extra_services | default([])) %}
{% set _ = _services.append(svc) %}
{% endfor %}
{# Inject derived `id` field on every service entry. Avoids having to
   patch all 56 _services.append blocks above; consumers (Bone /api/services,
   Wing SystemRepository::ingestRegistry) all expect an
   `id` slug. Derivation: toggle_var with `install_` prefix stripped
   (mirrors the PHP fallback in SystemRepository.php). Apps-runner-supplied
   entries already carry their own `id` (e.g. `app_documenso`); we only
   inject when missing. #}
{% set _services_with_ids = [] %}
{% for svc in _services %}
{%   if svc.get('id') %}
{%     set _ = _services_with_ids.append(svc) %}
{%   else %}
{%     set _tv = svc.get('toggle_var', '') %}
{%     set _id = (_tv[8:] if _tv.startswith('install_') else _tv) | default(svc.get('name','unknown') | lower | replace(' ','_'), true) %}
{%     set _ = _services_with_ids.append(svc | combine({'id': _id})) %}
{%   endif %}
{% endfor %}
{# ── Output _services as a JSON array ───────────────────────────────────── #}
{% for svc in _services_with_ids %}
    {{ svc | to_json }}{{ "," if not loop.last else "" }}
{% endfor %}
  ],
  "languages": [
{% set _langs = [] %}
{% if install_php | default(true) %}
{% set _ = _langs.append({
  "name": "PHP",
  "version": php_version | default('8.3'),
  "enabled": true,
  "toggle_var": "install_php",
  "type": "homebrew",
  "sub_packages": (php_extensions | default([])) | map('regex_replace', '^php@[^-]+-', '') | list
}) %}
{% endif %}
{% if install_node | default(true) %}
{% set _ = _langs.append({
  "name": "Node.js",
  "version": node_nvm_version | default('lts/*'),
  "enabled": true,
  "toggle_var": "install_node",
  "type": "nvm",
  "sub_packages": node_global_packages | default([])
}) %}
{% endif %}
{% if install_bun | default(true) %}
{% set _ = _langs.append({
  "name": "Bun",
  "version": "latest",
  "enabled": true,
  "toggle_var": "install_bun",
  "type": "homebrew",
  "sub_packages": []
}) %}
{% endif %}
{% if install_python | default(true) %}
{% set _ = _langs.append({
  "name": "Python",
  "version": python_version | default('3.13'),
  "enabled": true,
  "toggle_var": "install_python",
  "type": "pyenv",
  "sub_packages": (pip_packages | default([])) | map(attribute='name') | list
}) %}
{% endif %}
{% if install_golang | default(true) %}
{% set _ = _langs.append({
  "name": "Go",
  "version": "latest",
  "enabled": true,
  "toggle_var": "install_golang",
  "type": "homebrew",
  "sub_packages": (go_packages | default([])) | map('regex_replace', '.*/([^/@]+)(@.*)?$', '\\1') | list
}) %}
{% endif %}
{% if install_dotnet | default(true) %}
{% set _ = _langs.append({
  "name": ".NET",
  "version": "latest",
  "enabled": true,
  "toggle_var": "install_dotnet",
  "type": "homebrew_cask",
  "sub_packages": (dotnet_global_tools | default([])) | map(attribute='name') | list
}) %}
{% endif %}
{% for lang in _langs %}
    {{ lang | to_json }}{{ "," if not loop.last else "" }}
{% endfor %}
  ],
  "packages": {
    "homebrew": {{ (homebrew_installed_packages | default([])) | to_json }},
    "homebrew_cask": {{ (homebrew_cask_apps | default([])) | to_json }}
  }
}
