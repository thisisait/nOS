# {{ ansible_managed }} by nOS (tasks/mdns.yml): the names Traefik routes, at this host's LAN address.
# avahi-publish -R: no PTR, which <hostname>.local already holds (a static /etc/avahi/hosts
# record claims it too and fails "Local name collision" — the mini, 2026-11-01).
[Unit]
Description=nOS LAN names over mDNS
After=avahi-daemon.service
Requires=avahi-daemon.service
PartOf=avahi-daemon.service

[Service]
# Not DynamicUser: its avahi-publish got "Failed to create client object" from D-Bus (the
# mini, 11-02). The avahi account exists with the package; the D-Bus default policy admits it.
User=avahi
Group=avahi
# One publisher gone is the unit gone: wait -n returns on the first exit, so systemd restarts all.
ExecStart=/bin/bash -c '{% for n in _mdns_names if n is match('^[a-z0-9][a-z0-9.-]*$') and n != (ansible_facts['hostname'] ~ '.local') %}avahi-publish -a -R {{ n }} {{ nos_lan_ip }} & {% endfor %}wait -n; exit 1'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
