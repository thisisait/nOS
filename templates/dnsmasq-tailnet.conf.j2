# Generated by Ansible (tasks/dnsmasq.yml) - the tailnet dnsmasq of a roaming host.
# The system instance keeps loopback; this one listens on the Tailscale address only.
listen-address={{ _dnsmasq_ts_ip }}
bind-interfaces
address=/.{{ dnsmasq_dev_domain }}/{{ _dnsmasq_ts_ip }}
local=/{{ dnsmasq_dev_domain }}/
no-resolv
# The system instance owns the default pid file.
pid-file=
