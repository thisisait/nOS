---
# nOS – persisted runtime secrets
# Auto-generated by Ansible. DO NOT EDIT MANUALLY.
# File: ~/.nos/secrets.yml  (mode 0600, gitignored)
#
# Contains only secrets that encrypt persistent user data.
# Stateless secrets (session tokens, auth tokens) are not here — those are
# regenerated on every run intentionally.

# ── Infisical KMS ────────────────────────────────────────────────────────────
infisical_encryption_key: "{{ infisical_encryption_key }}"
infisical_auth_secret: "{{ infisical_auth_secret }}"
# Admin machine identity token from `infisical bootstrap` — persisted so
# subsequent runs of seed.yml skip bootstrap and reuse this token.
infisical_admin_token: "{{ infisical_admin_token | default('') }}"

# ── HMAC + deploy secrets (SEC-3, 2026-05-23) ────────────────────────────────
# 256-bit openssl-rand generated on first run; persisted here so Bone/Wing/CI
# stay in sync across runs. NEVER prefix-derived — defending against
# default-prefix entropy collapse.
bone_secret: "{{ bone_secret | default('') }}"
# The key ring. Comma-separated, newest retired first. This file is the ONLY
# durable record of a retired chain key — lose it and every audit row signed
# before the last rotation becomes unverifiable, which is precisely the
# situation the ring exists to prevent. It is why the entry is persisted here
# rather than being derived at converge time.
bone_secret_retired: "{{ bone_secret_retired | default('') }}"
wing_events_hmac_secret: "{{ wing_events_hmac_secret | default('') }}"
nos_deploy_hmac_secret: "{{ nos_deploy_hmac_secret | default('') }}"
# SEC-6: Traefik→Wing edge-trust signature. Wing rejects forward-auth
# headers unless this header is set + matches.
wing_edge_token: "{{ wing_edge_token | default('') }}"
# SEC-6 sibling: Traefik→face edge-trust signature. The face BFF trusts
# X-Authentik-* identity headers only when this one matches, so it must be
# stable across converges — REM-144 moved it off the password prefix, and
# without persisting it here it would regenerate every run and churn both the
# middleware render and the face's own env.
face_edge_token: "{{ face_edge_token | default('') }}"
# A18 (2026-05-23): nos-users project UUID, harvested from seed.py output.
# Wing's invite-flow Cesta B reads it to scope per-user credential folders.
# Empty until the first successful seed run; populated automatically
# afterwards so the operator never has to `infisical projects list` + copy.
infisical_users_project_id: "{{ infisical_users_project_id | default('') }}"

# ── Woodpecker↔Gitea OAuth2 (A19, 2026-05-23) ───────────────────────────────
# Self-captured from the Gitea OAuth2-app create response (post-oauth.yml).
# Gitea returns the secret only on create, so it MUST persist here for reruns;
# the woodpecker compose render reads both via the default('') guards.
woodpecker_gitea_client: "{{ woodpecker_gitea_client | default('') }}"
woodpecker_gitea_secret: "{{ woodpecker_gitea_secret | default('') }}"

# ── Gitea agent-forge token (T32) — repo-scoped, generated by pazny.gitea
#    post-forge.yml when gitea_agent_forge=true; consumed by tools/recipe-pr.sh
#    (+ tools/nos-push / sync-trunk-to-gitea.sh). Shown once on create, so it
#    persists here and is reused; regenerated when the Gitea DB is fresh (blank).
gitea_api_token: "{{ gitea_api_token | default('') }}"

# ── GitLab agent-forge PAT (T32.2, 2026-06-10) — minted by pazny.gitlab
#    post-forge.yml (rails set_token) when gitlab_agent_forge=true; consumed by
#    tools/recipe-pr.sh (GitLab MRs) + tools/sync-trunk-to-gitlab.sh. Persisted
#    so it is reused; revoked + recreated when invalid (fresh GitLab / blank).
gitlab_api_token: "{{ gitlab_api_token | default('') }}"

# ── WordPress devlog-bot Application Password (devlog epic, 2026-06-12) ──────
#    Minted by pazny.wordpress devlog.yml (wp user application-password create,
#    shown once); consumed by files/anatomy/scripts/devlog-sync.py +
#    tools/devlog-post.py. Re-minted when empty (fresh WP after blank).
wordpress_devlog_app_password: "{{ wordpress_devlog_app_password | default('') }}"

# ── Outline (database encrypted with this key) ───────────────────────────────
outline_secret_key: "{{ outline_secret_key }}"

# ── Bluesky PDS (PLC rotation key — identity root) ──────────────────────────
bluesky_pds_rotation_key: "{{ bluesky_pds_rotation_key }}"
bluesky_pds_jwt_secret: "{{ bluesky_pds_jwt_secret }}"

# ── Firefly III (Laravel APP_KEY — encrypts OAuth2 secrets + 2FA) ────────────
firefly_app_key: "{{ firefly_app_key }}"

# ── BookStack (Laravel APP_KEY — encrypts API tokens + 2FA backup codes) ─────
bookstack_app_key: "{{ bookstack_app_key }}"

# ── ONLYOFFICE (JWT secret shared with Nextcloud/BookStack host config) ──────
onlyoffice_jwt_secret: "{{ onlyoffice_jwt_secret }}"

# ── InfluxDB (admin token — Grafana datasource uses this) ────────────────────
influxdb_admin_token: "{{ influxdb_admin_token }}"

# ── Authentik (Django SECRET_KEY — CSRF + session signing) ───────────────────
authentik_secret_key: "{{ authentik_secret_key }}"

# ── Wing API bearer (Pulse + agents authenticate to Wing with this) ──────────
# Persisted so the token is stable across runs — regenerating it churned the
# agents' bearer and made Pulse's launchd plist render non-idempotent.
wing_api_token: "{{ wing_api_token }}"

# ── Stateless service tokens — persisted for idempotence (2026-05-31) ────────
# Each was regen-every-run; that re-rendered the owning service's env/config
# on every steady-state run (changed>0). Persisted so a full-playbook re-run
# is changed=0. Stateless (rotatable session/auth tokens, not data-encrypting),
# so they stay out of the destructive group — like wing_api_token above.
vaultwarden_admin_token: "{{ vaultwarden_admin_token | default('') }}"
paperclip_auth_secret: "{{ paperclip_auth_secret | default('') }}"
outline_utils_secret: "{{ outline_utils_secret | default('') }}"
hedgedoc_session_secret: "{{ hedgedoc_session_secret | default('') }}"
# nos-api admin API token. Generated in main.yml + pinned as the token `key:`
# in the 00-admin-groups blueprint; Wing reads the same var as
# AUTHENTIK_BOOTSTRAP_TOKEN. Persisted so /users + invitation minting work on a
# single blank run AND stay stable across reruns (the blueprint re-pins the
# same key; no drift). Stateless-but-sync-critical, like the SEC-3 HMACs above.
authentik_bootstrap_token: "{{ authentik_bootstrap_token | default('') }}"

# ── Agentic loop: the proposer's and the evaluator's tokens (contract §3.4).
# Persisted so the split survives a rerun — if these regenerated every run the
# two identities would still be two, but nothing holding an old one could
# reach the API, and "the loop stopped answering" is not a boundary, it is an
# outage. Minted random in main.yml; never prefix-derived (constraint D).
loop_propose_token: "{{ loop_propose_token | default('') }}"
loop_judge_token: "{{ loop_judge_token | default('') }}"
loop_operator_token: "{{ loop_operator_token | default('') }}"

# ── P2 crown jewels. These MUST persist, and the reason is the sharpest in
# this file: main.yml mints them random on first run, and if they are not
# written here they are minted AGAIN on the next run. An archive is then
# encrypted with a key that ceases to exist at the next converge — which is
# strictly worse than the derived key P2 replaced. A weak key is recoverable;
# a forgotten one is not.
#
# Found 2026-08-03 by restic failing "wrong password or no key found" on a
# repo the operator's config.yml enables and default.config.yml does not —
# the version-pin shadow class, one file overriding another.
#
# backup_encryption_keys_previous is the READ-ONLY ring: every superseded key,
# kept forever, so archives written before a rotation still open. It persists
# for exactly the same reason the current key does.
backup_encryption_passphrase: "{{ backup_encryption_passphrase | default('') }}"
restic_password: "{{ restic_password | default('') }}"
backup_encryption_keys_previous: {{ backup_encryption_keys_previous | default([]) | to_json }}

# ── Wing telemetry HMAC (callback plugin signs every batch with this; Bone
# events.py validates the signature). Both sides must agree.
#
# 2026-05-03: REMOVED from this persistence file. The previous template
# self-referenced `wing_events_hmac_secret` in the default() chain, which
# meant the loaded value from a prior run shadowed the bone_secret default
# — so when the operator rotated `global_password_prefix`, BONE_SECRET
# updated but WING_EVENTS_HMAC_SECRET stayed pinned to the old prefix.
# Result: apps_runner signs with new prefix, Bone verifies with old → 401.
#
# The default now lives in default.config.yml (`{{ bone_secret }}`) so it
# tracks the current bone_secret automatically. Operators with a custom
# override should set `wing_events_hmac_secret:` in credentials.yml — that
# load order beats the default.config.yml fallback.
#
# Stale entries in existing ~/.nos/secrets.yml will keep working until
# the operator removes the line manually OR runs `blank=true` (which
# truncates ~/.nos/ first).
