#!/usr/bin/env python3
"""Put nOS on THIS user's shelf: skills, the nos CLI env, the seed repo, MCP.

Run as the user (or `sudo -u <user> -H nos-user-setup`). Idempotent. Mirrors
tasks/skills.yml — the library is SYMLINKED, never copied; a `main` harness
gets every skill, an `agent` harness only what its frontmatter names; a shelf
is created only when its harness's parent dir already exists (a skills dir for
a harness nobody installed reads later as evidence the harness is set up).

Verify afterwards with `python3 $NOS_SRC/tools/skill-status.py` — a reader,
so it can disagree with this script, which is the point.
"""
import os
import pathlib
import shutil
import subprocess
import sys

import yaml

HOME = pathlib.Path(os.path.expanduser("~"))
SRC = pathlib.Path(os.environ.get("NOS_SRC", "/srv/nos"))
SEED_BARE = "/srv/nos-seed.git"
SEED_DIR = HOME / "nos-seed"
LIBRARY = SRC / "files/anatomy/skills"
# DGX extension: the repo-local Claude skills are useful outside the checkout.
EXTRA_MAIN = [SRC / ".claude/skills/dtt-capture"]


def consumers():
    doc = yaml.safe_load((SRC / "default.config.yml").read_text(encoding="utf-8")) or {}
    out = []
    for e in doc.get("nos_skill_consumers") or []:
        d = str(e["dir"]).replace("{{ ansible_facts['env']['HOME'] }}", str(HOME))
        out.append({"id": e["id"], "kind": e["kind"], "dir": pathlib.Path(d)})
    return out


def library():
    skills = []
    for f in sorted(LIBRARY.glob("*/SKILL.md")):
        fm = f.read_text(encoding="utf-8").split("---")
        meta = yaml.safe_load(fm[1]) if len(fm) > 2 else {}
        aud = ((meta or {}).get("metadata") or {}).get("nos", {}).get("audience") or []
        skills.append({"name": f.parent.name, "src": f.parent, "audience": list(aud)})
    return skills


def link(src: pathlib.Path, dest: pathlib.Path) -> str:
    if dest.is_symlink() and dest.resolve() == src.resolve():
        return "ok"
    if dest.is_symlink() or dest.exists():
        if dest.is_symlink():
            dest.unlink()
        else:
            return "FOREIGN (left alone)"
    dest.symlink_to(src)
    return "linked"


def _in_group(name: str) -> bool:
    import grp
    try:
        return os.environ.get("USER", "") in grp.getgrnam(name).gr_mem
    except KeyError:
        return False


def rootless_docker():
    tool = shutil.which("dockerd-rootless-setuptool.sh")
    if not tool:
        print("  rootless docker: docker-ce-rootless-extras not installed, skipped")
        return
    if _in_group("docker"):
        print("  rootless docker: user is in the docker group (root daemon), skipped")
        return
    rt = os.environ.get("XDG_RUNTIME_DIR", "")
    if not rt or not pathlib.Path(rt).is_dir():
        print("  rootless docker: no XDG_RUNTIME_DIR (needs a login shell or linger), skipped")
        return
    unit = HOME / ".config/systemd/user/docker.service"
    if not unit.exists():
        r = subprocess.run([tool, "install"], capture_output=True, text=True)
        if r.returncode != 0:
            print("  rootless docker: install FAILED:\n    " + (r.stderr or r.stdout).strip().replace("\n", "\n    ")[-800:])
            return
        print("  rootless docker: installed (systemd --user docker.service)")
    # Persist the daemon address for every client (IDE, compose, CLI) via a
    # docker context rather than an env var a non-login process would miss.
    ctx = subprocess.run(["docker", "context", "inspect", "rootless"], capture_output=True, text=True)
    if ctx.returncode != 0:
        subprocess.run(["docker", "context", "create", "rootless", "--docker",
                        f"host=unix://{rt}/docker.sock"], capture_output=True, text=True)
    subprocess.run(["docker", "context", "use", "rootless"], capture_output=True, text=True)
    info = subprocess.run(["docker", "info", "--format", "{{.SecurityOptions}}"],
                          capture_output=True, text=True, timeout=30)
    ok = "rootless" in info.stdout
    print(f"  rootless docker: {'OK — daemon answers, rootless' if ok else 'daemon not answering yet: ' + (info.stderr or info.stdout).strip()[:200]}")


def main():
    print(f"user={os.environ.get('USER', '?')} home={HOME} src={SRC}")
    # 1. skills
    for c in consumers():
        if not c["dir"].parent.is_dir():
            print(f"  {c['id']:9} harness not installed ({c['dir'].parent})")
            continue
        c["dir"].mkdir(parents=True, exist_ok=True)
        for s in library():
            if c["kind"] == "main" or c["id"] in s["audience"]:
                print(f"  {c['id']:9} {s['name']:18} {link(s['src'], c['dir'] / s['name'])}")
        if c["kind"] == "main":
            for x in EXTRA_MAIN:
                if x.is_dir():
                    print(f"  {c['id']:9} {x.name:18} {link(x, c['dir'] / x.name)}")
    # 2. nos CLI env
    nos = HOME / ".nos"
    nos.mkdir(mode=0o700, exist_ok=True)
    env = nos / "nos-cli.env"
    env.write_text(f"NOS_SRC={SRC}\nNOS_PY=python3\nNOS_SEED_DIR={SEED_DIR}\n", encoding="utf-8")
    print(f"  wrote {env}")
    # 3. seed repo clone. /srv/nos and the bare seed repo are owned by admin,
    # so git's dubious-ownership guard refuses them for every other user —
    # mark them safe in THIS user's config (user scope, no root needed).
    for safe in (SEED_BARE, str(SRC)):
        subprocess.run(["git", "config", "--global", "--add", "safe.directory", safe],
                       capture_output=True, text=True)
    if not (SEED_DIR / ".git").is_dir():
        if pathlib.Path(SEED_BARE).is_dir():
            r = subprocess.run(["git", "clone", "-q", SEED_BARE, str(SEED_DIR)], capture_output=True, text=True)
            print(f"  seed repo: {'cloned' if r.returncode == 0 else 'clone FAILED: ' + r.stderr.strip()} -> {SEED_DIR}")
        else:
            print(f"  seed repo: {SEED_BARE} absent, skipped")
    else:
        print(f"  seed repo: present at {SEED_DIR}")
    # 4. rootless Docker — the developer's own daemon, in their own slice.
    # Only for users NOT in the docker group (those drive the root daemon and
    # must keep the default context). Needs the user's systemd instance, i.e.
    # XDG_RUNTIME_DIR (a login shell, or setup-root.sh passing it in).
    rootless_docker()
    # 5. MCP registration for Claude Code (user scope; the wrapper holds no secret)
    if shutil.which("claude"):
        have = subprocess.run(["claude", "mcp", "get", "nos-tables"], capture_output=True, text=True)
        if have.returncode == 0:
            print("  claude mcp: nos-tables already registered")
        else:
            r = subprocess.run(["claude", "mcp", "add", "-s", "user", "nos-tables", "--",
                                "/srv/nos-dgx/bin/nos-tables-mcp"], capture_output=True, text=True)
            print(f"  claude mcp: {'registered nos-tables' if r.returncode == 0 else 'FAILED: ' + (r.stderr or r.stdout).strip()}")
    else:
        print("  claude mcp: claude CLI not on PATH for this user, skipped")
    return 0


if __name__ == "__main__":
    sys.exit(main())
