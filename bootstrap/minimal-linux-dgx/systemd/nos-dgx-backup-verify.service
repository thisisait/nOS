# /etc/systemd/system/nos-dgx-backup-verify.service — the reader that owns the verdict.
[Unit]
Description=nos-dgx backup verify (restore drill → /var/lib/nos-dgx/backup/last.json)
After=nos-dgx-backup.service

[Service]
Type=oneshot
ExecStart=/opt/nos-dgx/backup/nos-dgx-backup-verify.sh
Nice=10
IOSchedulingClass=idle
