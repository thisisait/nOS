# tools/ci-freeze.env — single source of truth for the FROZEN integration toolchain.
#
# Sourced by tools/ci-local.sh (the local pre-release gate) and consumable by the
# CI integration jobs, so "freezed 1:1 local + CI" is literally one file. Keep in
# lockstep with requirements.lock.yml (collections/roles). Refresh both together via
# tools/ci-local.sh --refresh-lock.
#
# Why these values:
#  - Python 3.13.13: matches the operator's pyenv (.python-version) AND CI's
#    setup-python '3.13'. Python 3.14 broke ansible-core filter-plugin imports.
#  - ansible-core 2.21+: the GitHub runner's filter-load path imports
#    VaultDecryptionContext, a symbol ADDED in 2.21; a 2.20.x controller skips
#    ansible.builtin.core filters ("No filter named bool/default/..."). The
#    operator's daily driver stays 2.20.5 — this frozen venv is the 2.21 mirror
#    used only for the pre-release wet-test. <2.24 keeps the deprecated {{ vars }}.
NOS_PYTHON_VERSION="3.13.13"
NOS_ANSIBLE_CORE="ansible-core==2.21.0"
