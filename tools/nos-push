#!/usr/bin/env bash
# nos-push — git push + instant Gitea mirror-sync (A17, 2026-05-20).
#
# Wraps `git push <args>` so that, after a successful push to GitHub
# origin, the operator's local Gitea mirror is forced to re-fetch
# immediately. Eliminates the up-to-1-minute poll delay between
# GitHub push and the Woodpecker pipeline firing.
#
# Usage:
#   tools/nos-push                       # → git push origin <current-branch>
#   tools/nos-push origin dev            # → git push origin dev
#   tools/nos-push --force-with-lease    # → git push --force-with-lease
#   tools/nos-push --skip-sync           # → git push only; no mirror trigger
#   tools/nos-push --strict              # refuse when prepush-score reaches 70
#
# Before every push, tools/prepush-score.py scores the push range (signals +
# a small local model). Advisory: it prints and records, it never blocks —
# unless --strict, where a score at the threshold or a scorer crash refuses.
#
# Configuration (auto-discovered from this clone):
#   * gitea_api_token   — from <repo>/credentials.yml::gitea_api_token
#                          (preferred) or ~/.nos/secrets.yml
#   * gitea_domain      — from <repo>/credentials.yml/config.yml or env
#                          GITEA_DOMAIN; falls back to git.<tenant_domain>
#
# Skips mirror-sync gracefully (with a one-line warning) when the token
# is missing or the Gitea API is unreachable — the underlying `git push`
# still succeeds, just with the legacy 1-min poll fallback.

# `set -eu` only — NO pipefail. We use `grep | sed | head` chains for
# config parsing and grep legitimately returns 1 on no-match (which
# pipefail would propagate to the whole substitution, aborting under
# set -e). The explicit fallbacks below handle missing values.
set -eu

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

SKIP_SYNC=0
STRICT=0
DRY_RUN=0
REMOTE=""
GIT_ARGS=()
REFSPECS=()
for arg in "$@"; do
	case "$arg" in
		--skip-sync) SKIP_SYNC=1 ;;
		--strict) STRICT=1 ;;
		-n|--dry-run) DRY_RUN=1; GIT_ARGS+=("$arg") ;;
		-*) GIT_ARGS+=("$arg") ;;
		*) if [ -z "$REMOTE" ]; then REMOTE="$arg"; else REFSPECS+=("$arg"); fi
		   GIT_ARGS+=("$arg") ;;
	esac
done
REMOTE="${REMOTE:-origin}"  # git push's first positional argument is the remote

# Push the checkout you stand in, not the one this script lives in: run as
# <main>/tools/nos-push from a worktree, `git -C $REPO_DIR` pushed main's
# HEAD:dev — "Everything up-to-date", exit 0, nothing landed (2026-10-20).
# REPO_DIR still supplies the mirror-sync config below.
PUSH_DIR="$(git rev-parse --show-toplevel 2>/dev/null || echo "$REPO_DIR")"
# This repo only (2026-10-22): run from a worktree of the PRIVATE seed repo nested under an nOS
# worktree, the push went to the nOS origin. The target must be the origin this script's own
# checkout pushes to; a remote name is resolved in the checkout you stand in.
TARGET_URL="$(git -C "$PUSH_DIR" remote get-url "$REMOTE" 2>/dev/null || echo "$REMOTE")"
HOME_URL="$(git -C "$REPO_DIR" remote get-url origin 2>/dev/null || true)"
if [ -z "$HOME_URL" ] || [ "$TARGET_URL" != "$HOME_URL" ]; then
	echo "→ nos-push refused: this repo only — $PUSH_DIR would push to '$TARGET_URL', not to this repo's origin '$HOME_URL'"
	exit 2
fi
BRANCH="$(git -C "$PUSH_DIR" symbolic-ref -q --short HEAD || true)"
if [ "${#REFSPECS[@]}" -eq 0 ]; then
	[ -n "$BRANCH" ] || { echo "→ nos-push refused: detached HEAD and no refspec — name it: tools/nos-push $REMOTE HEAD:<branch>"; exit 2; }
	REFSPECS=("$BRANCH")
fi

# 0. Score what this push carries (ssot/doctrine/session-threat-model.md).
if [ "$STRICT" -eq 1 ]; then
	python3 "$SCRIPT_DIR/prepush-score.py" --repo "$PUSH_DIR" --remote "$REMOTE" --strict \
		|| { echo "→ push refused by prepush-score --strict"; exit 3; }
else
	python3 "$SCRIPT_DIR/prepush-score.py" --repo "$PUSH_DIR" --remote "$REMOTE" \
		|| echo "→ prepush-score failed (advisory) — pushing anyway"
fi

# 1. Run the git push; abort everything if it fails.
#    Empty array expansion in bash produces a literal '' arg, which git
#    rejects as "bad repository". Branch on array size to avoid it.
if [ "${#GIT_ARGS[@]}" -gt 0 ]; then
	echo "→ git push ${GIT_ARGS[*]}"
	git -C "$PUSH_DIR" push "${GIT_ARGS[@]}"
else
	echo "→ git push"
	git -C "$PUSH_DIR" push
fi

# 1b. Success is the remote ref, not git's exit code: ls-remote each refspec's
#     destination and compare it to the sha its source names here.
landed() { # $1=refspec
	local spec="${1#+}" src dst want got
	src="${spec%%:*}"; dst="${spec#*:}"
	[ -n "$src" ] || return 0  # `:branch` is a delete
	[ "$dst" = HEAD ] && dst="$BRANCH"
	[ -n "$dst" ] || { echo "→ nos-push: '$1' from a detached HEAD names no branch — use HEAD:<branch>"; return 1; }
	want=$(git -C "$PUSH_DIR" rev-parse -q --verify "$src") || { echo "→ nos-push: cannot resolve '$src'"; return 1; }
	got=$(git -C "$PUSH_DIR" ls-remote "$REMOTE" "$dst" \
		| awk -v d="$dst" '$2==d || $2=="refs/heads/"d || $2=="refs/tags/"d {print $1; exit}')
	[ "$got" = "$want" ] && return 0
	echo "→ PUSH DID NOT LAND: $REMOTE $dst is ${got:-absent}, meant $want ($src)"
	return 1
}
if [ "$DRY_RUN" -eq 0 ]; then
	ok=1
	for spec in "${REFSPECS[@]}"; do landed "$spec" || ok=0; done
	[ "$ok" -eq 1 ] || { echo "→ mirror-sync NOT run: the push is unverified"; exit 4; }
fi

if [ "$SKIP_SYNC" -eq 1 ]; then
	echo "→ mirror-sync skipped (--skip-sync)"
	exit 0
fi

# 2. yaml_lookup <key> <file>... — emit FIRST plain-scalar value for
#    <key> across the listed YAML files, SKIPPING any value that
#    contains `{{` (= unresolved Jinja template; default.config.yml
#    uses these and would poison the lookup if accepted). `grep -h`
#    strips the filename prefix that grep prepends for multi-file
#    inputs. Empty stdout when no file has a plain literal for the
#    key — caller picks the fallback.
yaml_lookup() {
	local key="$1"; shift
	local v
	for f in "$@"; do
		[ -f "$f" ] || continue
		v=$(grep -h -E "^${key}:" "$f" 2>/dev/null \
			| sed -n -E 's/^[^:]+:[[:space:]]*"?([^"#]*[^"#[:space:]])"?[[:space:]]*(#.*)?$/\1/p' \
			| grep -vE '\{\{' \
			| head -1 || true)
		if [ -n "${v:-}" ]; then
			printf '%s' "$v"
			return 0
		fi
	done
	return 0  # empty stdout when missing — keep set -e happy
}

token=$(yaml_lookup gitea_api_token \
	"$REPO_DIR/credentials.yml" \
	"$REPO_DIR/config.yml" \
	"$HOME/.nos/secrets.yml")
if [ -z "$token" ] && [ -n "${GITEA_API_TOKEN:-}" ]; then
	token="$GITEA_API_TOKEN"
fi

domain="${GITEA_DOMAIN:-}"
if [ -z "$domain" ]; then
	domain=$(yaml_lookup gitea_domain \
		"$REPO_DIR/credentials.yml" \
		"$REPO_DIR/config.yml")
fi
# Fall back: derive from tenant_domain (works for the default
# `git.<tld>` shape used in pazny.gitea/defaults/main.yml).
if [ -z "$domain" ]; then
	tenant=$(yaml_lookup tenant_domain "$REPO_DIR/config.yml")
	if [ -n "$tenant" ]; then
		domain="git.$tenant"
	fi
fi

owner=$(yaml_lookup gitea_nos_repo_owner \
	"$REPO_DIR/config.yml" "$REPO_DIR/default.config.yml" \
	"$REPO_DIR/roles/pazny.gitea/defaults/main.yml")
[ -z "$owner" ] && owner="${USER:-$(whoami)}"

name=$(yaml_lookup gitea_nos_repo_name \
	"$REPO_DIR/config.yml" "$REPO_DIR/default.config.yml" \
	"$REPO_DIR/roles/pazny.gitea/defaults/main.yml")
[ -z "$name" ] && name="nOS"

if [ -z "$token" ] || [ -z "$domain" ]; then
	echo "→ mirror-sync skipped: missing gitea_api_token or gitea_domain"
	echo "  (push succeeded — Gitea will auto-poll within ~1 min)"
	exit 0
fi

# 3. Sync GitHub → Gitea. Agent-forge mode (gitea_agent_forge=true) is a
#    WRITABLE repo, NOT a pull-mirror: `mirror-sync` 400s on it (Gitea refuses
#    it on a non-mirror), and the real GitHub→Gitea sync is a fast-forward push
#    (tools/sync-trunk-to-gitea.sh). Running it here keeps the agent forge — and
#    the loop's base — current on every push, and drops the misleading 400 that
#    masked "no sync is happening at all". Pull-mirror mode keeps the mirror-sync
#    trigger. The sync tool is a clean no-op in the wrong mode either way.
#    Gitea is the primary agent forge, GitLab a fully-substitutable heavier alt
#    (forge-topology doctrine): whichever forge(s) are the installed agent forge
#    are WRITABLE repos, not pull-mirrors, so each is kept current by a
#    fast-forward push (its sync tool, a clean no-op when that forge is off).
#    Only a genuine pull-mirror (NO agent forge) takes the mirror-sync trigger.
gitea_forge=$(yaml_lookup gitea_agent_forge \
	"$REPO_DIR/config.yml" "$REPO_DIR/default.config.yml" \
	"$REPO_DIR/roles/pazny.gitea/defaults/main.yml")
gitlab_forge=$(yaml_lookup gitlab_agent_forge \
	"$REPO_DIR/config.yml" "$REPO_DIR/default.config.yml" \
	"$REPO_DIR/roles/pazny.gitlab/defaults/main.yml")
synced=0
sync_forge() { # $1=label  $2=tool
	if "$SCRIPT_DIR/$2" dev master >/dev/null 2>&1; then
		echo "→ $1 trunk synced (agent-forge: fast-forward dev + master)"
	else
		echo "→ $1 trunk sync deferred — non-fast-forward or forge unreachable; push still ok"
	fi
}
[ "$gitea_forge" = "true" ] && { sync_forge gitea sync-trunk-to-gitea.sh; synced=1; }
[ "$gitlab_forge" = "true" ] && { sync_forge gitlab sync-trunk-to-gitlab.sh; synced=1; }
if [ "$synced" -eq 0 ]; then
	url="https://${domain}/api/v1/repos/${owner}/${name}/mirror-sync"
	code=$(curl -s -o /dev/null -w '%{http_code}' \
		-X POST -H "Authorization: token ${token}" \
		--max-time 5 \
		"$url" || echo "000")
	case "$code" in
		200|202) echo "→ mirror-sync triggered (Gitea will fetch within seconds)" ;;
		000)     echo "→ mirror-sync: Gitea unreachable (network/cert?) — push still ok" ;;
		*)       echo "→ mirror-sync: HTTP ${code} from ${url} — push still ok" ;;
	esac
fi
