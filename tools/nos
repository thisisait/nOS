#!/usr/bin/env bash
# =============================================================================
# nos — operator entry point for the nOS playbook.
#
#   nos [-y] [--remove=none|data|deep|all] [--confirm] [--leave]
#       [--print-cmd] [-h|--help] [--version] [ansible-args...]
#   nos dtt <capture|seed|status|update|verify|extract|export|import> [args]   (DataTables ops)
#   nos loops <pause|resume|status> [--reason "..."]   (live SERE-loop pause)
#   nos halt [--status] | nos resume   (emergency halt of every Pulse job)
#   nos push [git push args]   (tools/nos-push: mirror sync + pre-push score)
#   nos stacks|cc|ci|smoke [args]   (tools/nos-stacks.sh, nos-cc.sh, ci-local.sh, nos-smoke.py)
#   nos worktrees [--confirm] [--base origin/dev]   (tools/worktree-prune.py; dry run by default)
#   nos ca [--json]   (the root CA this host signs with, and whether the edge serves it)
#
# `nos dtt` runs the DataTables tools from $NOS_SRC over the PRIVATE seed repo
# (NOS_SEED_DIR) — an installed nos reaches them from any shell/branch/cwd, so
# you never call tools/foo.py by path. Everything else is a converge:
# No second vocabulary: the first unrecognised token and everything after it
# is passed to ansible-playbook VERBATIM (`--` also ends parsing).
# Exit codes: 0 ok/print/help; N = ansible's rc verbatim; 64 usage; 65 refused
# (--remove with --tags/--skip-tags — tag filtering silently drops removal
# tasks; the playbook's R4 assert is the backstop).
#
# -y maps to: -e confirm=true -e assume_yes=true plus stdin redirection from
# /dev/null; an EMPTY -e nos_sudo_password is emitted only when the operator
# did not pass their own (removals escalate — an explicit real password must
# never be clobbered by a trailing empty one; the playbook's run-mode sudo
# preflight refuses -y removals with no sudo path). `yes` is a YAML-1.1
# truthy literal, hence the var is named assume_yes (the one documented
# naming exception; see default.config.yml).
#
# Checkout resolution: ~/.nos/nos-cli.env (NOS_SRC=..., written by
# tasks/nos-cli.yml at install) -> $NOS_SRC env -> $HOME/projects/nOS.
# =============================================================================
set -euo pipefail

NOS_CLI_VERSION=1

# The env file is a DEFAULT, never an override: a value the caller exported
# (NOS_SRC, NOS_PY, NOS_SEED_DIR) wins over ~/.nos/nos-cli.env. Measured
# 2026-09-07: the file clobbered an explicit NOS_SEED_DIR and a probe row was
# seeded into the estate roadmap from the wrong directory.
_nos_src_env="${NOS_SRC:-}"; _nos_py_env="${NOS_PY:-}"; _nos_seed_env="${NOS_SEED_DIR:-}"
# shellcheck disable=SC1091
[ -f "$HOME/.nos/nos-cli.env" ] && . "$HOME/.nos/nos-cli.env"
[ -n "$_nos_src_env" ] && NOS_SRC="$_nos_src_env"
[ -n "$_nos_py_env" ] && NOS_PY="$_nos_py_env"
[ -n "$_nos_seed_env" ] && NOS_SEED_DIR="$_nos_seed_env"
# Sourced, not exported: without this the dtt tools never see the env file's
# seed dir and fall back to the default seed dir (2026-10-09).
[ -n "${NOS_SEED_DIR:-}" ] && export NOS_SEED_DIR
NOS_SRC="${NOS_SRC:-$HOME/projects/nOS}"

# ── `nos update [ref]` — move the estate checkout, never converge ────────────
# The estate converges from its OWN clone (~/.nos/estate; NOS_ESTATE_DIR), not
# from the development tree: a feature branch checked out there used to change
# what Pulse, the agents and the launchd plists ran (estate-dev-split,
# 2026-10-23). tools/estate-adopt.sh builds the clone once (it carries
# config.yml, credentials.yml and the galaxy roles git does not track); this
# only MOVES it: fetches `ref` (a branch of origin or a tag; default: the ref
# the estate follows), refuses a dirty clone (3), an unsigned apex ruling at the
# target (4; on the operator's estate, off master, it first offers the signature, one yes) and a move that is not a fast-forward (5), checks the target out as
# branch `estate` and points NOS_SRC at the clone. Gate: test_nos_update_moves_the_estate.py.
if [ "${1:-}" = "update" ]; then
  shift
  _est="${NOS_ESTATE_DIR:-$HOME/.nos/estate}"
  _ref="${1:-}"
  if [ ! -d "$_est/.git" ]; then
    echo "nos update: no estate checkout at $_est. Build it once, dry-run first:" >&2
    echo "  $NOS_SRC/tools/estate-adopt.sh --dir $_est --from $NOS_SRC --branch ${_ref:-dev}" >&2
    exit 2
  fi
  _dirty="$(git -C "$_est" status --porcelain)"
  if [ -n "$_dirty" ]; then
    printf 'nos update: the estate checkout %s has local changes; it moves only clean:\n%s\n' "$_est" "$_dirty" >&2
    exit 3
  fi
  if [ -z "$_ref" ]; then
    _ref="$(git -C "$_est" rev-parse --abbrev-ref 'estate@{upstream}' 2>/dev/null | sed 's#^origin/##' || true)"
    [ -n "$_ref" ] || _ref="$(git -C "$_est" config --get nos.estate-ref 2>/dev/null || echo dev)"
  fi
  git -C "$_est" fetch -q --tags origin || { echo "nos update: fetch failed" >&2; exit 6; }
  if git -C "$_est" rev-parse -q --verify "refs/remotes/origin/$_ref" >/dev/null; then
    _target="refs/remotes/origin/$_ref"; _branch=1
  elif git -C "$_est" rev-parse -q --verify "refs/tags/$_ref^{commit}" >/dev/null; then
    _target="refs/tags/$_ref"; _branch=0
  else
    echo "nos update: origin has no branch or tag '$_ref'" >&2; exit 2
  fi
  _new="$(git -C "$_est" rev-parse "$_target^{commit}")"
  # The apex ruling decides what the estate says about itself; unsigned code does not ship.
  if ! git -C "$_est" show "$_new:files/anatomy/apex/ruling.yml" | python3 -c '
import hashlib, sys
t = sys.stdin.read()
have = next((l.split(":", 1)[1].strip() for l in t.splitlines() if l.startswith("signed_digest:")), None)
body = "".join(l for l in t.splitlines(keepends=True) if not l.startswith("signed_digest:"))
sys.exit(0 if have == hashlib.sha256(body.encode()).hexdigest() else 1)'; then
    echo "nos update: the apex ruling at $_ref (${_new:0:9}) is not signed — the operator signs it (tools/apex-sign.py --confirm) before it ships" >&2
    # 10-29: signing took a worktree, two apex-sign calls and a push; offered here behind one yes.
    # Only on the operator's estate (git config nos.sign-checkout = his dev checkout, same origin),
    # never on master; that checkout signs and pushes with its nos-push, the estate never pushes.
    _dev="$(git -C "$_est" config --get nos.sign-checkout 2>/dev/null || true)"
    [ "$_branch" = 1 ] && [ "$_ref" != master ] && [ -n "$_dev" ] && [ -x "$_dev/tools/nos-push" ] || exit 4
    [ "$(git -C "$_dev" remote get-url origin 2>/dev/null)" = "$(git -C "$_est" remote get-url origin)" ] || exit 4
    _sign="$(dirname "$0")/apex-sign.py"; [ -f "$_sign" ] || _sign="$NOS_SRC/tools/apex-sign.py"
    [ -f "$_sign" ] || exit 4
    git -C "$_est" --no-pager diff HEAD "$_new" -- files/anatomy/apex/ruling.yml >&2 || true
    printf 'Sign this ruling as the operator and push the signature to origin/%s from %s? [y/N] ' "$_ref" "$_dev" >&2
    _ans=""; read -r _ans || true
    case "$_ans" in y|Y|yes) ;; *) exit 4 ;; esac
    git -C "$_dev" fetch -q origin "$_ref" || { echo "nos update: fetch failed in $_dev" >&2; exit 6; }
    _tmp="$(mktemp -d)"; _wt="$_tmp/sign"
    git -C "$_dev" worktree add -q --detach "$_wt" "$_new" || exit 4
    python3 "$_sign" --repo "$_wt" --confirm >&2 || true
    _signed="$(git -C "$_wt" rev-parse HEAD)"
    _pushed=0
    [ "$_signed" != "$_new" ] && (cd "$_wt" && "$_dev/tools/nos-push" origin "HEAD:refs/heads/$_ref") >&2 && _pushed=1
    git -C "$_dev" worktree remove --force "$_wt" || true; rm -rf "$_tmp"
    [ "$_pushed" = 1 ] || { echo "nos update: the signature was not pushed; the estate stays where it is" >&2; exit 4; }
    git -C "$_est" fetch -q origin || { echo "nos update: fetch failed" >&2; exit 6; }
    _new="$_signed"
  fi
  if git -C "$_est" rev-parse -q --verify refs/heads/estate >/dev/null; then
    git -C "$_est" merge-base --is-ancestor estate "$_new" || {
      echo "nos update: ${_new:0:9} ($_ref) is not ahead of the estate's $(git -C "$_est" rev-parse --short estate); a move back or sideways is the operator's: rebuild $_est with tools/estate-adopt.sh" >&2
      exit 5; }
  fi
  git -C "$_est" checkout -q -B estate "$_new" || exit 6
  if [ "$_branch" = 1 ]; then
    git -C "$_est" branch -q --set-upstream-to="origin/$_ref" estate
  else
    git -C "$_est" branch -q --unset-upstream estate 2>/dev/null || true
  fi
  git -C "$_est" config nos.estate-ref "$_ref"
  # Point the CLI at the estate: replace NOS_SRC, keep every other line.
  _cli="$HOME/.nos/nos-cli.env"
  { [ -f "$_cli" ] && grep -v '^NOS_SRC=' "$_cli"; echo "NOS_SRC=$_est"; } > "$_cli.tmp" && mv "$_cli.tmp" "$_cli"
  # The installed CLI moves with the clone (atomic: this running copy keeps its inode). Only the
  # installed one: `tools/nos update` from a checkout leaves that checkout alone. 11-03: the CLI
  # was copied mid-converge only, so every `nos` ran the previous release's CLI.
  _self="$(command -v nos 2>/dev/null || true)"
  if [ -n "$_self" ] && [ "$0" = "$_self" ] && [ -w "$(dirname "$_self")" ] && ! cmp -s "$_est/tools/nos" "$_self"; then
    cp "$_est/tools/nos" "$_self.new" && chmod 0755 "$_self.new" && mv "$_self.new" "$_self" \
      && echo "nos update: the nos CLI at $_self is now the estate's"
  fi
  echo "nos update: the estate is at $_ref ${_new:0:9} in $_est; the next \`nos\` converges from it"
  exit 0
fi

# ── `nos push [git push args]` — the repo door (row cli-limbs-tidy) ─────────
# tools/nos-push from any shell: it pushes the checkout you stand in, then syncs
# the Gitea/GitLab mirrors and records the pre-push score; its refusals (an agent
# to dev/master, attribution trailers, another repo's remote) stay its own. Raw
# `git push` skips all of that (the Gitea dev mirror was 94 commits stale, 10-07).
if [ "${1:-}" = "push" ]; then
  shift
  exec "$NOS_SRC/tools/nos-push" "$@"
fi

# ── `nos stacks|cc|ci|smoke [args]` — the daily limbs by name (row cli-limbs-more-verbs) ─────
# Each runs its tool from $NOS_SRC with the caller's arguments, refusals and exit code intact.
# The tools/ paths stay: scripts, memories and docs name them (the one-release shim period).
case "${1:-}" in
  stacks) shift; exec "$NOS_SRC/tools/nos-stacks.sh" "$@" ;;
  cc)     shift; exec "$NOS_SRC/tools/nos-cc.sh" "$@" ;;
  ci)     shift; exec "$NOS_SRC/tools/ci-local.sh" "$@" ;;
  smoke)  shift; exec "$NOS_SRC/tools/nos-smoke.py" "$@" ;;
  ca)     shift; exec "$NOS_SRC/tools/estate-status.py" --root-ca "$@" ;;
  # The one door for removing worktrees (row worktree-prune-only-door): dry run unless --confirm.
  worktrees) shift; exec "$NOS_SRC/tools/worktree-prune.py" "$@" ;;
esac

# ── `nos dtt <verb>` — DataTables ops, not a converge ────────────────────────
# The point of this branch: an INSTALLED `nos` reaches the dtt tools from ANY
# shell, cwd, or branch (the operator's dev checkout, or another repo entirely),
# because it runs them from $NOS_SRC — not from the caller's directory. It
# operates over the PRIVATE seed repo (NOS_SEED_DIR, passed through the env) and
# the live table. This is the systemic answer to "tools/foo.py does not exist
# when I am checked out on dev": you never call the file path, you call `nos dtt`.
if [ "${1:-}" = "dtt" ]; then
  shift
  # `nos dtt --table <id|title> <verb> …` — every verb on YOUR table (or one
  # shared with you) instead of the estate roadmap; resolved as the caller
  # through the identity outpost (tools/dtt-table.py). Env: NOS_DTT_TABLE.
  if [ "${1:-}" = "--table" ]; then
    [ -n "${2:-}" ] || { echo "nos dtt --table needs a table id or title" >&2; exit 64; }
    NOS_DTT_TABLE="$2"; shift 2
  fi
  verb="${1:-}"; [ $# -gt 0 ] && shift
  case "$verb" in
    tables)       tool="dtt-table.py"; set -- list "$@" ;;
    create-table) tool="dtt-table.py"; set -- create "$@" ;;
    share)        tool="dtt-table.py"; set -- share "$@" ;;
    visibility)   tool="dtt-table.py"; set -- visibility "$@" ;;
    capture) tool="dtt-capture.py" ;;
    seed)    tool="roadmap-seed.py" ;;
    status)  tool="roadmap-status.py" ;;
    update)  tool="roadmap-update.py" ;;
    verify)  tool="roadmap-verify.py" ;;
    extract) tool="roadmap-extract.py" ;;
    board|claim|release|progress|file) tool="current-state.py"; set -- "$verb" "$@" ;;
    export|import) tool="keap-tables.py"; set -- "$verb" "$@" ;;
    ""|-h|--help)
      cat >&2 <<'DTT'
nos dtt <verb> [args] — DataTables ops (run from $NOS_SRC over NOS_SEED_DIR)
  capture   file an idea/plan/spec into the private seed repo (dtt-capture skill)
  seed      insert / --sync the roadmap table from the seed files (a parent drift is listed, not written)
  seed --sync --parents  restore the seed files' parents over skill-tree moves in the table
  seed --adopt-parents   write the table's parents (skill-tree moves) into the seed files to commit
  status    read the board
  update    move a row's CLAIM (status/target/…)
  verify    write a row's VERDICT (an exit code, never an argument)
  extract   one-time: live table -> per-row seed files
  tables    the DataTables you can see (yours, shared with you, your tier's)
  create-table "Title" [--template roadmap] [--visibility private|shared]
  share <table> --with user:<login> --access read|write|none
  visibility <table> private|shared|tier-users|…
  --table <id|title>  before any verb: run it on that table, not the roadmap
  board     the currentState claim board: assignments, claims, who is capable
  claim     claim an assignment (refused unless the match says you are capable)
  release   release a claim
  progress  move a claim's status (working|blocked|review|done)
  file      file a new assignment onto the board
  export    every DataTable (rows + history) to a bundle; dry run unless --confirm
  import    a bundle back (recreate / upsert differing cells); dry run unless --confirm
DTT
      [ "$verb" = "" ] && exit 64 || exit 0 ;;
    *) echo "nos dtt: unknown verb '$verb' (capture|seed|status|update|verify|extract|board|claim|release|progress|file|export|import)" >&2
       exit 64 ;;
  esac
  [ -f "$NOS_SRC/tools/$tool" ] || {
    echo "nos dtt: $NOS_SRC/tools/$tool not found — is NOS_SRC ($NOS_SRC) a nOS checkout, pulled?" >&2
    exit 69; }
  # The dtt tools read nested YAML (frontmatter, the table def, task-types), so
  # they need a python with PyYAML. The bare `python3` on PATH may lack it
  # (pyenv shim vs the ansible venv), so resolve one that HAS it: a recorded
  # NOS_PY (written by tasks/nos-cli.yml) first, then python3/python3.13, then
  # the interpreter ansible itself runs under — which always has PyYAML.
  DTT_PY=""
  for _c in "${NOS_PY:-}" python3 python3.13; do
    [ -n "$_c" ] && command -v "$_c" >/dev/null 2>&1 \
      && "$_c" -c 'import yaml' >/dev/null 2>&1 && { DTT_PY="$_c"; break; }
  done
  if [ -z "$DTT_PY" ] && command -v ansible >/dev/null 2>&1; then
    # ansible --version prints the interpreter as the paren group starting with
    # '/' (the version/compiler parens do not); grab that.
    _apy="$(ansible --version 2>/dev/null | grep -oE '\(/[^)]+\)' | tail -1 | tr -d '()')"
    [ -n "$_apy" ] && [ -x "$_apy" ] && "$_apy" -c 'import yaml' >/dev/null 2>&1 && DTT_PY="$_apy"
  fi
  [ -n "$DTT_PY" ] || { echo "nos dtt: found no python3 with PyYAML (the dtt tools need it). Set NOS_PY, or pip install pyyaml." >&2; exit 69; }
  if [ -n "${NOS_DTT_TABLE:-}" ]; then
    NOS_ROADMAP_TABLE_ID="$("$DTT_PY" "$NOS_SRC/tools/dtt-table.py" resolve "$NOS_DTT_TABLE")" || exit $?
    export NOS_ROADMAP_TABLE_ID
    # A table of your own has its OWN seed files: ~/nos-tables/<table-id>/
    # (git-init it if you want history), never the estate seed repo — otherwise
    # `seed` would pour the estate's rows into your project. NOS_DTT_SEED_DIR
    # overrides (a seed repo per project); NOS_SEED_DIR is left to the roadmap.
    NOS_SEED_DIR="${NOS_DTT_SEED_DIR:-$HOME/nos-tables/$NOS_ROADMAP_TABLE_ID}"
    mkdir -p "$NOS_SEED_DIR"; export NOS_SEED_DIR
  fi
  exec "$DTT_PY" "$NOS_SRC/tools/$tool" "$@"
fi

# The set-points (halt, loops pause), one rule in every reader (test_set_points_resolve_one_path.py):
# NOS_*_FILE wins; else the system-user dir, when it exists OR its parent bars us; else ~/.nos.
# A locked dir is not absent (mini 11-02: ~/.nos/halt nobody read); writers refuse (test_set_point_stray_file.py).
# ponytail: fixed though nos_system_home is configurable; upgrade = render the path into /etc/nos.
_nos_sp=/var/lib/nos/settings; _nos_sp_err=""
if [ -d "$_nos_sp" ]; then [ -r "$_nos_sp" ] && [ -x "$_nos_sp" ] || _nos_sp_err="$_nos_sp is not readable by $(id -un)"
elif [ -d "${_nos_sp%/*}" ] && ! [ -x "${_nos_sp%/*}" ]; then _nos_sp_err="${_nos_sp%/*} is not searchable by $(id -un)"
else _nos_sp="$HOME/.nos"; fi
_nos_sp_reach() {  # <var> <who> — refuse when the rule would pick a dir we cannot reach
  [ -n "${!1:-}" ] || [ -z "$_nos_sp_err" ] && return 0
  echo "$2: cannot reach the set-points ($_nos_sp_err) — refusing to fall back to ~/.nos" >&2; exit 77
}

# ── `nos loops <pause|resume|status>` — live SERE-loop pause switch ───────────
# Pause the AGENT RUNTIME at its single chokepoint (agent-run-lock.sh) so the
# operator can hold the loops before a converge — instead of hand-unloading the
# resident model — and resume after. The sentinel is a RUNTIME file (set-points
# above), so this toggles LIVE with no converge.
_loops_audit() {   # <event_type> <reason> — best-effort Bone audit event, never blocks
  local etype="$1" reason="${2:-}"
  local t; for t in jq openssl curl; do command -v "$t" >/dev/null 2>&1 || return 0; done
  local secret="${WING_EVENTS_HMAC_SECRET:-}"
  if [ -z "$secret" ] && [ -f "$HOME/.nos/secrets.yml" ]; then
    # ponytail: third copy of the read-secret+HMAC-POST shape (nos-notify.sh,
    # lib-jsonl.sh, here). Extract a shared shell emitter only if a fourth appears.
    secret="$(grep -E '^wing_events_hmac_secret:' "$HOME/.nos/secrets.yml" 2>/dev/null \
              | head -1 | sed -E 's/^[^:]+:[[:space:]]*//; s/^["'"'"']//; s/["'"'"']$//' || true)"
  fi
  [ -z "$secret" ] && return 0
  local url="${BONE_URL:-http://127.0.0.1:${BONE_PORT:-8099}}/api/v1/events"
  local ts_iso body ts sig
  ts_iso="$(date -u +%FT%TZ)"
  body="$(jq -a --sort-keys -nc --arg ts "$ts_iso" --arg type "$etype" \
    --arg actor "operator:$(id -un 2>/dev/null || echo operator)" --arg reason "$reason" \
    '{ts:$ts, type:$type, source:"nos-cli", actor_id:$actor, result:{reason:$reason}}' || true)"
  [ -z "$body" ] && return 0
  ts="$(date +%s)"
  sig="$(printf '%s.%s' "$ts" "$body" | openssl dgst -sha256 -hmac "$secret" | awk '{print $NF}')"
  curl -sS -o /dev/null -m 5 -X POST \
    -H "X-Wing-Timestamp: $ts" -H "X-Wing-Signature: $sig" \
    -H "Content-Type: application/json" -d "$body" "$url" >/dev/null 2>&1 || true
  return 0
}

if [ "${1:-}" = "models" ]; then
  shift
  _ol="${OLLAMA_HOST:-http://127.0.0.1:11434}"
  # Fetch and render are separated on purpose: sharing one error path is how a
  # broken renderer comes to report "ollama did not answer".
  if ! _ps="$(curl -sS -m 5 "$_ol/api/ps" 2>/dev/null)"; then
    echo "models: UNKNOWN — ollama at $_ol did not answer" >&2; exit 2
  fi
  _names="$(printf '%s' "$_ps" | jq -r '.models[]?.name')"
  case "${1:-status}" in
    status)
      if [ -z "$_names" ]; then echo "models: none resident"; exit 0; fi
      printf '%s' "$_ps" | jq -r '.models[]
        | "  \(.name)  \(((.size // 0) / 1000000000 * 10 | round) / 10) GB  until \(.expires_at[0:19])"'
      exit 0 ;;
    unload)
      # keep_alive 0 drops the model as the request completes. Ollama has no
      # unload-all, so ask per resident model; the list is never long.
      if [ -z "$_names" ]; then echo "models: none resident — nothing to unload."; exit 0; fi
      _rc=0
      for _m in $_names; do
        if curl -sS -m 60 -o /dev/null -X POST "$_ol/api/generate" \
             -H 'Content-Type: application/json' \
             --data "$(jq -nc --arg m "$_m" '{model:$m, keep_alive:0}')" 2>/dev/null; then
          echo "  unloaded $_m"
        else
          echo "  FAILED to unload $_m" >&2; _rc=1
        fi
      done
      exit "$_rc" ;;
    *) echo "nos models: unknown subcommand '$1' (status | unload)" >&2; exit 64 ;;
  esac
fi

if [ "${1:-}" = "loops" ]; then
  shift
  _lp="${NOS_LOOPS_PAUSED_FILE:-$_nos_sp/loops-paused}"
  sub="${1:-status}"; [ $# -gt 0 ] && shift
  case "$sub" in pause|resume|status) _nos_sp_reach NOS_LOOPS_PAUSED_FILE "nos loops $sub" ;; esac
  case "$sub" in
    pause)
      reason=""
      while [ $# -gt 0 ]; do
        case "$1" in
          --reason)   reason="${2:-}"; shift 2 ;;
          --reason=*) reason="${1#--reason=}"; shift ;;
          *) echo "nos loops pause: unknown arg '$1' (only --reason)" >&2; exit 64 ;;
        esac
      done
      mkdir -p "$(dirname "$_lp")"
      { printf 'since: %s\n' "$(date -u +%FT%TZ)"
        [ -n "$reason" ] && printf 'reason: %s\n' "$reason"; } > "$_lp"
      echo "loops PAUSED for maintenance — agent runs (Pulse agents + vuln scan) will skip."
      echo "  sentinel: $_lp"
      [ -n "$reason" ] && echo "  reason:   $reason"
      echo "  resume with: nos loops resume"
      _loops_audit "loops_paused" "$reason" || true
      exit 0 ;;
    resume)
      if [ -f "$_lp" ]; then
        rm -f "$_lp"
        echo "loops RESUMED — agent runs fire on schedule again."
        _loops_audit "loops_resumed" "" || true
      else
        echo "loops were not paused (no sentinel at $_lp)."
      fi
      exit 0 ;;
    status)
      if [ -f "$_lp" ]; then
        echo "loops: PAUSED (maintenance)"
        sed 's/^/  /' "$_lp"
      else
        echo "loops: running (not paused)"
      fi
      exit 0 ;;
    -h|--help)
      cat >&2 <<'LOOPS'
nos loops <pause|resume|status> — pause/resume the SERE agent loops (live, no converge)
  pause [--reason "..."]  write the runtime sentinel; agent runs skip as an intentional hold
  resume                  remove the sentinel; runs fire again
  status                  paused/running + reason + since (default)
LOOPS
      exit 0 ;;
    *) echo "nos loops: unknown verb '$sub' (pause|resume|status)" >&2; exit 64 ;;
  esac
fi

# ── `nos halt [--status]` / `nos resume` — emergency halt ─────────────────────
# The halt IS one file (set-points above): every scheduler holds every
# due job while it exists (row medulla-admin-halt, 2026-10-25). The medulla sets
# it first (`medulla halt|resume`: tier 1 at a listed decider, and it sends Wing
# the act). When the medulla does not set it, this shell is the break-glass: it
# writes the file itself, needing neither Wing, Traefik nor a token, then asks
# Wing over loopback :9000 (wing-halt bearer, ~/.nos/secrets.yml) to RECORD the
# act; a record that could not be made is said, and the halt stands regardless.
if [ "${1:-}" = "halt" ] || [ "${1:-}" = "resume" ]; then
  verb="$1"; shift
  [ "$verb" = "halt" ] && [ "${1:-}" = "--status" ] && { verb="state"; shift; }
  [ $# -eq 0 ] || { echo "nos $verb: takes no arguments (nos halt [--status] | nos resume)" >&2; exit 64; }
  _halt="${NOS_HALT_FILE:-$_nos_sp/halt}"
  _med="${NOS_MEDULLA:-$HOME/thalamus/bin/medulla}"
  if [ "$verb" != "state" ] && [ -x "$_med" ]; then
    rc=0; "$_med" "$verb" || rc=$?
    case "$rc" in
      0) echo "nos $verb: set by the medulla; Wing recorded the act"; exit 0 ;;
      3) echo "nos $verb: set by the medulla; the act is NOT recorded" >&2; exit 0 ;;
      *) echo "nos $verb: the medulla did not set it (exit $rc) — the shell writes the file itself" >&2 ;;
    esac
  elif [ "$verb" != "state" ]; then
    echo "nos $verb: no medulla at $_med — the shell writes the file itself" >&2
  fi
  _nos_sp_reach NOS_HALT_FILE "nos $verb"
  case "$verb" in
    halt)
      mkdir -p "$(dirname "$_halt")" || exit 1
      [ -f "$_halt" ] || printf '{"by": "%s", "at": "%s"}\n' "${USER:-operator}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$_halt" \
        || { echo "nos halt: could not write $_halt — NOT halted" >&2; exit 1; }
      echo "halt in force: $_halt (every Pulse job is held until nos resume)" ;;
    resume)
      rm -f "$_halt" || { echo "nos resume: could not remove $_halt — still halted" >&2; exit 1; }
      echo "halt lifted: $_halt removed" ;;
    state)
      if [ -f "$_halt" ]; then echo "halt in force since $(cat "$_halt")"; else echo "no halt ($_halt absent)"; fi ;;
  esac
  tok="${WING_HALT_TOKEN:-}"
  if [ -z "$tok" ] && [ -f "$HOME/.nos/secrets.yml" ]; then
    tok="$(grep -E '^wing_halt_token:' "$HOME/.nos/secrets.yml" 2>/dev/null \
           | head -1 | sed -E 's/^[^:]+:[[:space:]]*//; s/^["'"'"']//; s/["'"'"']$//' || true)"
  fi
  case "$tok" in ""|placeholder*)
    [ "$verb" = "state" ] || echo "nos $verb: the act is NOT recorded — no wing_halt_token (a converge with --tags wing mints it)" >&2
    exit 0 ;;
  esac
  command -v curl >/dev/null 2>&1 || { echo "nos $verb: curl not found — the act is NOT recorded" >&2; exit 0; }
  method=POST; [ "$verb" = "state" ] && method=GET
  url="${NOS_WING_URL:-http://127.0.0.1:${WING_PORT:-9000}}/api/v1/admin/$verb"
  # Who did it, as Wing's operator_username (else it records the bearer, wing-halt). A name only.
  body=(); case "${USER:-}" in ""|*[!A-Za-z0-9._-]*) ;; *) [ "$method" = POST ] && body=(-H 'Content-Type: application/json' -d "{\"by\":\"$USER\"}") ;; esac
  if ! out="$(curl -sS -m 10 -X "$method" -H "Authorization: Bearer $tok" ${body[@]+"${body[@]}"} -w '\n%{http_code}' "$url" 2>&1)"; then
    [ "$verb" = "state" ] || echo "nos $verb: Wing did not answer at $url — the act is NOT recorded" >&2
    exit 0
  fi
  code="${out##*$'\n'}"; body="${out%$'\n'*}"
  case "$code" in
    2*) printf '%s\n' "$body" ;;
    *) echo "nos $verb: Wing refused to record it (HTTP $code) — the act is NOT recorded" >&2; exit 1 ;;
  esac
  exit 0
fi

usage() {
  sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//'
}

REMOVE=""
CONFIRM=0
YES=0
LEAVE=0
PRINT_CMD=0
PASSTHRU=()

while [ $# -gt 0 ]; do
  case "$1" in
    --remove=*)
      REMOVE="${1#--remove=}"
      case "$REMOVE" in
        none|data|deep|all) ;;
        *) echo "nos: unknown --remove level '$REMOVE' (none|data|deep|all, case-sensitive)" >&2; exit 64 ;;
      esac
      shift ;;
    --remove)   echo "nos: use --remove=LEVEL" >&2; exit 64 ;;
    --confirm)  CONFIRM=1; shift ;;
    -y|--yes)   YES=1; shift ;;
    --leave)    LEAVE=1; shift ;;
    --print-cmd) PRINT_CMD=1; shift ;;
    -h|--help)  usage; exit 0 ;;
    --version)  echo "nos cli v${NOS_CLI_VERSION}"; exit 0 ;;
    --)         shift; PASSTHRU+=("$@"); break ;;
    *)          PASSTHRU+=("$@"); break ;;
  esac
done

# `-e install_x=true` hands ansible the STRING "true", which ansible-core 2.19+ refuses in
# every `when:` (the Linux mini, 11-01). A toggle's true/false is sent as JSON, a real bool.
_args=() _next_e=0
for a in ${PASSTHRU[@]+"${PASSTHRU[@]}"}; do
  if [ "$_next_e" -eq 1 ]; then
    _next_e=0
    case "$a" in
      install_*=[Tt]rue|configure_*=[Tt]rue)   a="{\"${a%%=*}\": true}" ;;
      install_*=[Ff]alse|configure_*=[Ff]alse) a="{\"${a%%=*}\": false}" ;;
    esac
  fi
  case "$a" in -e|--extra-vars) _next_e=1 ;; esac
  _args+=("$a")
done
PASSTHRU=(${_args[@]+"${_args[@]}"})

# ── refusals ────────────────────────────────────────────────────────────────
if [ "$CONFIRM" -eq 1 ] && [ "$YES" -eq 1 ]; then
  echo "nos: --confirm together with -y is ambiguous (interactive vs non-interactive) — pick one" >&2
  exit 64
fi
if [ "$LEAVE" -eq 1 ] && { [ -z "$REMOVE" ] || [ "$REMOVE" = "none" ]; }; then
  echo "nos: --leave without --remove would do nothing — refusing" >&2
  exit 64
fi
# Ordering guard (O2): the parser stops at the first unrecognised token, so
# `nos --tags iiab --remove=data` would leave --remove INSIDE the passthrough
# — unparsed, no exit-65. Scan the passthrough and refuse rather than let
# ansible die on an unknown flag.
# Every nos flag, not only --remove: `nos -e x --print-cmd` ran a real converge (11-02).
for a in ${PASSTHRU[@]+"${PASSTHRU[@]}"}; do
  case "$a" in
    --remove=*|--remove|--confirm|--yes|--leave|--print-cmd)
      echo "nos: '$a' found after the first passthrough token — put" >&2
      echo "  $a (and every nos flag) BEFORE ansible passthrough args." >&2
      exit 64 ;;
  esac
done
if [ -n "$REMOVE" ] && [ "$REMOVE" != "none" ]; then
  for a in ${PASSTHRU[@]+"${PASSTHRU[@]}"}; do
    case "$a" in
      --tags|--tags=*|-t|--skip-tags|--skip-tags=*)
        echo "nos: refusing --remove=$REMOVE with --tags/--skip-tags — tag" >&2
        echo "  filtering silently drops the removal tasks (they carry" >&2
        echo "  filterable tags). Run the removal without tag restriction." >&2
        exit 65 ;;
    esac
  done
fi

# ── argv: operator passthrough FIRST, CLI emissions LAST (last -e wins) ─────
ARGS=(ansible-playbook main.yml)
ARGS+=(${PASSTHRU[@]+"${PASSTHRU[@]}"})
if [ -n "$REMOVE" ] && [ "$REMOVE" != "none" ]; then
  ARGS+=(-e "remove=${REMOVE}")          # NEVER -e remove=none (would outrank
fi                                       # the shim and neuter -e blank=true)
[ "$CONFIRM" -eq 1 ] && ARGS+=(-e confirm=true)
if [ "$YES" -eq 1 ]; then
  ARGS+=(-e confirm=true -e assume_yes=true)
  # Empty sudo password (vars_prompt neutraliser) ONLY when the operator did
  # not pass their own — last -e wins, and clobbering an explicit
  # -e nos_sudo_password=REAL with '' would make every -y removal die
  # mid-wipe on become (trace M1).
  _has_sudo_pw=0
  for a in ${PASSTHRU[@]+"${PASSTHRU[@]}"}; do
    case "$a" in *nos_sudo_password=*) _has_sudo_pw=1 ;; esac
  done
  if [ "$_has_sudo_pw" -eq 0 ]; then
    ARGS+=(-e nos_sudo_password='')
  fi
fi
[ "$LEAVE" -eq 1 ] && ARGS+=(-e leave=true)
ARGS+=(-e "nos_cli_version=${NOS_CLI_VERSION}")

# Every -e value in argv order, attached forms (-e@x, --extra-vars=x) included.
_evals=() _prev=""
for a in ${PASSTHRU[@]+"${PASSTHRU[@]}"}; do
  case "$_prev" in -e|--extra-vars) _evals+=("$a") ;; esac
  case "$a" in -e?*) _evals+=("${a#-e}") ;; --extra-vars=*) _evals+=("${a#--extra-vars=}") ;; esac
  _prev="$a"
done

# config.yml install_kiwix: true lost silently to profiles/core.yml's false (profile-outranks-config).
# Name each install_/configure_ key config.yml loses and the LAST -e setting it: 11-05 a later -e
# won while nos said 'profile wins'. Gate: test_profile_conflict_is_named.py.
_toggles() {  # <label> <yaml file> -> "label<TAB>key<TAB>value"
  awk -v src="$1" '{ sub(/[ \t]+#.*/, ""); sub(/[ \t]+$/, "") }
    /^(install|configure)_[A-Za-z0-9_]+:/ { k = $0; sub(/:.*/, "", k); v = $0; sub(/^[^:]*:[ \t]*/, "", v); print src "\t" k "\t" v }' "$2"
}
if [ -f "$NOS_SRC/config.yml" ]; then
  {
    _toggles config.yml "$NOS_SRC/config.yml"
    for v in ${_evals[@]+"${_evals[@]}"}; do
      case "$v" in
        @*) _pf="${v#@}"; case "$_pf" in /*) ;; *) _pf="$NOS_SRC/$_pf" ;; esac
            [ -f "$_pf" ] && _toggles "${v#@}" "$_pf" ;;
        *) printf '%s\n' "$v" | grep -oE '"?(install|configure)_[A-Za-z0-9_]+"?[ ]*[:=][ ]*[^ ,}]+' \
             | sed -E 's/^"?([^" :=]+)"?[ ]*[:=][ ]*/-e	\1	/' ;;
      esac
    done
  } | awk -F '\t' '{ v = tolower($3); gsub(/["\047]/, "", v) }
      $1 == "config.yml" { cfg[$2] = v; raw[$2] = $3 }
      { win[$2] = $1; val[$2] = v; wraw[$2] = $3 }
      END { for (k in cfg) if (win[k] != "config.yml" && val[k] != cfg[k])
        printf "nos: %s: config.yml says %s, %s says %s — %s wins\n", k, raw[k], win[k], wraw[k], win[k] }' \
    | sort >&2 || true  # a grep with no match must not end nos under pipefail
fi

if [ "$PRINT_CMD" -eq 1 ]; then
  printf '%s\n' "${ARGS[*]}"
  exit 0
fi

# Rotate the previous run's log BEFORE ansible opens it. ansible.cfg
# log_path appends for the whole play; truncating mid-run would eat the
# recap this run is writing. p=54800 left ~/.nos/ansible.log ~250 MB.
# One rotated copy. Ansible recreates the live file; the playbook pins 0600.
# After --print-cmd's exit above, so a dry print never touches the log.
# NOS_ANSIBLE_LOG_MAX is bytes (tests); default 50 MiB.
_NOS_LOG="${HOME}/.nos/ansible.log"
# ansible.cfg logs here, and Ansible will not create the directory: on a fresh
# host, and after a leave took ~/.nos, it logged nothing ("not writeable and we
# cannot create it", 2026-09-30). A converge is what owns the side-car.
mkdir -p "${HOME}/.nos" && chmod 700 "${HOME}/.nos"
_NOS_LOG_MAX="${NOS_ANSIBLE_LOG_MAX:-52428800}"
if [ -f "$_NOS_LOG" ]; then
  _nos_log_sz=$(stat -f%z "$_NOS_LOG" 2>/dev/null || stat -c%s "$_NOS_LOG" 2>/dev/null || echo 0)
  if [ "${_nos_log_sz:-0}" -gt "$_NOS_LOG_MAX" ]; then
    mv "$_NOS_LOG" "${_NOS_LOG}.1"
    chmod 600 "${_NOS_LOG}.1" 2>/dev/null || true
  fi
fi

# A --tags name no task carries runs nothing and still ends green: 11-02 `--tags device_gateway`
# (the tag is device-gateway) deployed nothing at failed=0. Every requested tag is checked against
# `--list-tags`, cached per clean HEAD; an unreadable list warns and proceeds. introspect/persist
# hide behind a dynamic include (state-report.yml), so are allowed by name. Gate: test_unknown_tag_is_refused.py.
_req_tags="" _prev=""
for a in ${PASSTHRU[@]+"${PASSTHRU[@]}"}; do
  case "$_prev" in --tags|-t|--skip-tags) _req_tags="$_req_tags,$a" ;; esac
  case "$a" in --tags=*|--skip-tags=*) _req_tags="$_req_tags,${a#*=}" ;; esac
  _prev="$a"
done
if [ -n "$_req_tags" ]; then
  _tag_cache="${HOME}/.nos/list-tags.cache"
  _tag_key="$(git -C "$NOS_SRC" rev-parse HEAD 2>/dev/null || true)"
  [ -n "$(git -C "$NOS_SRC" status --porcelain 2>/dev/null)" ] && _tag_key=""
  _known=""
  if [ -n "$_tag_key" ] && [ "$(head -1 "$_tag_cache" 2>/dev/null)" = "$_tag_key" ]; then
    _known="$(tail -n +2 "$_tag_cache")"
  else
    echo "nos: reading the playbook's declared tags (--list-tags) ..." >&2
    _known="$(cd "$NOS_SRC" && ANSIBLE_LOG_PATH=/dev/null ansible-playbook main.yml --list-tags </dev/null 2>/dev/null \
      | grep -o 'TAGS: \[[^]]*\]' | sed 's/^TAGS: \[//; s/\]$//' | tr ',' '\n' | tr -d ' ' | grep . | sort -u || true)"
    if [ -n "$_known" ] && [ -n "$_tag_key" ]; then
      printf '%s\n%s\n' "$_tag_key" "$_known" > "$_tag_cache" 2>/dev/null || true
    fi
  fi
  if [ -z "$_known" ]; then
    echo "nos: WARNING — could not read the playbook's tags; '${_req_tags#,}' is NOT checked" >&2
  else
    _bad=0
    for t in $(printf '%s' "$_req_tags" | tr ',' ' '); do
      case "$t" in all|always|never|tagged|untagged|introspect|persist) continue ;; esac
      printf '%s\n' "$_known" | grep -qxF -- "$t" && continue
      _norm="$(printf '%s' "$t" | tr 'A-Z_' 'a-z-')"
      _near="$(printf '%s\n' "$_known" | while read -r k; do
        [ "$(printf '%s' "$k" | tr 'A-Z_' 'a-z-')" = "$_norm" ] && echo "$k"; done | head -1 || true)"
      echo "nos: no task carries the tag '$t'${_near:+ — did you mean $_near?}" >&2
      _bad=1
    done
    [ "$_bad" -eq 1 ] && { echo "  (declared tags: ansible-playbook main.yml --list-tags)" >&2; exit 64; }
  fi
fi

# Ansible prints nothing until it has read the playbook and every config layer (5 s on the
# Studio, ~20 s on the Linux mini, 11-02): say at once what is about to run.
_say_tags="" _say_prof=""
_prev=""
for a in ${PASSTHRU[@]+"${PASSTHRU[@]}"}; do
  case "$_prev" in --tags|-t) _say_tags="$a" ;; esac
  case "$a" in --tags=*) _say_tags="${a#--tags=}" ;; esac
  _prev="$a"
done
for v in ${_evals[@]+"${_evals[@]}"}; do
  case "$v" in @profiles/*) _say_prof="${_say_prof:+$_say_prof }${v#@profiles/}" ;; esac
done
_kept_prof="$(sed -nE 's/^nos_profile:[[:space:]]*["'\'']?([a-z0-9-]+).*/\1/p' "$NOS_SRC/config.yml" 2>/dev/null | tail -1 || true)"
if [ -n "$_kept_prof" ]; then _say_prof="${_say_prof:+$_say_prof over }$_kept_prof (config.yml)"; fi
echo "nos: converge $(git -C "$NOS_SRC" rev-parse --short HEAD 2>/dev/null || echo '?') from $NOS_SRC — tags: ${_say_tags:-all} · profile: ${_say_prof:-none} · removal: ${REMOVE:-none}" >&2
echo "nos: Ansible reads the playbook and every config layer first (quiet for a while), then asks for sudo once." >&2

cd "$NOS_SRC"
# The playbook writes ~/.ansible_askpass (the sudo password, in plaintext) and
# removes it in post_tasks, which a failed run and a --leave end_play never
# reach: on 2026-09-30 it outlived both. The CLI outlives the playbook, so it
# removes the file whatever the outcome (not exec: nothing would run after).
trap 'rm -f "${HOME}/.ansible_askpass"' EXIT
# Piped (`nos | tee log`), Python block-buffers: a pause prompt with no newline
# showed only after Enter (2026-10-17). Gate: test_a_piped_run_shows_a_prompt_before_any_input.
[ -t 1 ] || export PYTHONUNBUFFERED=1
if [ "$YES" -eq 1 ]; then
  "${ARGS[@]}" </dev/null
else
  "${ARGS[@]}"
fi
exit $?
