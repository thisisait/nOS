#!/usr/bin/env bash
# nOS git pre-push hook — branch protection guard.
#
# Active when this checkout runs:
#     git config core.hooksPath tools/git-hooks
#
# Two rules:
#   1. `pzny` branch is local-cross-feature; it may push ONLY to a
#      remote named `gitea` (the operator's local Gitea mirror, which
#      drives the Woodpecker auto-deploy pipeline). Pushing pzny to
#      `origin` (GitHub) is refused.
#   2. Direct push to `master` is refused regardless of remote — master
#      moves only via PR merge on the remote side (branch protection on
#      GitHub + Gitea enforces it server-side; this hook is the local
#      belt to that server-side suspenders).
#
# Bypass for emergencies: `git push --no-verify` skips this hook (don't
# use it casually — it bypasses every local pre-push check).

set -euo pipefail

remote="$1"
url="$2"

# Read each "<local_ref> <local_sha> <remote_ref> <remote_sha>" line from stdin.
while read -r local_ref local_sha remote_ref remote_sha; do
	# Skip deletions (local_sha = all zeros).
	if [[ "$local_sha" =~ ^0+$ ]]; then
		continue
	fi

	# A release tag needs a green trunk. Cut on red at v0.10 AND v0.11
	# (fee 39): the checklist said "check CI", nothing enforced it. Fail
	# CLOSED — no gh, no runs, or a red BLOCKING job refuses. A job the tagged
	# commit's workflow marks continue-on-error is reported as info (v0.17 cut).
	# Loud bypass: NOS_TAG_RED_OK=1 git push origin v<x>. (--no-verify works
	# too, but skips every check, not just this one.)
	case "$remote_ref" in
		refs/tags/v*)
			tag="${remote_ref#refs/tags/}"
			if [[ "${NOS_TAG_RED_OK:-}" == "1" ]]; then
				echo "⚠ $tag pushed with NOS_TAG_RED_OK=1 — the CI gate was bypassed" >&2
				continue
			fi
			# Annotated tags push the TAG OBJECT sha; gh knows only commits.
			commit=$(git rev-parse "${local_sha}^{commit}" 2>/dev/null || echo "")
			_py=$(command -v python3 2>/dev/null || command -v python || true)
			if [[ -z "$_py" ]]; then
				verdict="UNKNOWN: no python to parse gh JSON"
			else
			verdict=$("$_py" -c '
import json, re, subprocess, sys
gh, commit = sys.argv[1], sys.argv[2]
def ask(*args):
    try:
        out = subprocess.run([gh, *args], capture_output=True, text=True, timeout=60)
        return json.loads(out.stdout) if out.returncode == 0 else None
    except Exception:
        return None
def sh(*args):
    return subprocess.run(args, capture_output=True, text=True).stdout
runs = ask("run", "list", "--commit", commit, "--limit", "20",
           "--json", "databaseId,name,status,conclusion")
if not runs:
    print("UNKNOWN: no CI run exists for this commit — a tag needs evidence, not absence")
    sys.exit(0)
# Non-blocking = jobs the TAGGED commit declares continue-on-error: true,
# read from its own workflows. No pyyaml -> empty set: every job blocks.
soft = []
try:
    import yaml
    for f in sh("git", "ls-tree", "--name-only", commit, ".github/workflows/").split():
        jobs = (yaml.safe_load(sh("git", "show", commit + ":" + f)) or {}).get("jobs") or {}
        for key, job in jobs.items():
            if isinstance(job, dict) and job.get("continue-on-error") is True:
                parts = re.split(r"\$\{\{.*?\}\}", str(job.get("name") or key))
                soft.append(re.compile("^" + ".*".join(map(re.escape, parts)) + "$"))
except ImportError:
    print("info: no pyyaml — every CI job is judged blocking", file=sys.stderr)
red, info, green = set(), set(), False
for r in runs:
    if r.get("conclusion") == "success" and r.get("status") == "completed":
        green = True
    if r.get("conclusion") != "failure":
        continue
    view = ask("run", "view", str(r.get("databaseId")), "--json", "jobs")
    jobs = view.get("jobs") if isinstance(view, dict) else None
    if not jobs:
        red.add(r.get("name", "?") + " (its jobs are unreadable)")
        continue
    bad = [j["name"] for j in jobs if j.get("conclusion") in ("failure", "timed_out", "cancelled")]
    hard = [n for n in bad if not any(p.match(n) for p in soft)]
    red.update(r.get("name", "?") + ": " + n for n in hard)
    info.update(set(bad) - set(hard))
    green = green or (bool(bad) and not hard)
for n in sorted(info):
    print("info: non-blocking job red (continue-on-error): " + n, file=sys.stderr)
if red:
    print("RED: " + ", ".join(sorted(red)))
elif not green:
    print("UNKNOWN: no completed successful run — pending is not green")
else:
    print("GREEN")
' "${NOS_TAG_GATE_GH:-gh}" "$commit") || verdict="UNKNOWN: the gh probe itself failed"
			fi
			if [[ "$verdict" != "GREEN" ]]; then
				cat >&2 <<-EOF
					✖ pre-push refused: $tag on commit $commit is not provably green.

					    $verdict

					A release tag was cut on a red trunk at v0.10-beta AND v0.11-beta
					(docs/hidden_fees/39). Fix CI, or bypass loudly:
					    NOS_TAG_RED_OK=1 git push origin $tag
				EOF
				exit 1
			fi
			continue
			;;
	esac

	# Extract the branch name from refs/heads/<name>.
	branch="${local_ref#refs/heads/}"

	case "$branch" in
		master)
			cat >&2 <<-EOF
				✖ pre-push refused: direct push to master is locked.

				master moves via PR from dev (FF only). See CLAUDE.md §Git Workflow.

				If you really need to bypass (urgent hotfix): git push --no-verify
				— but you'll still hit the server-side branch protection.
			EOF
			exit 1
			;;
		pzny)
			if [[ "$remote" != "gitea" ]]; then
				cat >&2 <<-EOF
					✖ pre-push refused: pzny may push only to the 'gitea' remote.

					pzny is the operator's local cross-feature workspace — it stays off
					the public GitHub mirror. Configure your local Gitea as remote
					'gitea' before pushing pzny:

					    git remote add gitea https://gitea.<tld>/thisisait/nOS.git
					    git push gitea pzny

					Current push target: $remote ($url)
				EOF
				exit 1
			fi
			;;
	esac
done

exit 0
