---
extends: default

rules:
  line-length:
    max: 180
    level: warning
  # Ansible Jinja2 templates use {{ var }} which yamllint flags as
  # "too many spaces inside braces". Disable — incompatible with Jinja2.
  braces:
    min-spaces-inside: 0
    max-spaces-inside-empty: 0
    max-spaces-inside: -1
  brackets:
    min-spaces-inside: 0
    max-spaces-inside-empty: 0
    max-spaces-inside: -1
  # Plugin manifests (and many role defaults) align values for readability
  # (`key:        value`). The default colons rule (max-spaces-after: 1) flags
  # that as an ERROR — 236 of them across files/anatomy/plugins/*/plugin.yml.
  # The alignment is deliberate, so allow it (mirrors line-length being a
  # warning, not a hard fail).
  colons:
    max-spaces-after: -1
  # Same deliberate alignment, comma edition: the KEAP DataTable seeds
  # (state/keap-tables/*.table.yml) are column-aligned inline maps
  # (`{ key: name,        label: "Name", ... }`). Keep the files fully
  # linted otherwise — only the spacing-after-comma freedom is granted.
  commas:
    max-spaces-after: -1

ignore: |
  .github/workflows/stale.yml
  # Vendored JS deps (Playwright etc.) — not our YAML to lint.
  tests/e2e/node_modules
  .venv
  roles
  files/observability
  files/project-wing
  # Jinja2 templates can't be parsed as YAML — `{% if %}` blocks break
  # tokenization. Anatomy plugin templates live outside `roles/` so they
  # need their own exclusion line. Files inside `roles/` are already
  # covered by the `roles` entry above.
  files/anatomy/plugins/*/templates/*.j2
  # Auto-generated contract artifacts (Anatomy A5). They use PyYAML's
  # safe_dump indentation, which differs from yamllint's default
  # `indent-sequences: true (with extra space)` expectation. The
  # contracts-drift CI job already validates byte-stability — running
  # yamllint on top would add only noise.
  files/anatomy/skills/contracts
  # Auto-generated by pazny.apps_runner — uses indent-sequences: false
  # which clashes with yamllint's default indent-sequences: true.
  state/smoke-catalog.runtime.yml
  # Auto-generated by tools/tofu-authentik-gen-registry.py (PyYAML safe_dump,
  # same indent-sequences clash; ADR-0001 Phase 1). Values stay raw Jinja so
  # parsing-as-YAML is fine — it's the sequence indent yamllint dislikes.
  state/tofu-authentik-services.yml
