*.vagrant
.DS_Store
.ansible
*.retry
roles/*
!roles/pazny.*
# Operator's root-level config.yml / credentials.yml only — `/` anchor prevents
# this from swallowing committed files like files/observability/blackbox/config.yml
# (2026-05-11: ate the blackbox baseline config until anchored).
/config.yml
/config.*.yml
/credentials.yml
/credentials.*.yml
/.credentials.yml
.venv
# Frozen pre-release-gate venv built by tools/ci-local.sh (ansible-core 2.21
# mirror of the CI integration job). Regenerated on demand; never committed.
.ci-venv/
.remember/*
vision.md
_credentials.yml
.ansible-prefix-state
.nos/
# .claude is session-local EXCEPT skills/ and plugins/ (committed — the /devlog
# skill is part of the devlog platform contract, test_devlog_skill_contract.py;
# the nos-loop plugin must be in the repo for the same reason its gate sets are:
# a client that lives in per-host runtime state drifts per host, and Hermes/CI
# would never see it. test_loop_plugin_is_thin.py pins that it stays tracked.
.claude/*
!.claude/skills/
!.claude/plugins/
__pycache__/
*.pyc
tools/social-poster/index.html
docs/funding

# Playwright MCP transient artifacts (snapshot YAMLs + console logs)
.playwright-mcp/

# Local-only operator scripts (not committed by request)
tools/wipe-nginx-relics.sh
# Operator's personal Czech e-reader / Calibre sync helper — local-only.
tools/calibre-sync.py

# Runtime smoke catalog — auto-generated by pazny.apps_runner from
# apps/<name>.yml manifests. Source of truth is the manifests, not this file.
state/smoke-catalog.runtime.yml

# Python build artifacts from `pip install <path>` of files/anatomy/pulse/
# (pazny.pulse role) — regenerated on every install, not committed.
files/anatomy/pulse/build/
files/anatomy/pulse/*.egg-info/
.debug-report-*.md
files/anatomy/wing/tests/e2e/.services.json
files/anatomy/wing/tests/e2e/.sweep-results.json
docs/llm/security/scan.log

# OpenTofu (ADR-0001 Phase 0) — state + tfvars are secret-bearing + machine-local
terraform/**/.terraform/
terraform/**/.terraform.tfstate*
terraform/**/terraform.tfstate
terraform/**/terraform.tfstate.*
terraform/**/*.auto.tfvars.json
terraform/**/tfplan
terraform/authentik/generated.tf
terraform/authentik/imports.generated.tf
